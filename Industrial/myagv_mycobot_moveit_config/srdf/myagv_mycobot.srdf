<?xml version="1.0" encoding="utf-8"?>
<robot name="myagv_mycobot">

  <!-- No virtual joint so planning stays relative to base_footprint while the base drives -->

  <group name="mycobot_arm">
    <chain base_link="g_base" tip_link="gripper_tcp"/>
  </group>

  <group name="adaptive_gripper">
    <joint name="gripper_base_to_gripper_left3"/>
    <joint name="gripper_base_to_gripper_left2"/>
    <joint name="gripper_left3_to_gripper_left1"/>
    <joint name="gripper_base_to_gripper_right3"/>
    <joint name="gripper_base_to_gripper_right2"/>
    <joint name="gripper_right3_to_gripper_right1"/>
  </group>

  <end_effector name="gripper" parent_link="gripper_tcp" group="adaptive_gripper" parent_group="mycobot_arm"/>

  <!-- Folded above the base, safe for driving -->
  <group_state name="home" group="mycobot_arm">
    <joint name="joint2_to_joint1" value="0"/>
    <joint name="joint3_to_joint2" value="1.0"/>
    <joint name="joint4_to_joint3" value="-2.3"/>
    <joint name="joint5_to_joint4" value="-0.2"/>
    <joint name="joint6_to_joint5" value="0"/>
    <joint name="joint6output_to_joint6" value="0"/>
  </group_state>

  <!-- Gripper ahead of the base and pitched 60 degrees down, clear of a 0.2 m high belt -->
  <group_state name="ready" group="mycobot_arm">
    <joint name="joint2_to_joint1" value="0.633"/>
    <joint name="joint3_to_joint2" value="0.532"/>
    <joint name="joint4_to_joint3" value="-1.456"/>
    <joint name="joint5_to_joint4" value="-0.204"/>
    <joint name="joint6_to_joint5" value="-0.305"/>
    <joint name="joint6output_to_joint6" value="0.564"/>
  </group_state>

  <group_state name="zero" group="mycobot_arm">
    <joint name="joint2_to_joint1" value="0"/>
    <joint name="joint3_to_joint2" value="0"/>
    <joint name="joint4_to_joint3" value="0"/>
    <joint name="joint5_to_joint4" value="0"/>
    <joint name="joint6_to_joint5" value="0"/>
    <joint name="joint6output_to_joint6" value="0"/>
  </group_state>

  <group_state name="GripperOpen" group="adaptive_gripper">
    <joint name="gripper_base_to_gripper_left3" value="0.15"/>
  </group_state>

  <group_state name="GripperClose" group="adaptive_gripper">
    <joint name="gripper_base_to_gripper_left3" value="-0.74"/>
  </group_state>

  <!-- Adjacent, Default and Never pairs from 20000 random samples of the arm and gripper -->
  <disable_collisions link1="base_link" link2="joint1" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="joint2" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="joint3" reason="Never"/>
  <disable_collisions link1="base_link" link2="wheel_back_left_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="wheel_back_right_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="wheel_front_left_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="wheel_front_right_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="gripper_left1" reason="Default"/>
  <disable_collisions link1="gripper_base" link2="gripper_left2" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="gripper_left3" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="gripper_right1" reason="Default"/>
  <disable_collisions link1="gripper_base" link2="gripper_right2" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="gripper_right3" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="joint5" reason="Never"/>
  <disable_collisions link1="gripper_base" link2="joint6" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="joint6_flange" reason="Adjacent"/>
  <disable_collisions link1="gripper_left1" link2="gripper_left2" reason="Default"/>
  <disable_collisions link1="gripper_left1" link2="gripper_left3" reason="Adjacent"/>
  <disable_collisions link1="gripper_left1" link2="gripper_right1" reason="Never"/>
  <disable_collisions link1="gripper_left1" link2="gripper_right2" reason="Never"/>
  <disable_collisions link1="gripper_left1" link2="gripper_right3" reason="Never"/>
  <disable_collisions link1="gripper_left1" link2="joint5" reason="Never"/>
  <disable_collisions link1="gripper_left1" link2="joint6" reason="Never"/>
  <disable_collisions link1="gripper_left1" link2="joint6_flange" reason="Never"/>
  <disable_collisions link1="gripper_left2" link2="gripper_left3" reason="Default"/>
  <disable_collisions link1="gripper_left2" link2="gripper_right1" reason="Never"/>
  <disable_collisions link1="gripper_left2" link2="gripper_right2" reason="Never"/>
  <disable_collisions link1="gripper_left2" link2="gripper_right3" reason="Default"/>
  <disable_collisions link1="gripper_left2" link2="joint5" reason="Never"/>
  <disable_collisions link1="gripper_left2" link2="joint6" reason="Never"/>
  <disable_collisions link1="gripper_left2" link2="joint6_flange" reason="Adjacent"/>
  <disable_collisions link1="gripper_left3" link2="gripper_right1" reason="Never"/>
  <disable_collisions link1="gripper_left3" link2="gripper_right2" reason="Default"/>
  <disable_collisions link1="gripper_left3" link2="gripper_right3" reason="Default"/>
  <disable_collisions link1="gripper_left3" link2="joint5" reason="Never"/>
  <disable_collisions link1="gripper_left3" link2="joint6" reason="Never"/>
  <disable_collisions link1="gripper_left3" link2="joint6_flange" reason="Adjacent"/>
  <disable_collisions link1="gripper_right1" link2="gripper_right2" reason="Default"/>
  <disable_collisions link1="gripper_right1" link2="gripper_right3" reason="Adjacent"/>
  <disable_collisions link1="gripper_right1" link2="joint5" reason="Never"/>
  <disable_collisions link1="gripper_right1" link2="joint6" reason="Never"/>
  <disable_collisions link1="gripper_right1" link2="joint6_flange" reason="Never"/>
  <disable_collisions link1="gripper_right2" link2="gripper_right3" reason="Default"/>
  <disable_collisions link1="gripper_right2" link2="joint5" reason="Never"/>
  <disable_collisions link1="gripper_right2" link2="joint6" reason="Never"/>
  <disable_collisions link1="gripper_right2" link2="joint6_flange" reason="Adjacent"/>
  <disable_collisions link1="gripper_right3" link2="joint5" reason="Never"/>
  <disable_collisions link1="gripper_right3" link2="joint6" reason="Never"/>
  <disable_collisions link1="gripper_right3" link2="joint6_flange" reason="Adjacent"/>
  <disable_collisions link1="joint1" link2="joint2" reason="Adjacent"/>
  <disable_collisions link1="joint1" link2="wheel_back_left_link" reason="Adjacent"/>
  <disable_collisions link1="joint1" link2="wheel_back_right_link" reason="Adjacent"/>
  <disable_collisions link1="joint1" link2="wheel_front_left_link" reason="Adjacent"/>
  <disable_collisions link1="joint1" link2="wheel_front_right_link" reason="Adjacent"/>
  <disable_collisions link1="joint2" link2="joint3" reason="Adjacent"/>
  <disable_collisions link1="joint2" link2="wheel_back_left_link" reason="Never"/>
  <disable_collisions link1="joint2" link2="wheel_back_right_link" reason="Never"/>
  <disable_collisions link1="joint2" link2="wheel_front_left_link" reason="Never"/>
  <disable_collisions link1="joint2" link2="wheel_front_right_link" reason="Never"/>
  <disable_collisions link1="joint3" link2="joint4" reason="Adjacent"/>
  <disable_collisions link1="joint3" link2="wheel_back_left_link" reason="Never"/>
  <disable_collisions link1="joint3" link2="wheel_back_right_link" reason="Never"/>
  <disable_collisions link1="joint3" link2="wheel_front_left_link" reason="Never"/>
  <disable_collisions link1="joint3" link2="wheel_front_right_link" reason="Never"/>
  <disable_collisions link1="joint4" link2="joint5" reason="Adjacent"/>
  <disable_collisions link1="joint4" link2="wheel_back_left_link" reason="Never"/>
  <disable_collisions link1="joint4" link2="wheel_back_right_link" reason="Never"/>
  <disable_collisions link1="joint4" link2="wheel_front_left_link" reason="Never"/>
  <disable_collisions link1="joint4" link2="wheel_front_right_link" reason="Never"/>
  <disable_collisions link1="joint5" link2="joint6" reason="Adjacent"/>
  <disable_collisions link1="joint5" link2="joint6_flange" reason="Never"/>
  <disable_collisions link1="joint6" link2="joint6_flange" reason="Adjacent"/>
  <disable_collisions link1="wheel_back_left_link" link2="wheel_back_right_link" reason="Never"/>
  <disable_collisions link1="wheel_back_left_link" link2="wheel_front_left_link" reason="Never"/>
  <disable_collisions link1="wheel_back_left_link" link2="wheel_front_right_link" reason="Never"/>
  <disable_collisions link1="wheel_back_right_link" link2="wheel_front_left_link" reason="Never"/>
  <disable_collisions link1="wheel_back_right_link" link2="wheel_front_right_link" reason="Never"/>
  <disable_collisions link1="wheel_front_left_link" link2="wheel_front_right_link" reason="Never"/>

</robot>
