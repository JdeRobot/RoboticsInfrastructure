<?xml version="1.0"?>
<robot name="ur5" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================= -->
  <!-- ARGUMENTS -->
  <!-- ========================= -->

  <xacro:arg name="name" default="ur"/>
  <xacro:arg name="ur_type" default="ur5"/>
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="use_fake_hardware" default="false"/>
  <xacro:arg name="fake_sensor_commands" default="false"/>
  <xacro:arg name="sim_gazebo" default="false"/>
  <xacro:arg name="sim_gz" default="true"/>
  <xacro:arg name="simulation_controllers" default=""/>
  <xacro:arg name="hmi" default="false"/>

  <!-- ========================= -->
  <!-- CORE -->
  <!-- ========================= -->

  <xacro:include filename="$(find ur5_gripper_description)/urdf/ur.urdf.xacro" />
  <xacro:include filename="$(find robotiq_description)/urdf/robotiq_85_gripper.urdf.xacro" />
  <xacro:include filename="$(find robotiq_description)/urdf/robotiq_85_gripper.ros2_control.xacro" />
  <xacro:include filename="$(find ur5_gripper_description)/urdf/ur.ros2_control.xacro" />

  <!-- ========================= -->
  <!-- UR5 BASE -->
  <!-- ========================= -->

  <xacro:ur_robot
    name="$(arg name)"
    prefix="$(arg prefix)"
    parent="world"
    joint_limits_parameters_file="$(find ur5_gripper_description)/config/ur5/joint_limits.yaml"
    kinematics_parameters_file="$(find ur5_gripper_description)/config/ur5/default_kinematics.yaml"
    physical_parameters_file="$(find ur5_gripper_description)/config/ur5/physical_parameters.yaml"
    visual_parameters_file="$(find ur5_gripper_description)/config/ur5/visual_parameters.yaml"
    use_fake_hardware="$(arg use_fake_hardware)"
    fake_sensor_commands="$(arg fake_sensor_commands)"
    sim_gazebo="$(arg sim_gazebo)"
    sim_gz="$(arg sim_gz)"
    initial_positions="${load_yaml('$(find ur5_gripper_description)/config/initial_positions.yaml')}"
    robot_ip="0.0.0.0"
  >
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- ========================= -->
  <!-- GRIPPER -->
  <!-- ========================= -->

  <!-- Coupler -->
  <link name="robotiq_coupler">
    <visual>
      <geometry>
        <mesh filename="package://robotiq_description/meshes/robotiq_85_coupler.stl"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.015"/>
      </geometry>
    </collision>
  </link>

  <joint name="robotiq_coupler_joint" type="fixed">
    <origin xyz="0 0 0.004" rpy="0 0 ${-pi/2.0}" />
    <parent link="tool0"/>
    <child link="robotiq_coupler"/>
  </joint>

  <xacro:robotiq_85_gripper prefix="" parent="robotiq_coupler">
    <origin xyz="0 0 0.004" rpy="0 ${-pi/2} ${pi}"/>
  </xacro:robotiq_85_gripper>

  <!-- ros2_control -->
  <xacro:robotiq_85_ros2_control
    name="robotiq"
    prefix=""
    sim_gz="true"
    use_fake_hardware="false"/>

  <xacro:ur_ros2_control
    name="ur"
    prefix=""
    sim_gz="true"
    use_fake_hardware="false"
    script_filename=""
    output_recipe_filename=""
    input_recipe_filename=""
    tf_prefix=""
    hash_kinematics=""
    robot_ip="0.0.0.0"
  />

  <!-- ========================= -->
  <!-- STAND -->
  <!-- ========================= -->

  <link name="robot_stand">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="100"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.2 0.2 1.0"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <box size="0.2 0.2 1.0"/>
      </geometry>
    </collision>
  </link>

  <joint name="world_to_stand" type="fixed">
    <parent link="world"/>
    <child link="robot_stand"/>
    <origin xyz="0 0 0.5"/>
  </joint>

  <joint name="stand_to_robot" type="fixed">
    <parent link="robot_stand"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.52"/>
  </joint>

  <!-- ========================= -->
  <!-- CAMERAS -->
  <!-- ========================= -->

  <xacro:include filename="$(find ros2srrc_ur5_gazebo)/urdf/cam_on_hand_params.xacro"/>
  <xacro:include filename="$(find ros2srrc_ur5_gazebo)/urdf/cam_on_hand.xacro"/>

  <xacro:include filename="$(find ros2srrc_ur5_gazebo)/urdf/cam_on_base_params.xacro"/>
  <xacro:include filename="$(find ros2srrc_ur5_gazebo)/urdf/cam_on_base.xacro"/>

  <!-- ========================= -->
  <!-- HMI CAMERA -->
  <!-- ========================= -->

  <xacro:if value="$(arg hmi)">
    <xacro:include filename="$(find ros2srrc_hmi)/urdf/hmicamera.urdf.xacro"/>
    <xacro:HMI_camera
      x="2.5"
      y="1.5"
      z="2.0"
      roll="0.0"
      pitch="0.35"
      yaw="-2.6"
    />
  </xacro:if>

</robot>