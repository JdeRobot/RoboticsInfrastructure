<?xml version="1.0"?>
<robot name="ur5" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================= ARGUMENTOS ================= -->
  <xacro:arg name="sim_gz" default="true"/>
  <xacro:arg name="use_fake_hardware" default="false"/>

  <!-- ================= UR5 OFICIAL (TEXTURAS OK) ================= -->
  <xacro:include filename="$(find ur5_gripper_description)/urdf/ur.urdf.xacro"/>

  <xacro:ur_robot
    name="ur"
    prefix=""
    ur_type="ur5"
  />

  <!-- ================= GRIPPER ================= -->
  <xacro:include filename="$(find robotiq_description)/urdf/robotiq_85_gripper.urdf.xacro"/>
  <xacro:include filename="$(find robotiq_description)/urdf/robotiq_85_gripper.ros2_control.xacro"/>

  <!-- Coupler -->
  <link name="robotiq_coupler">
    <visual>
      <geometry>
        <mesh filename="package://robotiq_description/meshes/robotiq_85_coupler.stl"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.015"/>
      </geometry>
    </collision>
  </link>

  <joint name="robotiq_coupler_joint" type="fixed">
    <origin xyz="0 0 0.004" rpy="0 0 ${-pi/2.0}"/>
    <parent link="tool0"/>
    <child link="robotiq_coupler"/>
  </joint>

  <xacro:robotiq_85_gripper prefix="" parent="robotiq_coupler">
    <origin xyz="0 0 0.004" rpy="0 ${-pi/2} ${pi}"/>
  </xacro:robotiq_85_gripper>

  <!-- ================= ROS2 CONTROL ================= -->
  <xacro:include filename="$(find ur5_gripper_description)/urdf/ur.ros2_control.xacro"/>

  <xacro:ur_ros2_control
    name="ur"
    prefix=""
    sim_gz="true"
    use_fake_hardware="${use_fake_hardware}"
    script_filename=""
    output_recipe_filename=""
    input_recipe_filename=""
    tf_prefix=""
    hash_kinematics=""
    robot_ip="0.0.0.0"
  />

  <xacro:robotiq_85_ros2_control 
    name="robotiq" 
    prefix="" 
    sim_gz="true"
    use_fake_hardware="${use_fake_hardware}"
  />

  <!-- ================= STAND ================= -->
  <link name="world"/>

  <link name="robot_stand">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="100"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.2 0.2 1.0"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <box size="0.2 0.2 1.0"/>
      </geometry>
    </collision>
  </link>

  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="robot_stand"/>
    <origin xyz="0 0 0.5"/>
  </joint>

  <joint name="stand_joint" type="fixed">
    <parent link="robot_stand"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.52"/>
  </joint>

  <!-- ================= CAMARAS (USANDO TUS MACROS) ================= -->

  <!-- PARAMS -->
  <xacro:include filename="$(find ros2srrc_ur5_gazebo)/urdf/cam_on_hand_params.xacro"/>
  <xacro:include filename="$(find ros2srrc_ur5_gazebo)/urdf/cam_on_base_params.xacro"/>

  <!-- GZ SENSORS -->
  <xacro:include filename="$(find ros2srrc_ur5_gazebo)/urdf/cam_on_hand_gz.xacro"/>
  <xacro:include filename="$(find ros2srrc_ur5_gazebo)/urdf/cam_on_base_gz.xacro"/>

  <!-- INSTANCIACIÓN -->
  <xacro:cam_on_hand_gz parent_link="wrist_3_link"/>
  <xacro:cam_on_base_gz parent_link="base_link"/>

  <!-- ================= GAZEBO CONTROL ================= -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin"/>
  </gazebo>

</robot>