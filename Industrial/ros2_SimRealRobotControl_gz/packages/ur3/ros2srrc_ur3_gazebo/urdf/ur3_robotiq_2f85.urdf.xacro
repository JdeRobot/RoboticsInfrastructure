<robot name="ur3" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- PASS ARGUMENTS: -->
  <xacro:arg name="bringup" default="false"/>
  <xacro:property name="bringup" value="$(arg bringup)"/>
  <xacro:arg name="hmi" default="false"/>
  <xacro:property name="hmi" value="$(arg hmi)"/>
  <xacro:arg name="robot_ip" default="0.0.0.0"/>
  <xacro:property name="robot_ip" value="$(arg robot_ip)"/>

  <xacro:arg name="EE" default="false"/>
  <xacro:property name="EE" value="$(arg EE)"/>
  <xacro:arg name="EE_name" default="none"/>
  <xacro:property name="EE_name" value="$(arg EE_name)"/>
  <xacro:arg name="camera" default="false"/>
  <xacro:property name="camera" value="$(arg camera)"/>

  <!-- UR3 Control ARGUMENTS -->
  <xacro:arg name="script_filename" default="none"/>
  <xacro:property name="script_filename" value="$(arg script_filename)"/>
  <xacro:arg name="input_recipe_filename" default="none"/>
  <xacro:property name="input_recipe_filename" value="$(arg input_recipe_filename)"/>
  <xacro:arg name="output_recipe_filename" default="none"/>
  <xacro:property name="output_recipe_filename" value="$(arg output_recipe_filename)"/>

  <!-- Include cams -->
  <xacro:include filename="$(find ros2srrc_ur5_gazebo)/urdf/common_properties.xacro"/>

  <!-- HAND CAMERA -->

  <xacro:include filename="$(find ros2srrc_ur5_gazebo)/urdf/cam_on_hand_params_gz.xacro"/>
  <xacro:property name="parent_hand" value="tool0"/>
  <xacro:include filename="$(find ros2srrc_ur5_gazebo)/urdf/cam_on_hand_gz.xacro"/>

  <!-- BASE CAMERA -->

  <xacro:include filename="$(find ros2srrc_ur5_gazebo)/urdf/cam_on_base_params_gz.xacro"/>
  <xacro:property name="parent_base" value="base_link"/>
  <xacro:property name="cam_base_pz" value="0.5"/>
  <xacro:include filename="$(find ros2srrc_ur5_gazebo)/urdf/cam_on_base_gz.xacro"/>

  <!-- Include XACRO-MACRO file of the UR3: -->
  <xacro:include filename="$(find ros2srrc_robots)/ur3/urdf/ur3_macro.urdf.xacro"/>
  <xacro:ur3
    bringup="${bringup}"
    robot_ip="${robot_ip}"
    EE="${EE}"
    EE_name="${EE_name}"
    script_filename="${script_filename}"
    input_recipe_filename="${input_recipe_filename}"
    output_recipe_filename="${output_recipe_filename}"
  />

  <!-- Include XACRO-MACRO file of the Robotiq 2f-85: -->
  <xacro:include filename="$(find robotiq_description)/urdf/robotiq_85_gripper.urdf.xacro"/>
  <xacro:include filename="$(find robotiq_description)/urdf/robotiq_85_gripper.ros2_control.xacro"/>

  <link name="robotiq_coupler">
    <visual>
      <geometry>
        <mesh filename="package://robotiq_description/meshes/robotiq_85_coupler.stl"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.015"/>
      </geometry>
    </collision>
  </link>

  <joint name="robotiq_coupler_joint" type="fixed">
    <origin xyz="0 0 0.004" rpy="0 0 ${-pi/2.0}"/>
    <parent link="tool0"/>
    <child link="robotiq_coupler"/>
  </joint>

  <xacro:robotiq_85_gripper
    prefix=""
    parent="robotiq_coupler">

    <origin xyz="0 0 0.004"
            rpy="0 ${-pi/2} ${pi}"/>

  </xacro:robotiq_85_gripper>

  <xacro:robotiq_85_ros2_control
    name="robotiq"
    prefix=""
    sim_gz="true"
  use_fake_hardware="false"/>

  <!-- Load ROS 2 Gazebo Plugin -->
  <xacro:unless value="${bringup}">
    
    <gazebo>
      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">

        <parameters>
          $(find ros2srrc_robots)/ur3/config/controller.yaml
        </parameters>

        <parameters>
          $(find ros2srrc_endeffectors)/${EE_name}/config/controller.yaml
        </parameters>

      </plugin>
    </gazebo>

  </xacro:unless>

  <!-- World: LINK -->
  <link name="world"/>
  
  <!-- Robot Stand: LINK -->
  <link name='robot_stand'>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="100"/>
      <inertia ixx="0.01"  ixy="0"  ixz="0" iyy="0.01" iyz="0" izz="0.01" />
    </inertial>
    <collision name='collision'>
      <origin xyz="0 0 0" rpy=" 0 0 0"/> 
      <geometry>
        <box size = "0.2 0.2 1.0"/>
      </geometry>
    </collision>
    <visual name='chassis_visual'>
      <origin xyz="0 0 0" rpy=" 0 0 0"/>
      <geometry>
        <box size = "0.2 0.2 1.0"/>
      </geometry>
    </visual>
  </link>

  <!-- Robot Stand: FIXED JOINT -->
  <joint name="world_joint" type="fixed">
    <parent link= "world" />
    <child link = "robot_stand" />
    <origin xyz="0.0 0.0 0.5" rpy="0.0 0.0 0.0" />
  </joint>

  <!-- Robot Stand: Robot+Stand JOINT -->
  <joint name="stand_joint" type="fixed">
    <parent link= "robot_stand" />
    <child link = "base_link" />
    <origin xyz="0.0 0.0 0.505" rpy="0.0 0.0 0.0" /> 
  </joint>

  <!-- ros2srrc_HMI CAMERA -->
  <xacro:if value="${hmi}">
    <xacro:include filename="$(find ros2srrc_hmi)/urdf/hmicamera.urdf.xacro"/>	
    <xacro:HMI_camera 
      x="2.0"
      y="1.25"
      z="1.5"
      roll="0.0"
      pitch="0.35"
      yaw="-2.6"
    />
  </xacro:if>

</robot>
