<?xml version="1.0" ?>
<robot name="dobot_magician">

  <!-- Joint list instead of a chain, the parallelogram's two mimic joints
       sit between joint_3 and joint_4, a chain group would count them as
       extra planning variables and break the framework's 4 DOF
       assumption. No KDL IK for this group either way, MoveAbsJ doesn't
       need it. -->
  <group name="dobot_magician_arm">
    <joint name="joint_1"/>
    <joint name="joint_2"/>
    <joint name="joint_3"/>
    <joint name="joint_4"/>
  </group>

  <!-- Gives the joint list arm an end effector link for robpose -->
  <group name="dobot_suction_cup">
    <link name="link_suction_cup"/>
  </group>

  <group_state group="dobot_magician_arm" name="home">
    <joint name="joint_1" value="0"/>
    <joint name="joint_2" value="0.3"/>
    <joint name="joint_3" value="0.3"/>
    <joint name="joint_4" value="0"/>
  </group_state>

  <group_state group="dobot_magician_arm" name="up">
    <joint name="joint_1" value="0"/>
    <joint name="joint_2" value="0"/>
    <joint name="joint_3" value="0"/>
    <joint name="joint_4" value="0"/>
  </group_state>

  <end_effector group="dobot_suction_cup" name="dobot_suction_cup" parent_group="dobot_magician_arm" parent_link="link_suction_cup"/>

  <!-- Parallelogram follower joints, MoveIt must not plan these directly -->
  <passive_joint name="joint_mimic_1"/>
  <passive_joint name="joint_mimic_2"/>

  <disable_collisions link1="base_link" link2="link_1" reason="Adjacent"/>
  <disable_collisions link1="link_1" link2="link_2" reason="Adjacent"/>
  <disable_collisions link1="link_2" link2="link_3" reason="Adjacent"/>
  <disable_collisions link1="link_3" link2="link_virtual" reason="Adjacent"/>
  <disable_collisions link1="link_virtual" link2="link_4" reason="Adjacent"/>
  <disable_collisions link1="link_4" link2="link_suction_cup" reason="Adjacent"/>

  <!-- The parallelogram keeps link_4 and the suction cup close to link_2/link_3
       through most of the working range, this open chain approximation
       would otherwise trip the default self collision checker. -->
  <disable_collisions link1="link_2" link2="link_4" reason="Never"/>
  <disable_collisions link1="link_3" link2="link_4" reason="Never"/>
  <disable_collisions link1="link_3" link2="link_suction_cup" reason="Never"/>
  <disable_collisions link1="link_virtual" link2="link_2" reason="Never"/>
  <disable_collisions link1="link_virtual" link2="link_3" reason="Never"/>

</robot>
