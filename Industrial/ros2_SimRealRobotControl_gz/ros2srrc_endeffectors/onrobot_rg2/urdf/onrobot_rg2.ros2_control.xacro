<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Mimic joints only carry state interfaces, gz_ros2_control drives them from the params -->
  <xacro:macro name="rg2_mimic_joint" params="prefix name multiplier">
    <joint name="${prefix}${name}">
      <param name="mimic">${prefix}rg2_finger_joint</param>
      <param name="multiplier">${multiplier}</param>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="onrobot_rg2_ros2_control" params="name prefix">
    <ros2_control name="${name}_gripper" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>

      <joint name="${prefix}rg2_finger_joint">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">1.343903</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <xacro:rg2_mimic_joint prefix="${prefix}" name="rg2_right_outer_knuckle_joint" multiplier="-1.0"/>
      <xacro:rg2_mimic_joint prefix="${prefix}" name="rg2_left_inner_knuckle_joint" multiplier="-1.0"/>
      <xacro:rg2_mimic_joint prefix="${prefix}" name="rg2_right_inner_knuckle_joint" multiplier="-1.0"/>
      <xacro:rg2_mimic_joint prefix="${prefix}" name="rg2_left_inner_finger_joint" multiplier="1.0"/>
      <xacro:rg2_mimic_joint prefix="${prefix}" name="rg2_right_inner_finger_joint" multiplier="1.0"/>
    </ros2_control>
  </xacro:macro>

</robot>
