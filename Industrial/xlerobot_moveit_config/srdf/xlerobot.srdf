<?xml version="1.0" encoding="utf-8"?>
<robot name="xlerobot">

  <group name="xlerobot_left_arm">
    <chain base_link="Base" tip_link="Fixed_Jaw"/>
  </group>

  <group name="xlerobot_right_arm">
    <chain base_link="Base_2" tip_link="Fixed_Jaw_2"/>
  </group>

  <group name="left_gripper">
    <joint name="Jaw_L"/>
  </group>

  <group name="right_gripper">
    <joint name="Jaw_R"/>
  </group>

  <group_state group="xlerobot_left_arm" name="home">
    <joint name="Rotation_L" value="0" />
    <joint name="Pitch_L" value="0" />
    <joint name="Elbow_L" value="0" />
    <joint name="Wrist_Pitch_L" value="0" />
    <joint name="Wrist_Roll_L" value="0" />
  </group_state>

  <group_state group="xlerobot_right_arm" name="home">
    <joint name="Rotation_R" value="0" />
    <joint name="Pitch_R" value="0" />
    <joint name="Elbow_R" value="0" />
    <joint name="Wrist_Pitch_R" value="0" />
    <joint name="Wrist_Roll_R" value="0" />
  </group_state>

  <group_state group="left_gripper" name="open">
    <joint name="Jaw_L" value="0" />
  </group_state>
  <group_state group="left_gripper" name="closed">
    <joint name="Jaw_L" value="1.5" />
  </group_state>

  <group_state group="right_gripper" name="open">
    <joint name="Jaw_R" value="0" />
  </group_state>
  <group_state group="right_gripper" name="closed">
    <joint name="Jaw_R" value="1.5" />
  </group_state>

  <end_effector name="left_gripper" parent_link="Fixed_Jaw" group="left_gripper"/>
  <end_effector name="right_gripper" parent_link="Fixed_Jaw_2" group="right_gripper"/>

  <!-- No virtual joint to world on purpose, base_footprint moves with the chassis
       via VelocityControl and is not tracked by any static transform, planning stays
       relative to the robot itself -->

  <!-- Programmatically generated from the URDF's actual joint tree (fixed
       joints group links into a single rigid body, movable joints connect
       two rigid bodies), covering every link pair that will always be
       touching. This replaces a hand-picked list that only covered direct
       parent/child pairs and missed the cross pairs (a link and its
       parent's own "_geom_1" sibling, e.g. Rotation_Pitch vs Base_geom_1),
       which made every single pose, including the plain home pose, read
       as self-colliding to check_state_validity/avoid_collisions, in turn
       making pilz_industrial_motion_planner (which checks self collision
       on every IK call by default) fail to find a plan for reachable,
       non-colliding poses. Confirmed against a live check_state_validity
       call before and after this fix. -->
  <disable_collisions link1="Base" link2="Base_2" reason="Adjacent" />
  <disable_collisions link1="Base" link2="Base_2_geom_1" reason="Adjacent" />
  <disable_collisions link1="Base" link2="Base_geom_1" reason="Adjacent" />
  <disable_collisions link1="Base" link2="Rotation_Pitch" reason="Adjacent" />
  <disable_collisions link1="Base" link2="Rotation_Pitch_2" reason="Adjacent" />
  <disable_collisions link1="Base" link2="Rotation_Pitch_2_geom_1" reason="Adjacent" />
  <disable_collisions link1="Base" link2="Rotation_Pitch_geom_1" reason="Adjacent" />
  <disable_collisions link1="Base" link2="base_footprint" reason="Adjacent" />
  <disable_collisions link1="Base" link2="chassis" reason="Adjacent" />
  <disable_collisions link1="Base" link2="chassis_geom_1" reason="Adjacent" />
  <disable_collisions link1="Base" link2="chassis_geom_2" reason="Adjacent" />
  <disable_collisions link1="Base" link2="head_pan_link" reason="Adjacent" />
  <disable_collisions link1="Base" link2="head_pan_link_geom_1" reason="Adjacent" />
  <disable_collisions link1="Base" link2="top_base_link" reason="Adjacent" />
  <disable_collisions link1="Base" link2="top_base_link_geom_1" reason="Adjacent" />
  <disable_collisions link1="Base" link2="wheel_1_link" reason="Adjacent" />
  <disable_collisions link1="Base" link2="wheel_2_link" reason="Adjacent" />
  <disable_collisions link1="Base" link2="wheel_3_link" reason="Adjacent" />
  <disable_collisions link1="Base_2" link2="Base_2_geom_1" reason="Adjacent" />
  <disable_collisions link1="Base_2" link2="Base_geom_1" reason="Adjacent" />
  <disable_collisions link1="Base_2" link2="Rotation_Pitch" reason="Adjacent" />
  <disable_collisions link1="Base_2" link2="Rotation_Pitch_2" reason="Adjacent" />
  <disable_collisions link1="Base_2" link2="Rotation_Pitch_2_geom_1" reason="Adjacent" />
  <disable_collisions link1="Base_2" link2="Rotation_Pitch_geom_1" reason="Adjacent" />
  <disable_collisions link1="Base_2" link2="base_footprint" reason="Adjacent" />
