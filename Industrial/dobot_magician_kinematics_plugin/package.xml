<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dobot_magician_kinematics_plugin</name>
  <version>1.0.0</version>
  <description>
    Analytic MoveIt IK plugin for the Dobot Magician arm, needed because
    the parallelogram's mimic joints keep dobot_magician_arm from being a
    real kinematic chain, which rules out KDL/TRAC-IK for this robot.
  </description>
  <maintainer email="aquintana.camacho@gmail.com">RoboticsAcademy</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>moveit_core</depend>
  <depend>pluginlib</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <moveit_core plugin="${prefix}/dobot_magician_kinematics_description.xml"/>
  </export>
</package>
