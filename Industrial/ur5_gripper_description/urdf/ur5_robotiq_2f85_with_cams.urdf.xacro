<?xml version="1.0"?>
<robot name="ur5" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="sim_gz" default="true"/>

  <xacro:include filename="$(find ur5_gripper_description)/urdf/ur.urdf.xacro"/>
  <xacro:include filename="$(find robotiq_description)/urdf/robotiq_85_gripper.urdf.xacro"/>
  <xacro:include filename="$(find robotiq_description)/urdf/robotiq_85_gripper.ros2_control.xacro"/>

  <xacro:ur
    name="ur"
    ur_type="ur5"
    prefix=""
    sim_gz="true"
    use_fake_hardware="false"
  />

  <link name="robotiq_coupler">
    <visual>
      <geometry>
        <mesh filename="package://robotiq_description/meshes/robotiq_85_coupler.stl"/>
      </geometry>
    </visual>
  </link>

  <joint name="robotiq_coupler_joint" type="fixed">
    <parent link="tool0"/>
    <child link="robotiq_coupler"/>
    <origin xyz="0 0 0.004" rpy="0 0 ${-pi/2}"/>
  </joint>

  <xacro:robotiq_85_gripper parent="robotiq_coupler">
    <origin xyz="0 0 0.004" rpy="0 ${-pi/2} ${pi}"/>
  </xacro:robotiq_85_gripper>

  <link name="robot_stand">
    <visual>
      <geometry>
        <box size="0.2 0.2 1.0"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <box size="0.2 0.2 1.0"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="100"/>
      <inertia ixx="0.01" iyy="0.01" izz="0.01"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <link name="world"/>

  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="robot_stand"/>
    <origin xyz="0 0 0.5"/>
  </joint>

  <joint name="stand_joint" type="fixed">
    <parent link="robot_stand"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.52"/>
  </joint>

  <link name="camera_base_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
      <material>
        <ambient>0 0 0 1</ambient>
      </material>
    </visual>
  </link>

  <joint name="camera_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_base_link"/>
    <origin xyz="0.4 0 1.2" rpy="0 0 0"/>
  </joint>

  <gazebo reference="camera_base_link">
    <sensor name="camera_base" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <link name="camera_hand_link">
    <visual>
      <geometry>
        <box size="0.04 0.04 0.04"/>
      </geometry>
      <material>
        <ambient>0 0 0 1</ambient>
      </material>
    </visual>
  </link>

  <joint name="camera_hand_joint" type="fixed">
    <parent link="tool0"/>
    <child link="camera_hand_link"/>
    <origin xyz="0.05 0 0.1" rpy="0 0 0"/>
  </joint>

  <gazebo reference="camera_hand_link">
    <sensor name="camera_hand" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
      </camera>
    </sensor>
  </gazebo>

  <xacro:robotiq_85_ros2_control
    name="robotiq"
    sim_gz="true"
    use_fake_hardware="false"/>

</robot>