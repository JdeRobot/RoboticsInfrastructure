<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>odom_with_covariance_plugin</name>
  <version>0.0.0</version>
  <description>Gazebo Harmonic plugin for publishing odometry with covariance and configurable noise, adapted from Aerostack2.</description>
  <maintainer email="email@email.com">aquintan4</maintainer>
  <license>BSD-3-Clause AND Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros plugin_path="${prefix}/lib"/>
  </export>
</package>