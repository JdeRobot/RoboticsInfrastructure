<?xml version="1.0" encoding="utf-8"?>
<robot name="myagv_mecharm">

  <!-- No virtual joint so planning stays relative to base_footprint while the base drives -->

  <group name="mecharm_arm">
    <chain base_link="g_base" tip_link="gripper_tcp"/>
  </group>

  <group name="adaptive_gripper">
    <joint name="gripper_base_to_gripper_left3"/>
    <joint name="gripper_base_to_gripper_left2"/>
    <joint name="gripper_left3_to_gripper_left1"/>
    <joint name="gripper_base_to_gripper_right3"/>
    <joint name="gripper_base_to_gripper_right2"/>
    <joint name="gripper_right3_to_gripper_right1"/>
  </group>

  <end_effector name="gripper" parent_link="gripper_tcp" group="adaptive_gripper" parent_group="mecharm_arm"/>

  <!-- Arm folded over the base for driving -->
  <group_state name="home" group="mecharm_arm">
    <joint name="joint1_to_base" value="0"/>
    <joint name="joint2_to_joint1" value="-0.1"/>
    <joint name="joint3_to_joint2" value="0.2"/>
    <joint name="joint4_to_joint3" value="0"/>
    <joint name="joint5_to_joint4" value="1.5"/>
    <joint name="joint6_to_joint5" value="0"/>
  </group_state>

  <!-- Gripper 70 degrees below the horizon 0.2 m ahead of the base and 0.16 m above the floor -->
  <group_state name="ready" group="mecharm_arm">
    <joint name="joint1_to_base" value="0"/>
    <joint name="joint2_to_joint1" value="0.236"/>
    <joint name="joint3_to_joint2" value="0.255"/>
    <joint name="joint4_to_joint3" value="0"/>
    <joint name="joint5_to_joint4" value="0.739"/>
    <joint name="joint6_to_joint5" value="0"/>
  </group_state>

  <group_state name="zero" group="mecharm_arm">
    <joint name="joint1_to_base" value="0"/>
    <joint name="joint2_to_joint1" value="0"/>
    <joint name="joint3_to_joint2" value="0"/>
    <joint name="joint4_to_joint3" value="0"/>
    <joint name="joint5_to_joint4" value="0"/>
    <joint name="joint6_to_joint5" value="0"/>
  </group_state>

  <group_state name="GripperOpen" group="adaptive_gripper">
    <joint name="gripper_base_to_gripper_left3" value="0.15"/>
  </group_state>

  <!-- Closes just past a 25 mm object so the fingers do not sink into it -->
  <group_state name="GripperClose" group="adaptive_gripper">
    <joint name="gripper_base_to_gripper_left3" value="-0.4"/>
  </group_state>

  <!-- Pairs that are always in contact or never collide over 20000 random arm poses -->
  <disable_collisions link1="base" link2="base_link" reason="Adjacent"/>
  <disable_collisions link1="base" link2="link1" reason="Adjacent"/>
  <disable_collisions link1="base" link2="wheel_back_left_link" reason="Adjacent"/>
  <disable_collisions link1="base" link2="wheel_back_right_link" reason="Adjacent"/>
  <disable_collisions link1="base" link2="wheel_front_left_link" reason="Adjacent"/>
  <disable_collisions link1="base" link2="wheel_front_right_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="link1" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="link2" reason="Never"/>
  <disable_collisions link1="base_link" link2="link3" reason="Never"/>
  <disable_collisions link1="base_link" link2="wheel_back_left_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="wheel_back_right_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="wheel_front_left_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="wheel_front_right_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="gripper_left1" reason="Default"/>
  <disable_collisions link1="gripper_base" link2="gripper_left2" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="gripper_left3" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="gripper_right1" reason="Default"/>
  <disable_collisions link1="gripper_base" link2="gripper_right2" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="gripper_right3" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="link4" reason="Never"/>
  <disable_collisions link1="gripper_base" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="link6" reason="Adjacent"/>
  <disable_collisions link1="gripper_left1" link2="gripper_left2" reason="Default"/>
  <disable_collisions link1="gripper_left1" link2="gripper_left3" reason="Adjacent"/>
  <disable_collisions link1="gripper_left1" link2="gripper_right1" reason="Never"/>
  <disable_collisions link1="gripper_left1" link2="gripper_right2" reason="Never"/>
  <disable_collisions link1="gripper_left1" link2="gripper_right3" reason="Never"/>
  <disable_collisions link1="gripper_left1" link2="link3" reason="Never"/>
  <disable_collisions link1="gripper_left1" link2="link4" reason="Never"/>
  <disable_collisions link1="gripper_left1" link2="link5" reason="Never"/>
  <disable_collisions link1="gripper_left1" link2="link6" reason="Never"/>
  <disable_collisions link1="gripper_left2" link2="gripper_left3" reason="Default"/>
  <disable_collisions link1="gripper_left2" link2="gripper_right1" reason="Never"/>
  <disable_collisions link1="gripper_left2" link2="gripper_right2" reason="Never"/>
  <disable_collisions link1="gripper_left2" link2="gripper_right3" reason="Default"/>
  <disable_collisions link1="gripper_left2" link2="link3" reason="Never"/>
  <disable_collisions link1="gripper_left2" link2="link4" reason="Never"/>
  <disable_collisions link1="gripper_left2" link2="link5" reason="Never"/>
  <disable_collisions link1="gripper_left2" link2="link6" reason="Adjacent"/>
  <disable_collisions link1="gripper_left3" link2="gripper_right1" reason="Never"/>
  <disable_collisions link1="gripper_left3" link2="gripper_right2" reason="Default"/>
  <disable_collisions link1="gripper_left3" link2="gripper_right3" reason="Default"/>
  <disable_collisions link1="gripper_left3" link2="link3" reason="Never"/>
  <disable_collisions link1="gripper_left3" link2="link4" reason="Never"/>
  <disable_collisions link1="gripper_left3" link2="link5" reason="Never"/>
  <disable_collisions link1="gripper_left3" link2="link6" reason="Adjacent"/>
  <disable_collisions link1="gripper_right1" link2="gripper_right2" reason="Default"/>
  <disable_collisions link1="gripper_right1" link2="gripper_right3" reason="Adjacent"/>
  <disable_collisions link1="gripper_right1" link2="link3" reason="Never"/>
  <disable_collisions link1="gripper_right1" link2="link4" reason="Never"/>
  <disable_collisions link1="gripper_right1" link2="link5" reason="Never"/>
  <disable_collisions link1="gripper_right1" link2="link6" reason="Never"/>
  <disable_collisions link1="gripper_right2" link2="gripper_right3" reason="Default"/>
  <disable_collisions link1="gripper_right2" link2="link3" reason="Never"/>
  <disable_collisions link1="gripper_right2" link2="link4" reason="Never"/>
  <disable_collisions link1="gripper_right2" link2="link5" reason="Never"/>
  <disable_collisions link1="gripper_right2" link2="link6" reason="Adjacent"/>
  <disable_collisions link1="gripper_right3" link2="link3" reason="Never"/>
  <disable_collisions link1="gripper_right3" link2="link4" reason="Never"/>
  <disable_collisions link1="gripper_right3" link2="link5" reason="Never"/>
  <disable_collisions link1="gripper_right3" link2="link6" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="link2" reason="Adjacent"/>
  <disable_collisions link1="link1" link2="wheel_back_left_link" reason="Never"/>
  <disable_collisions link1="link1" link2="wheel_back_right_link" reason="Never"/>
  <disable_collisions link1="link1" link2="wheel_front_left_link" reason="Never"/>
  <disable_collisions link1="link1" link2="wheel_front_right_link" reason="Never"/>
  <disable_collisions link1="link2" link2="link3" reason="Adjacent"/>
  <disable_collisions link1="link2" link2="wheel_back_left_link" reason="Never"/>
  <disable_collisions link1="link2" link2="wheel_back_right_link" reason="Never"/>
  <disable_collisions link1="link2" link2="wheel_front_left_link" reason="Never"/>
  <disable_collisions link1="link2" link2="wheel_front_right_link" reason="Never"/>
  <disable_collisions link1="link3" link2="link4" reason="Adjacent"/>
  <disable_collisions link1="link3" link2="wheel_back_left_link" reason="Never"/>
  <disable_collisions link1="link3" link2="wheel_back_right_link" reason="Never"/>
  <disable_collisions link1="link3" link2="wheel_front_left_link" reason="Never"/>
  <disable_collisions link1="link3" link2="wheel_front_right_link" reason="Never"/>
  <disable_collisions link1="link4" link2="link5" reason="Adjacent"/>
  <disable_collisions link1="link4" link2="link6" reason="Never"/>
  <disable_collisions link1="link4" link2="wheel_back_left_link" reason="Never"/>
  <disable_collisions link1="link4" link2="wheel_back_right_link" reason="Never"/>
  <disable_collisions link1="link4" link2="wheel_front_left_link" reason="Never"/>
  <disable_collisions link1="link4" link2="wheel_front_right_link" reason="Never"/>
  <disable_collisions link1="link5" link2="link6" reason="Adjacent"/>
  <disable_collisions link1="link5" link2="wheel_back_right_link" reason="Never"/>
  <disable_collisions link1="wheel_back_left_link" link2="wheel_back_right_link" reason="Never"/>
  <disable_collisions link1="wheel_back_left_link" link2="wheel_front_left_link" reason="Never"/>
  <disable_collisions link1="wheel_back_left_link" link2="wheel_front_right_link" reason="Never"/>
  <disable_collisions link1="wheel_back_right_link" link2="wheel_front_left_link" reason="Never"/>
  <disable_collisions link1="wheel_back_right_link" link2="wheel_front_right_link" reason="Never"/>
  <disable_collisions link1="wheel_front_left_link" link2="wheel_front_right_link" reason="Never"/>

</robot>
