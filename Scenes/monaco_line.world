<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="default">

    <physics default="true" type="ignored" name="16ms">
      <max_step_size>0.016</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system">
      <state_hertz>12</state_hertz>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8</gravity>
    <atmosphere type="adiabatic"/>

    <scene>
      <ambient>0.74 0.74 0.74 1</ambient>
      <background>0.55 0.72 0.90 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <!-- Circuito -->
    <include>
      <uri>model://monaco</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Dynamic Racing Start & Sector Lights + Tunnel Ceiling Panels (3 merged OBJ visuals for ~1.00 RTF) -->
    <include>
      <uri>model://monaco_racing_lights</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Single shadow-free Mediterranean Sunlight (keeps Ogre2 software shader at 1x pass for ~1.00 RTF) -->
    <light name="sun" type="directional">
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.92 0.90 0.85 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.45 0.20 -0.85</direction>
      <cast_shadows>false</cast_shadows>
    </light>

  </world>
</sdf>
