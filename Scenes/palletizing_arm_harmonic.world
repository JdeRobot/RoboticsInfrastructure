<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="default">
    <!-- Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="libgz_link_attacher.so" name="gz_link_attacher::LinkAttacher">
      <robot_model_name>ur10_suction</robot_model_name>
      <gripper_link_name>ls_vgr_link</gripper_link_name>
    </plugin>

    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact">
    </plugin>

    <!-- Scene -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <visualize>false</visualize>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Conveyor: moving belt driven by TrackController. The model name "conveyor"
         sets the command topic /model/conveyor/link/link/track_cmd_vel.
         Runs along +X, away from the robot at the origin; 2.4 m long, centred at
         X=1.80 (spans X in [0.60, 3.00]). Boxes feed from the far end and ride
         toward the robot for pickup. -->
    <include>
      <uri>model://conveyor_belt</uri>
      <name>conveyor</name>
      <pose>1.80 0 0 0 0 0</pose>
    </include>

    <!-- Ground Logo Big -->
    <model name="ground_logo_big">
      <static>true</static>
      <pose>-0.5 0 0 0 0 1.57</pose>
      <link name="link">
        <visual name="visual">
          <pose>0 0 0.001 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://ground_logo_big/meshes/ground_logo.dae</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Wooden pallet on a low stand: the target platform for stacking. Placed on
         the robot's right (-Y) so pick (front, +X) -> place (right, -Y) is a ~90 deg
         swing. Deck top sits at world z=0.30. Centre at Y=-0.88 keeps the whole
         stacking area inside the UR10's ~1.30 m reach while clearing the robot base.
         The place coordinates in the exercise code must match this pose. -->
    <model name="target_pallet">
      <static>true</static>
      <pose>0 -0.88 0 0 0 0</pose>
      <link name="link">
        <!-- Pallet deck (top board the boxes rest on): 1.60 x 1.30 x 0.10, sized
             so the finished box stack fits well inside. Top face at world z=0.30. -->
        <visual name="deck_visual">
          <pose>0 0 0.25 0 0 0</pose>
          <geometry>
            <box>
              <size>1.60 1.30 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.40 0.26 0.13 1</ambient>
            <diffuse>0.55 0.36 0.18 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="deck_collision">
          <pose>0 0 0.25 0 0 0</pose>
          <geometry>
            <box>
              <size>1.60 1.30 0.10</size>
            </box>
          </geometry>
        </collision>
        <!-- Solid stand block under the deck (0 -> 0.20 m). Simple box to keep the
             collision geometry cheap for the planner. -->
        <visual name="stand_visual">
          <pose>0 0 0.10 0 0 0</pose>
          <geometry>
            <box>
              <size>1.50 1.20 0.20</size>
            </box>
          </geometry>
          <material>
            <ambient>0.30 0.20 0.10 1</ambient>
            <diffuse>0.45 0.30 0.15 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <collision name="stand_collision">
          <pose>0 0 0.10 0 0 0</pose>
          <geometry>
            <box>
              <size>1.50 1.20 0.20</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Robot Base (Placeholder) -->
    <model name="robotbase">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <pose>0 0 0.45 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.09</radius>
              <length>0.9</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.09</radius>
              <length>0.9</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Source boxes are spawned onto the belt at runtime by the box_spawner node
         (CustomRobots/palletizing/scripts/box_spawner.py), so none are defined here. -->

  </world>
</sdf>
