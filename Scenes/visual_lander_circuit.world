<?xml version="1.0"?>
<sdf version="1.8">
	<world name="default">
		<physics name="4ms" type="ignored">
			<max_step_size>0.004</max_step_size>
			<real_time_factor>1.0</real_time_factor>
		</physics>
		<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
		</plugin>
		<plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
		</plugin>
		<plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
		</plugin>
		<plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
			<render_engine>ogre2</render_engine>
		</plugin>

		<scene>
			<grid>false</grid>
		</scene>

		<!--light-->
		<light type="directional" name="sun">
			<cast_shadows>true</cast_shadows>
			<pose>0 0 10 0 0 0</pose>
			<diffuse>0.8 0.8 0.8 1</diffuse>
			<specular>0.2 0.2 0.2 1</specular>
			<attenuation>
				<range>1000</range>
				<constant>0.9</constant>
				<linear>0.01</linear>
				<quadratic>0.001</quadratic>
			</attenuation>
			<direction>-0.5 0.1 -0.9</direction>
		</light>

		<include>
			<uri>model://grass_plane</uri>
		</include>

		<include>
			<uri>model://logoPadGreen</uri>
			<name>start_pad</name>
			<pose>0 -13 0.05 0 0 0</pose>
		</include>

		<!-- Rectangular road loop, square corners. road_plane runs along local Y, yawed to match
		each side's direction. Raised to z=0.01 so it doesn't z-fight with the grass plane. -->
		<include>
			<uri>model://road_plane</uri>
			<name>road_s1_a</name>
			<pose>-10 -9 0.01 0 0 1.5708</pose>
		</include>
		<include>
			<uri>model://road_plane</uri>
			<name>road_s1_b</name>
			<pose>-10 -7 0.01 0 0 1.5708</pose>
		</include>
		<include>
			<uri>model://road_plane</uri>
			<name>road_s2_a</name>
			<pose>0 -9 0.01 0 0 1.5708</pose>
		</include>
		<include>
			<uri>model://road_plane</uri>
			<name>road_s2_b</name>
			<pose>0 -7 0.01 0 0 1.5708</pose>
		</include>
		<include>
			<uri>model://road_plane</uri>
			<name>road_s3_a</name>
			<pose>10 -9 0.01 0 0 1.5708</pose>
		</include>
		<include>
			<uri>model://road_plane</uri>
			<name>road_s3_b</name>
			<pose>10 -7 0.01 0 0 1.5708</pose>
		</include>
		<include>
			<uri>model://road_plane</uri>
			<name>road_n1_a</name>
			<pose>-10 7 0.01 0 0 1.5708</pose>
		</include>
		<include>
			<uri>model://road_plane</uri>
			<name>road_n1_b</name>
			<pose>-10 9 0.01 0 0 1.5708</pose>
		</include>
		<include>
			<uri>model://road_plane</uri>
			<name>road_n2_a</name>
			<pose>0 7 0.01 0 0 1.5708</pose>
		</include>
		<include>
			<uri>model://road_plane</uri>
			<name>road_n2_b</name>
			<pose>0 9 0.01 0 0 1.5708</pose>
		</include>
		<include>
			<uri>model://road_plane</uri>
			<name>road_n3_a</name>
			<pose>10 7 0.01 0 0 1.5708</pose>
		</include>
		<include>
			<uri>model://road_plane</uri>
			<name>road_n3_b</name>
			<pose>10 9 0.01 0 0 1.5708</pose>
		</include>
		<include>
			<uri>model://road_plane</uri>
			<name>road_w1_a</name>
			<pose>-18 -5 0.01 0 0 0</pose>
		</include>
		<include>
			<uri>model://road_plane</uri>
			<name>road_w1_b</name>
			<pose>-16 -5 0.01 0 0 0</pose>
		</include>
		<include>
			<uri>model://road_plane</uri>
			<name>road_w2_a</name>
			<pose>-18 5 0.01 0 0 0</pose>
		</include>
		<include>
			<uri>model://road_plane</uri>
			<name>road_w2_b</name>
			<pose>-16 5 0.01 0 0 0</pose>
		</include>
		<include>
			<uri>model://road_plane</uri>
			<name>road_e1_a</name>
			<pose>16 -5 0.01 0 0 0</pose>
		</include>
		<include>
			<uri>model://road_plane</uri>
			<name>road_e1_b</name>
			<pose>18 -5 0.01 0 0 0</pose>
		</include>
		<include>
			<uri>model://road_plane</uri>
			<name>road_e2_a</name>
			<pose>16 5 0.01 0 0 0</pose>
		</include>
		<include>
			<uri>model://road_plane</uri>
			<name>road_e2_b</name>
			<pose>18 5 0.01 0 0 0</pose>
		</include>

		<actor name="car">
			<pose>0 0 0.75 0 0 0</pose>
			<skin>
				<filename>model://car_color_beacon/meshes/model.dae</filename>
				<scale>1</scale>
			</skin>
			<script>
				<loop>true</loop>
				<delay_start>0.0</delay_start>
				<auto_start>true</auto_start>
				<trajectory id="0" type="circuit">
					<waypoint><time>0.0</time><pose>-13 -8 0 0 0 1.5707</pose></waypoint>
					<waypoint><time>10</time><pose>-4 -8 0 0 0 1.5707</pose></waypoint>
					<waypoint><time>20</time><pose>4 -8 0 0 0 1.5707</pose></waypoint>
					<waypoint><time>30</time><pose>13 -8 0 0 0 1.5707</pose></waypoint>
					<!-- Right side -->
					<waypoint><time>40</time><pose>17 -6 0 0 0 3.14</pose></waypoint>
					<waypoint><time>50</time><pose>17 0 0 0 0 3.14</pose></waypoint>
					<waypoint><time>60</time><pose>17 6 0 0 0 3.14</pose></waypoint>
					<!-- Top side -->
					<waypoint><time>70</time><pose>13 8 0 0 0 4.71</pose></waypoint>
					<waypoint><time>80</time><pose>4 8 0 0 0 4.71</pose></waypoint>
					<waypoint><time>90</time><pose>-4 8 0 0 0 4.71</pose></waypoint>
					<waypoint><time>100</time><pose>-13 8 0 0 0 4.71</pose></waypoint>
					<!-- Left side -->
					<waypoint><time>110</time><pose>-17 6 0 0 0 6.28</pose></waypoint>
					<waypoint><time>120</time><pose>-17 0 0 0 0 6.28</pose></waypoint>
					<waypoint><time>130</time><pose>-17 -6 0 0 0 6.28</pose></waypoint>
					<waypoint><time>140</time><pose>-13 -8 0 0 0 7.85</pose></waypoint>
				</trajectory>
			</script>
		</actor>

		<include>
			<uri>model://pine_tree</uri>
			<name>tree_1</name>
			<pose>-25 -14 0 0 0 0</pose>
			<scale>1.1 1.1 1.1</scale>
		</include>
		<include>
			<uri>model://oak_tree</uri>
			<name>tree_2</name>
			<pose>-25 0 0 0 0 0</pose>
		</include>
		<include>
			<uri>model://pine_tree</uri>
			<name>tree_3</name>
			<pose>-25 14 0 0 0 0</pose>
			<scale>1.15 1.15 1.15</scale>
		</include>
		<include>
			<uri>model://oak_tree</uri>
			<name>tree_4</name>
			<pose>25 -14 0 0 0 0</pose>
			<scale>0.95 0.95 0.95</scale>
		</include>
		<include>
			<uri>model://pine_tree</uri>
			<name>tree_5</name>
			<pose>25 0 0 0 0 0</pose>
		</include>
		<include>
			<uri>model://oak_tree</uri>
			<name>tree_6</name>
			<pose>25 14 0 0 0 0</pose>
			<scale>1.1 1.1 1.1</scale>
		</include>
		<include>
			<uri>model://oak_tree</uri>
			<name>tree_7</name>
			<pose>-9 17 0 0 0 0</pose>
		</include>
		<include>
			<uri>model://pine_tree</uri>
			<name>tree_8</name>
			<pose>9 17 0 0 0 0</pose>
			<scale>1.2 1.2 1.2</scale>
		</include>
		<include>
			<uri>model://oak_tree</uri>
			<name>tree_9</name>
			<pose>0 17 0 0 0 0</pose>
			<scale>0.9 0.9 0.9</scale>
		</include>
		<include>
			<uri>model://falling_rock</uri>
			<name>rock_1</name>
			<pose>-25 -6 0 0 0 0.3</pose>
			<static>true</static>
		</include>
		<include>
			<uri>model://falling_rock</uri>
			<name>rock_2</name>
			<pose>25 6 0 0 0 1.4</pose>
			<static>true</static>
			<scale>0.9 0.9 0.9</scale>
		</include>

		<include>
			<uri>model://logoJdeRobot</uri>
			<name>corner_logo</name>
			<pose>-25 -20 0.01 0 0 0.78</pose>
		</include>

	</world>
</sdf>