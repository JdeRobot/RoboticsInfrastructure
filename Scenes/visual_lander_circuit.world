<?xml version="1.0"?>
<sdf version="1.8">
	<world name="default">
		<physics name="4ms" type="ignored">
			<max_step_size>0.004</max_step_size>
			<real_time_factor>1.0</real_time_factor>
		</physics>
		<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
		</plugin>
		<plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
		</plugin>
		<plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
		</plugin>
		<plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
			<render_engine>ogre2</render_engine>
		</plugin>

		<scene>
			<grid>false</grid>
		</scene>

		<!--light-->
		<light type="directional" name="sun">
			<cast_shadows>true</cast_shadows>
			<pose>0 0 10 0 0 0</pose>
			<diffuse>0.8 0.8 0.8 1</diffuse>
			<specular>0.2 0.2 0.2 1</specular>
			<attenuation>
				<range>1000</range>
				<constant>0.9</constant>
				<linear>0.01</linear>
				<quadratic>0.001</quadratic>
			</attenuation>
			<direction>-0.5 0.1 -0.9</direction>
		</light>

		<include>
			<uri>model://grass_plane</uri>
		</include>

		<include>
			<uri>model://logoPadGreen</uri>
			<name>start_pad</name>
			<pose>0 -20 0.05 0 0 0</pose>
		</include>

		<!-- Octagon road loop, 4 cardinal edges plus 4 diagonal corners. road_plane runs along local Y, so each tile is yawed to match its edge direction. -->
		<include><uri>model://road_plane</uri><name>road_s_a</name><pose>0 -16 0 0 0 1.5708</pose></include>
		<include><uri>model://road_plane</uri><name>road_s_b</name><pose>0 -14 0 0 0 1.5708</pose></include>
		<include><uri>model://road_plane</uri><name>road_n_a</name><pose>0 14 0 0 0 1.5708</pose></include>
		<include><uri>model://road_plane</uri><name>road_n_b</name><pose>0 16 0 0 0 1.5708</pose></include>
		<include><uri>model://road_plane</uri><name>road_e_a</name><pose>14 0 0 0 0 0</pose></include>
		<include><uri>model://road_plane</uri><name>road_e_b</name><pose>16 0 0 0 0 0</pose></include>
		<include><uri>model://road_plane</uri><name>road_w_a</name><pose>-16 0 0 0 0 0</pose></include>
		<include><uri>model://road_plane</uri><name>road_w_b</name><pose>-14 0 0 0 0 0</pose></include>
		<include><uri>model://road_plane</uri><name>road_se_a</name><pose>9.79 -9.79 0 0 0 -0.7854</pose></include>
		<include><uri>model://road_plane</uri><name>road_se_b</name><pose>11.21 -11.21 0 0 0 -0.7854</pose></include>
		<include><uri>model://road_plane</uri><name>road_ne_a</name><pose>9.79 9.79 0 0 0 0.7854</pose></include>
		<include><uri>model://road_plane</uri><name>road_ne_b</name><pose>11.21 11.21 0 0 0 0.7854</pose></include>
		<include><uri>model://road_plane</uri><name>road_nw_a</name><pose>-9.79 9.79 0 0 0 -0.7854</pose></include>
		<include><uri>model://road_plane</uri><name>road_nw_b</name><pose>-11.21 11.21 0 0 0 -0.7854</pose></include>
		<include><uri>model://road_plane</uri><name>road_sw_a</name><pose>-9.79 -9.79 0 0 0 0.7854</pose></include>
		<include><uri>model://road_plane</uri><name>road_sw_b</name><pose>-11.21 -11.21 0 0 0 0.7854</pose></include>

		<include>
			<uri>model://car_color_beacon</uri>
			<name>car</name>
			<pose>-6 -15 0.02 0 0 0</pose>
		</include>

		<include>
			<uri>model://pine_tree</uri>
			<name>tree_1</name>
			<pose>-25 -14 0 0 0 0</pose>
			<scale>1.1 1.1 1.1</scale>
		</include>
		<include>
			<uri>model://oak_tree</uri>
			<name>tree_2</name>
			<pose>-25 0 0 0 0 0</pose>
		</include>
		<include>
			<uri>model://pine_tree</uri>
			<name>tree_3</name>
			<pose>-25 14 0 0 0 0</pose>
			<scale>1.15 1.15 1.15</scale>
		</include>
		<include>
			<uri>model://oak_tree</uri>
			<name>tree_4</name>
			<pose>25 -14 0 0 0 0</pose>
			<scale>0.95 0.95 0.95</scale>
		</include>
		<include>
			<uri>model://pine_tree</uri>
			<name>tree_5</name>
			<pose>25 0 0 0 0 0</pose>
		</include>
		<include>
			<uri>model://oak_tree</uri>
			<name>tree_6</name>
			<pose>25 14 0 0 0 0</pose>
			<scale>1.1 1.1 1.1</scale>
		</include>
		<include>
			<uri>model://oak_tree</uri>
			<name>tree_7</name>
			<pose>-9 20 0 0 0 0</pose>
		</include>
		<include>
			<uri>model://pine_tree</uri>
			<name>tree_8</name>
			<pose>9 20 0 0 0 0</pose>
			<scale>1.2 1.2 1.2</scale>
		</include>
		<include>
			<uri>model://oak_tree</uri>
			<name>tree_9</name>
			<pose>0 20 0 0 0 0</pose>
			<scale>0.9 0.9 0.9</scale>
		</include>
		<include>
			<uri>model://falling_rock</uri>
			<name>rock_1</name>
			<pose>-25 -6 0 0 0 0.3</pose>
			<static>true</static>
		</include>
		<include>
			<uri>model://falling_rock</uri>
			<name>rock_2</name>
			<pose>25 6 0 0 0 1.4</pose>
			<static>true</static>
			<scale>0.9 0.9 0.9</scale>
		</include>

		<include>
			<uri>model://logoJdeRobot</uri>
			<name>corner_logo</name>
			<pose>-25 -22 0.01 0 0 0.78</pose>
		</include>

	</world>
</sdf>
