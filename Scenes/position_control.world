<?xml version="1.0"?>
<sdf version="1.8">
	<world name="default">
		<physics name="4ms" type="ignored">
			<max_step_size>0.004</max_step_size>
			<real_time_factor>1.0</real_time_factor>
		</physics>
		<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
		</plugin>
		<plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
		</plugin>
		<plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
		</plugin>
		<plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
			<render_engine>ogre2</render_engine>
		</plugin>

		<scene>
			<grid>false</grid>
		</scene>

		<!--light-->
		<light type="directional" name="sun">
			<cast_shadows>true</cast_shadows>
			<pose>0 0 10 0 0 0</pose>
			<diffuse>0.8 0.8 0.8 1</diffuse>
			<specular>0.2 0.2 0.2 1</specular>
			<attenuation>
				<range>1000</range>
				<constant>0.9</constant>
				<linear>0.01</linear>
				<quadratic>0.001</quadratic>
			</attenuation>
			<direction>-0.5 0.1 -0.9</direction>
		</light>

		<include>
			<uri>model://grass_plane</uri>
		</include>

		<!-- ================= BEACON TRAIL =================
		     5 beacons, ground truth poses hardcoded in HAL.py (init_beacons),
		     must match the visual markers below exactly. Flat->vertical
		     progression: beacon1 sits on the shortest post (introductory,
		     barely off the ground), each following beacon sits on a taller
		     one, ending in a tall lookout post off the cardinal axis
		     (beacon5). All 5 use the same numbered-cube marker family
		     (number1..number5, one per beacon, in order) instead of mixing
		     in the unrelated green/red logoBeacon flag texture. -->

		<include>
			<uri>model://logoPadGreen</uri>
			<name>takeoff_pad</name>
			<pose>0 0 0.05 0 0 0</pose>
		</include>

		<model name="beacon1_post">
			<static>true</static>
			<link name="link">
				<collision name="collision">
					<geometry>
						<cylinder>
							<radius>0.12</radius>
							<length>0.5</length>
						</cylinder>
					</geometry>
				</collision>
				<visual name="visual">
					<cast_shadows>false</cast_shadows>
					<geometry>
						<cylinder>
							<radius>0.12</radius>
							<length>0.5</length>
						</cylinder>
					</geometry>
					<material>
						<ambient>0.35 0.22 0.1 1</ambient>
						<diffuse>0.35 0.22 0.1 1</diffuse>
					</material>
				</visual>
			</link>
			<pose>0.0 18.0 0.25 0 0 0</pose>
		</model>
		<!-- Marker is visual-only (model://numberN has no <collision>),
		     placed exactly at its final world height: an <include>'s <pose>
		     is the absolute world pose, it does NOT add to the pose baked
		     into the model's own model.sdf. An ELEVATED plane-collision
		     marker would behave as an infinite floor at that height across
		     the whole world, confirmed experimentally, hence numberN and
		     not logoBeacon for anything off the ground. -->
		<include>
			<uri>model://number1</uri>
			<name>beacon1_marker</name>
			<pose>0.0 18.0 0.5 0 0 0</pose>
		</include>

		<model name="beacon2_post">
			<static>true</static>
			<link name="link">
				<collision name="collision">
					<geometry>
						<cylinder>
							<radius>0.15</radius>
							<length>2.0</length>
						</cylinder>
					</geometry>
				</collision>
				<visual name="visual">
					<cast_shadows>false</cast_shadows>
					<geometry>
						<cylinder>
							<radius>0.15</radius>
							<length>2.0</length>
						</cylinder>
					</geometry>
					<material>
						<ambient>0.35 0.22 0.1 1</ambient>
						<diffuse>0.35 0.22 0.1 1</diffuse>
					</material>
				</visual>
			</link>
			<pose>18.0 0.0 1.0 0 0 0</pose>
		</model>
		<!-- Marker is visual-only (model://numberN has no <collision>),
		     placed exactly at its final world height: an <include>'s <pose>
		     is the absolute world pose, it does NOT add to the pose baked
		     into the model's own model.sdf. An ELEVATED plane-collision
		     marker would behave as an infinite floor at that height across
		     the whole world, confirmed experimentally, hence numberN and
		     not logoBeacon for anything off the ground. -->
		<include>
			<uri>model://number2</uri>
			<name>beacon2_marker</name>
			<pose>18.0 0.0 2.0 0 0 0</pose>
		</include>

		<model name="beacon3_post">
			<static>true</static>
			<link name="link">
				<collision name="collision">
					<geometry>
						<cylinder>
							<radius>0.18</radius>
							<length>3.5</length>
						</cylinder>
					</geometry>
				</collision>
				<visual name="visual">
					<cast_shadows>false</cast_shadows>
					<geometry>
						<cylinder>
							<radius>0.18</radius>
							<length>3.5</length>
						</cylinder>
					</geometry>
					<material>
						<ambient>0.35 0.22 0.1 1</ambient>
						<diffuse>0.35 0.22 0.1 1</diffuse>
					</material>
				</visual>
			</link>
			<pose>0.0 -18.0 1.75 0 0 0</pose>
		</model>
		<!-- Marker is visual-only (model://numberN has no <collision>),
		     placed exactly at its final world height: an <include>'s <pose>
		     is the absolute world pose, it does NOT add to the pose baked
		     into the model's own model.sdf. An ELEVATED plane-collision
		     marker would behave as an infinite floor at that height across
		     the whole world, confirmed experimentally, hence numberN and
		     not logoBeacon for anything off the ground. -->
		<include>
			<uri>model://number3</uri>
			<name>beacon3_marker</name>
			<pose>0.0 -18.0 3.5 0 0 0</pose>
		</include>

		<model name="beacon4_post">
			<static>true</static>
			<link name="link">
				<collision name="collision">
					<geometry>
						<cylinder>
							<radius>0.2</radius>
							<length>5.0</length>
						</cylinder>
					</geometry>
				</collision>
				<visual name="visual">
					<cast_shadows>false</cast_shadows>
					<geometry>
						<cylinder>
							<radius>0.2</radius>
							<length>5.0</length>
						</cylinder>
					</geometry>
					<material>
						<ambient>0.35 0.22 0.1 1</ambient>
						<diffuse>0.35 0.22 0.1 1</diffuse>
					</material>
				</visual>
			</link>
			<pose>-18.0 0.0 2.5 0 0 0</pose>
		</model>
		<!-- Marker is visual-only (model://numberN has no <collision>),
		     placed exactly at its final world height: an <include>'s <pose>
		     is the absolute world pose, it does NOT add to the pose baked
		     into the model's own model.sdf. An ELEVATED plane-collision
		     marker would behave as an infinite floor at that height across
