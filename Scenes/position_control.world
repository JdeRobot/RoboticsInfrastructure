		<!-- ================= FOREST =================
		     Perimeter ring at a much larger radius than the beacon trail
		     itself so the whole layout reads as a small clearing IN a big
		     forest, not a tiny cluster floating in an empty field. Radius
		     and angle are jittered per tree (not a perfect circle), and any
		     tree that would land inside one of the 5 flight corridors is
		     skipped. Vendored locally (CustomRobots/drone_assets/models/
		     pine_tree, oak_tree), cast_shadows disabled on every submesh to
		     keep RTF cheap with this many of them. -->

		<include>
			<uri>model://pine_tree</uri>
			<name>tree_ring_0</name>
			<pose>32.13 7.90 0 0 0 3.191</pose>
