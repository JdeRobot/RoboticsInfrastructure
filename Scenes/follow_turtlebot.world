<?xml version="1.0"?>
<sdf version="1.8">
	<world name="default">
		<physics name="4ms" type="ignored">
			<max_step_size>0.004</max_step_size>
			<real_time_factor>1.0</real_time_factor>
		</physics>
		<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
		</plugin>
		<plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
		</plugin>
		<plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
		</plugin>
		<plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
			<render_engine>ogre2</render_engine>
		</plugin>

		<scene>
			<grid>false</grid>
		</scene>

		<!--light-->
		<light type="directional" name="sun">
			<cast_shadows>true</cast_shadows>
			<pose>0 0 10 0 0 0</pose>
			<diffuse>0.8 0.8 0.8 1</diffuse>
			<specular>0.2 0.2 0.2 1</specular>
			<attenuation>
				<range>1000</range>
				<constant>0.9</constant>
				<linear>0.01</linear>
				<quadratic>0.001</quadratic>
			</attenuation>
			<direction>-0.5 0.1 -0.9</direction>
		</light>

		<include>
			<uri>model://asphalt_plane</uri>
			<pose>0 0 -0.02 0 0 0</pose>
		</include>

		<include>
			<uri>model://logoJdeRobot</uri>
			<pose>-7 7 0 0 0 -2.35</pose>
		</include>

		<!-- Patrol waypoints, matches the order the turtlebot driver visits them -->
		<include>
			<uri>model://numbered_pad_1</uri>
			<name>waypoint_1</name>
			<pose>4 2.5 0.05 0 0 0</pose>
		</include>
		<include>
			<uri>model://numbered_pad_2</uri>
			<name>waypoint_2</name>
			<pose>4 -2.5 0.05 0 0 0</pose>
		</include>
		<include>
			<uri>model://numbered_pad_3</uri>
			<name>waypoint_3</name>
			<pose>-4 -2.5 0.05 0 0 0</pose>
		</include>
		<include>
			<uri>model://numbered_pad_4</uri>
			<name>waypoint_4</name>
			<pose>-4 2.5 0.05 0 0 0</pose>
		</include>

		<!-- Drone takeoff pad, centered over the patrol rectangle -->
		<include>
			<uri>model://logoPadGreen</uri>
			<pose>0 0 0.05 0 0 0</pose>
		</include>

	</world>
</sdf>
