    <!-- Yellow Box 2 -->
    <model name="yellow_box_2">
      <pose>0.42 0.22 0.786 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>0.0000041667</ixx>            <!-- 1/6 * m * a^2 -->
