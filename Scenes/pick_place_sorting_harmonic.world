    <!-- Green Cylinder 1 -->
    <model name="green_cylinder_1">
      <pose>0.62 -0.22 0.801 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>0.0000068958</ixx>            <!-- 1/12 * m * (3*r^2 + h^2) -->
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.0000068958</iyy>
            <iyz>0</iyz>
            <izz>0.0000031250</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.08</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.025</radius>
              <length>0.08</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
