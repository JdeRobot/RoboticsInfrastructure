<?xml version="1.0"?>
<sdf version="1.8">
	<world name="default">
		<physics name="4ms" type="ignored">
			<max_step_size>0.004</max_step_size>
			<real_time_factor>1.0</real_time_factor>
		</physics>
		<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
		</plugin>
		<plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
		</plugin>
		<plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
		</plugin>
		<plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
			<render_engine>ogre2</render_engine>
		</plugin>

		<scene>
			<grid>false</grid>
		</scene>

		<!--light-->
		<light type="directional" name="sun">
			<cast_shadows>true</cast_shadows>
			<pose>0 0 10 0 0 0</pose>
			<diffuse>0.8 0.8 0.8 1</diffuse>
			<specular>0.2 0.2 0.2 1</specular>
			<attenuation>
				<range>1000</range>
				<constant>0.9</constant>
				<linear>0.01</linear>
				<quadratic>0.001</quadratic>
			</attenuation>
			<direction>-0.5 0.1 -0.9</direction>
		</light>

		<!-- Hangar building (mesh, scaled x1.3 wide / x3 long / x1.8 tall) + concrete floor + funnel entrance.
		     Pose shifted to Y=12 vs. the original (-2) to compensate for the Y-stretch,
		     so the entrance funnel stays aligned with the obstacle course below. -->
		<include>
			<uri>model://hangar</uri>
			<pose>0 12 0 0 0 0</pose>
		</include>

		<!-- Start pad: marks the drone's spawn point (y=44, see database/worlds.sql) -->
		<include>
			<uri>model://logoPadGreen</uri>
			<name>start_pad</name>
			<pose>0 44 0.05 0 0 0</pose>
		</include>

		<!-- Progressive obstacle course, drone spawns at y=44 flying toward the exit at y~-9.
		     Difficulty ramps up as y decreases: same spacing (10m) between every gate, speed
		     and amplitude increase gate to gate. All speeds are deliberately gentle - this is
		     a programming challenge (vision + timing from code), not RC piloting.
		     Each gate is the same reusable geometry (moving_panel=red/horizontal,
		     moving_shutter=blue/vertical, rotating_blades=yellow, cheese_wall=green/static)
		     with its own hangar_obstacles::ObstacleMover plugin params
		     (mode/axis/amplitude/period) - adding more gates is just copy-pasting one of
		     these blocks with new numbers/position. -->

		<!-- Gate 1 (y=36, warm-up): static wall with 3 staggered holes, no timing needed -->
		<include>
			<uri>model://cheese_wall</uri>
			<name>cheese_1</name>
			<pose>0 36 0 0 0 0</pose>
		</include>

		<!-- Gate 2 (y=26, easy): door slides left-right, slow and small swing -->
		<include>
			<uri>model://moving_panel</uri>
			<name>panel_lr_1</name>
			<pose>0 26 4 0 0 0</pose>
			<plugin filename="libhangar_obstacle_mover.so" name="hangar_obstacles::ObstacleMover">
				<mode>oscillate</mode>
				<axis>1 0 0</axis>
				<amplitude>1.3</amplitude>
				<period>9.0</period>
			</plugin>
		</include>

		<!-- Gate 3 (y=16, easy-medium): very slow spinning blades, plenty of reaction time -->
		<include>
			<uri>model://rotating_blades</uri>
			<name>blades_1</name>
			<pose>0 16 5.4 0 0 0</pose>
			<plugin filename="libhangar_obstacle_mover.so" name="hangar_obstacles::ObstacleMover">
				<mode>rotate</mode>
				<axis>0 1 0</axis>
				<period>10.0</period>
			</plugin>
		</include>

		<!-- Gate 4 (y=6, medium): shutter sweeps floor-to-ceiling, alternating which side is open -->
		<include>
			<uri>model://moving_shutter</uri>
			<name>shutter_1</name>
			<pose>0 6 5.4 0 0 0</pose>
			<plugin filename="libhangar_obstacle_mover.so" name="hangar_obstacles::ObstacleMover">
				<mode>oscillate</mode>
				<axis>0 0 1</axis>
				<amplitude>2.0</amplitude>
				<period>6.5</period>
			</plugin>
		</include>

		<!-- Gate 5 (y=-4, hardest/final): door slides left-right, wide swing that closes
		     almost edge-to-edge, but still the slowest-moving of the two red doors -->
		<include>
			<uri>model://moving_panel</uri>
			<name>panel_lr_2</name>
			<pose>0 -4 4 0 0 0</pose>
			<plugin filename="libhangar_obstacle_mover.so" name="hangar_obstacles::ObstacleMover">
				<mode>oscillate</mode>
				<axis>1 0 0</axis>
				<amplitude>5.5</amplitude>
				<period>6.0</period>
			</plugin>
		</include>

		<!-- Finish pad: black/white checkerboard, just past the hangar exit funnel (~y=-9) -->
		<include>
			<uri>model://checkered_pad</uri>
			<name>finish_pad</name>
			<pose>0 -11 0.05 0 0 0</pose>
		</include>

	</world>
</sdf>
