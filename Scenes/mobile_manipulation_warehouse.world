        </visual>
      </link>
    </model>

    <model name="blue_box">
      <pose>4.8 0 1.035 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>3.08e-05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>8.04e-05</iyy><iyz>0</iyz><izz>7.04e-05</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.12 0.05 0.07</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.12 0.05 0.07</size></box>
          </geometry>
          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="yellow_ball">
      <pose>4.8 -0.35 1.04 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>3.20e-05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>3.20e-05</iyy><iyz>0</iyz><izz>3.20e-05</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <sphere><radius>0.04</radius></sphere>
          </geometry>
        </collision>
        <visual name="visual">
