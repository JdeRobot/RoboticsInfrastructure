              <size>0.25 0.012 0.03</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <model name="blue_tray">
      <static>true</static>
      <pose>0 -4.8 1 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>0.5 0.5 0.5</scale>
              <uri>model://blue_tray/meshes/blue_tray.dae</uri>
