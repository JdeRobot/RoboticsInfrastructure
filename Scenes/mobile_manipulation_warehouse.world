          </material>
        </visual>
      </link>
    </model>

    <model name="green_cylinder">
      <pose>4.8 0.35 1.05 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>6.17e-05</ixx><ixy>0</ixy><ixz>0</ixz><iyy>6.17e-05</iyy><iyz>0</iyz><izz>4.00e-05</izz>
          </inertia>
        </inertial>
        <collision name="collision">
