<?xml version="1.0"?>

<sdf version="1.8">
  <world name="default">
    <!-- Copied from small_house.world, which never declared this either, so
         gz-sim fell back to some internal default gz_ros2_control could not
         read properly ("Desired controller update period is slower than the
         gazebo simulation period (0 s)"), and controller_manager's own
         update loop ran badly enough that basic services like
         list_controllers/switch_controller started timing out for minutes
         on startup with this heavier scene+robot. Same max_step_size as
         machine_vision.world, the other gz_ros2_control-driven arm exercise -->
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system">
    </plugin>

    <!-- one instance per gripper, both listen to the same /gripper_auto_attach
         and /graspable_objects topics, whichever jaw actually touches an
         object first is the one that grabs it -->
    <plugin filename="libgz_link_attacher.so" name="gz_link_attacher::LinkAttacher">
      <robot_model_name>xlerobot</robot_model_name>
      <gripper_link_name>Moving_Jaw</gripper_link_name>
    </plugin>
    <plugin filename="libgz_link_attacher.so" name="gz_link_attacher::LinkAttacher">
      <robot_model_name>xlerobot</robot_model_name>
      <gripper_link_name>Moving_Jaw_2</gripper_link_name>
    </plugin>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <include>
      <name>house_int2_no_chairs_harmonic</name>
      <uri>model://house_int2_no_chairs</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <light type="directional" name="sun">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <visualize>false</visualize>
    </light>

    <!-- Graspable objects on the dining table (mesa_comedor, at -2.4 0.3 0).
         Table top is at z=0.74, read straight out of the "Mesa" node's
         transform in mesa_comedor/meshes/model.dae (scale 0.015, translate
         0.725, on a -1..1 unit cube -> surface at 0.725 + 0.015 = 0.74),
         boxes are 0.05 tall so their center goes at 0.74 + 0.025 = 0.765,
         nudged up a hair more to 0.77 to avoid starting embedded -->

    <model name="red_box">
      <!-- nudged 0.15m toward the near edge (the side the robot approaches
           from, larger x) so the robot does not need to get the chassis
           right up against the table to reach it -->
      <pose>-2.15 0.25 0.77 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.0000104</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.0000084</iyy>
            <iyz>0</iyz>
            <izz>0.0000041</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="yellow_box">
      <pose>-2.25 0.35 0.77 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.0000096</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.0000136</iyy>
            <iyz>0</iyz>
            <izz>0.0000066</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 0 1</ambient>
            <diffuse>1 1 0 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="blue_box">
      <pose>-2.35 0.2 0.77 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.0000104</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.0000084</iyy>
            <iyz>0</iyz>
            <izz>0.0000041</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
