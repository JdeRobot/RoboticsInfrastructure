<?xml version="1.0"?>
<!-- drone cat-mouse chase world for the jderobot robotics academy
     maintainer: Anish Kumar (anishkumar59085@gmail.com) -->
<sdf version="1.9">
  <world name="default">

    <!-- system plugins that gz needs to run the sim -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- physics — 1ms step is fine for multirotor, dont go higher or drones get wobbly -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.3 -1.0</direction>
    </light>

    <scene>
      <ambient>0.6 0.6 0.7 1</ambient>
      <background>0.5 0.7 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ground plane — offset by -0.05 to avoid z-fighting with the city mesh -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.12 0.42 0.08 1</ambient>
            <diffuse>0.12 0.42 0.08 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- city model exported from blender (7MB glb) -->
    <include>
      <uri>model://my_city_v3</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

  </world>
</sdf>
