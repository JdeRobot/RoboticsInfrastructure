<?xml version="1.0"?>
<sdf version="1.8">
	<world name="default">
		<physics name="4ms" type="ignored">
			<max_step_size>0.004</max_step_size>
			<real_time_factor>1.0</real_time_factor>
		</physics>
		<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
		</plugin>
		<plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
		</plugin>
		<plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
		</plugin>
		<plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
			<render_engine>ogre2</render_engine>
		</plugin>

		<scene>
			<grid>false</grid>
		</scene>

		<!--light-->
		<light type="directional" name="sun">
			<cast_shadows>true</cast_shadows>
			<pose>0 0 10 0 0 0</pose>
			<diffuse>0.8 0.8 0.8 1</diffuse>
			<specular>0.2 0.2 0.2 1</specular>
			<attenuation>
				<range>1000</range>
				<constant>0.9</constant>
				<linear>0.01</linear>
				<quadratic>0.001</quadratic>
			</attenuation>
			<direction>-0.5 0.1 -0.9</direction>
		</light>

		<include>
			<uri>model://grass_plane</uri>
		</include>

		<!-- Start pad: marks the drone's spawn point (0,-8, see database/worlds.sql) -->
		<include>
			<uri>model://logoPadGreen</uri>
			<name>start_pad</name>
			<pose>0 -8 0.05 0 0 0</pose>
		</include>

		<!-- Decorative corner logo, homage to the original visual_lander teaser. -->
		<include>
			<uri>model://logoJdeRobot</uri>
			<name>corner_logo</name>
			<pose>-14 -14 0.01 0 0 0.78</pose>
		</include>

		<!-- Landing target: a car with a color beacon on its roof, shuttling back and
		     forth along the X axis (see resources/exercises/visual_lander/car.py, which
		     drives it once the student's code starts running, same as the drone_cat_mouse
		     mouse). Starts at the centre of its X∈[-12,12] shuttle line. -->
		<include>
			<uri>model://car_color_beacon</uri>
			<name>car</name>
			<pose>0 0 0 0 0 0</pose>
		</include>

		<!-- Trees/rocks flanking the shuttle avenue, kept out of the flight
		     corridor above it and away from the start pad. Same vendored,
		     shadow-free assets as position_control (no fresh decoration
		     assets needed here). -->
		<include>
			<uri>model://pine_tree</uri>
			<name>tree_1</name>
			<pose>-11 6.5 0 0 0 0</pose>
			<scale>1.1 1.1 1.1</scale>
		</include>
		<include>
			<uri>model://oak_tree</uri>
			<name>tree_2</name>
			<pose>-6 7.2 0 0 0 0</pose>
		</include>
		<include>
			<uri>model://pine_tree</uri>
			<name>tree_3</name>
			<pose>-1 6.4 0 0 0 0</pose>
			<scale>1.15 1.15 1.15</scale>
		</include>
		<include>
			<uri>model://oak_tree</uri>
			<name>tree_4</name>
			<pose>4 7.5 0 0 0 0</pose>
			<scale>0.95 0.95 0.95</scale>
		</include>
		<include>
			<uri>model://pine_tree</uri>
			<name>tree_5</name>
			<pose>9 6.8 0 0 0 0</pose>
		</include>
		<include>
			<uri>model://oak_tree</uri>
			<name>tree_6</name>
			<pose>13 7.8 0 0 0 0</pose>
			<scale>1.1 1.1 1.1</scale>
		</include>
		<include>
			<uri>model://oak_tree</uri>
			<name>tree_7</name>
			<pose>-12 -6.5 0 0 0 0</pose>
		</include>
		<include>
			<uri>model://pine_tree</uri>
			<name>tree_8</name>
			<pose>-7 -7.3 0 0 0 0</pose>
			<scale>1.2 1.2 1.2</scale>
		</include>
		<include>
			<uri>model://oak_tree</uri>
			<name>tree_9</name>
			<pose>6 -7.0 0 0 0 0</pose>
			<scale>0.9 0.9 0.9</scale>
		</include>
		<include>
			<uri>model://pine_tree</uri>
			<name>tree_10</name>
			<pose>10 -6.6 0 0 0 0</pose>
		</include>
		<include>
			<uri>model://oak_tree</uri>
			<name>tree_11</name>
			<pose>13 -7.5 0 0 0 0</pose>
			<scale>1.05 1.05 1.05</scale>
		</include>
		<include>
			<uri>model://pine_tree</uri>
			<name>tree_12</name>
			<pose>14 14 0 0 0 0</pose>
			<scale>1.2 1.2 1.2</scale>
		</include>
		<include>
			<uri>model://oak_tree</uri>
			<name>tree_13</name>
			<pose>17 12 0 0 0 0</pose>
		</include>
		<include>
			<uri>model://falling_rock</uri>
			<name>rock_1</name>
			<pose>-16 3 0 0 0 0.3</pose>
			<static>true</static>
		</include>
		<include>
			<uri>model://falling_rock</uri>
			<name>rock_2</name>
			<pose>16 -3 0 0 0 1.4</pose>
			<static>true</static>
			<scale>0.9 0.9 0.9</scale>
		</include>
		<include>
			<uri>model://falling_rock</uri>
			<name>rock_3</name>
			<pose>-8 12 0 0 0 2.1</pose>
			<static>true</static>
			<scale>1.1 1.1 1.1</scale>
		</include>
		<include>
			<uri>model://falling_rock</uri>
			<name>rock_4</name>
			<pose>7 -12 0 0 0 0.7</pose>
			<static>true</static>
		</include>

	</world>
</sdf>
