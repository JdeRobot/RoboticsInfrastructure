<?xml version="1.0"?>
<sdf version="1.8">
	<world name="default">
		<physics name="4ms" type="ignored">
			<max_step_size>0.004</max_step_size>
			<real_time_factor>1.0</real_time_factor>
		</physics>
		<plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
		</plugin>
		<plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
		</plugin>
		<plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
		</plugin>
		<plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
			<render_engine>ogre2</render_engine>
		</plugin>

		<scene>
			<grid>false</grid>
		</scene>

		<!--light-->
		<light type="directional" name="sun">
			<cast_shadows>true</cast_shadows>
			<pose>0 0 10 0 0 0</pose>
			<diffuse>0.8 0.8 0.8 1</diffuse>
			<specular>0.2 0.2 0.2 1</specular>
			<attenuation>
				<range>1000</range>
				<constant>0.9</constant>
				<linear>0.01</linear>
				<quadratic>0.001</quadratic>
			</attenuation>
			<direction>-0.5 0.1 -0.9</direction>
		</light>

		<include>
			<uri>model://grass_plane</uri>
		</include>

		<!-- Start pad: marks the drone's spawn point (0,-8, see database/worlds.sql) -->
		<include>
			<uri>model://logoPadGreen</uri>
			<name>start_pad</name>
			<pose>0 -8 0.05 0 0 0</pose>
		</include>

		<!-- Decorative corner logo, homage to the original visual_lander teaser. -->
		<include>
			<uri>model://logoJdeRobot</uri>
			<name>corner_logo</name>
			<pose>-14 -14 0.01 0 0 0.78</pose>
		</include>

		<!-- Landing target: a car with a color beacon on its roof, shuttling back and
		     forth along the X axis (see resources/exercises/visual_lander/car.py, which
		     drives it once the student's code starts running, same as the drone_cat_mouse
		     mouse). Starts at the centre of its X∈[-12,12] shuttle line. -->
		<include>
			<uri>model://car_color_beacon</uri>
			<name>car</name>
			<pose>0 0 0 0 0 0</pose>
		</include>

	</world>
</sdf>
