<?xml version="1.0"?>
<sdf version="1.6">
    <world name="default">
        <physics name="2ms" type="ignored">
            <max_step_size>0.002</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>
        <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
        </plugin>
        <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
        </plugin>
        <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
        </plugin>

        <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
        </plugin>

        <scene>
            <grid>false</grid>
        </scene>

        <light type="directional" name="sun">
            <cast_shadows>false</cast_shadows>
            <pose>0 0 18 0 0 0</pose>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>80</range>
                <constant>0.01</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <cast_shadows>1</cast_shadows>
            <direction>0.1 0.1 -1</direction>
        </light>

        <model name="ground_plane">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                        </plane>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                    <material>
                        <ambient>0.8 0.8 0.8 1</ambient>
                        <diffuse>0.8 0.8 0.8 1</diffuse>
                        <specular>0.8 0.8 0.8 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <include>
            <name>aws_robomaker_warehouse_GroundB_01_001</name>
            <uri>model://aws_robomaker_warehouse_GroundB_01</uri>
            <pose>0.0 0.0 -0.124 0 0 0</pose>
        </include>

        <include>
            <name>aws_robomaker_warehouse_ShelfF_01_001</name>
            <uri>model://aws_robomaker_warehouse_ShelfF_01</uri>
            <pose>-5.795143 -0.956635 0 0 0 0</pose>
        </include>

        <include>
            <name>aws_robomaker_warehouse_WallB_01_001</name>
            <uri>model://aws_robomaker_warehouse_WallB_01</uri>
            <pose>0.0 0.0 0 0 0 0</pose>
        </include>

        <include>
            <name>aws_robomaker_warehouse_Bucket_01_020</name>
            <uri>model://aws_robomaker_warehouse_Bucket_01</uri>
            <pose>0.433449 9.631706 0 0 0 -1.563161</pose>
        </include>

        <include>
            <name>aws_robomaker_warehouse_Bucket_01_021</name>
            <uri>model://aws_robomaker_warehouse_Bucket_01</uri>
            <pose>-1.8321 -6.3752 0 0 0 -1.563161</pose>
        </include>

        <include>
            <name>aws_robomaker_warehouse_Bucket_01_022</name>
            <uri>model://aws_robomaker_warehouse_Bucket_01</uri>
            <pose>0.433449 8.59 0 0 0 -1.563161</pose>
        </include>


        <include>
            <name>aws_robomaker_warehouse_ClutteringA_01_016</name>
            <uri>model://aws_robomaker_warehouse_ClutteringA_01</uri>
            <pose>5.708138 8.616844 -0.017477 0 0 0</pose>
        </include>

        <include>
            <name>aws_robomaker_warehouse_ClutteringA_01_017</name>
            <uri>model://aws_robomaker_warehouse_ClutteringA_01</uri>
            <pose>3.408638 8.616844 -0.017477 0 0 0</pose>
        </include>

        <include>
            <name>aws_robomaker_warehouse_ClutteringA_01_018</name>
            <uri>model://aws_robomaker_warehouse_ClutteringA_01</uri>
            <pose>-1.491287 5.222435 -0.017477 0 0 -1.583185</pose>
        </include>

        <include>
            <name>aws_robomaker_warehouse_ClutteringC_01_027</name>
            <uri>model://aws_robomaker_warehouse_ClutteringC_01</uri>
            <pose>3.324959 3.822449 -0.012064 0 0 1.563871</pose>
        </include>

        <include>
            <name>aws_robomaker_warehouse_ClutteringC_01_028</name>
            <uri>model://aws_robomaker_warehouse_ClutteringC_01</uri>
            <pose>5.54171 3.816475 -0.015663 0 0 -1.583191</pose>
        </include>

        <include>
            <name>aws_robomaker_warehouse_ClutteringC_01_029</name>
            <uri>model://aws_robomaker_warehouse_ClutteringC_01</uri>
            <pose>5.384239 6.137154 0 0 0 3.150000</pose>
        </include>

        <include>
            <name>aws_robomaker_warehouse_ClutteringC_01_030</name>
            <uri>model://aws_robomaker_warehouse_ClutteringC_01</uri>
            <pose>3.236 6.137154 0 0 0 3.150000</pose>
        </include>

        <include>
            <name>aws_robomaker_warehouse_ClutteringC_01_031</name>
            <uri>model://aws_robomaker_warehouse_ClutteringC_01</uri>
            <pose>-1.573677 2.301994 -0.015663 0 0 -3.133191</pose>
        </include>

        <include>
            <name>aws_robomaker_warehouse_ClutteringC_01_032</name>
            <uri>model://aws_robomaker_warehouse_ClutteringC_01</uri>
            <pose>-1.2196 9.407 -0.015663 0 0 1.563871</pose>
        </include>

        <include>
            <name>aws_robomaker_warehouse_ClutteringD_01_005</name>
            <uri>model://aws_robomaker_warehouse_ClutteringD_01</uri>
            <pose>-1.634682 -7.811813 -0.319559 0 0 0</pose>
        </include>

        <include>
            <name>aws_robomaker_warehouse_TrashCanC_01_002</name>
            <uri>model://aws_robomaker_warehouse_TrashCanC_01</uri>
            <pose>-1.592441 7.715420 0 0 0 0</pose>
        </include>

        <include>
            <name>aws_robomaker_warehouse_PalletJackB_01_001</name>
            <uri>model://aws_robomaker_warehouse_PalletJackB_01</uri>
            <pose>-0.276098 -9.481944 0.023266 0 0 0</pose>
        </include>

        <!-- Red ball-drop pipe: floats above its mat, collar facing DOWN (opening at the
             bottom) so a ball can fall out of it onto the mat below. Collar bottom sits at
             z=0.85, well above the tallest robot+basket (~0.59m), so a MiR100 can drive
             underneath. Sits in the aisle the transporting racks used to occupy. -->
        <model name="red_pipe">
            <static>true</static>
            <pose>3.84 -2.5 0.85 0 0 0</pose>
            <link name="link">
                <visual name="collar">
                    <pose>0 0 0.06 0 0 0</pose>
                    <geometry>
                        <cylinder><radius>0.32</radius><length>0.12</length></cylinder>
                    </geometry>
                    <material>
                        <ambient>0.8 0 0 1</ambient>
                        <diffuse>0.8 0 0 1</diffuse>
                    </material>
                </visual>
                <visual name="body">
                    <pose>0 0 0.62 0 0 0</pose>
                    <geometry>
                        <cylinder><radius>0.25</radius><length>1.0</length></cylinder>
                    </geometry>
                    <material>
                        <ambient>0.8 0 0 1</ambient>
                        <diffuse>0.8 0 0 1</diffuse>
                    </material>
                </visual>
                <collision name="collision">
                    <pose>0 0 0.56 0 0 0</pose>
                    <geometry>
                        <cylinder><radius>0.3</radius><length>1.12</length></cylinder>
                    </geometry>
                </collision>
            </link>
        </model>

        <!-- Red mat, directly under the pipe: park here to catch the ball. -->
        <model name="red_mat">
            <static>true</static>
            <pose>3.84 -2.5 0.001 0 0 0</pose>
            <link name="link">
                <visual name="visual">
                    <geometry>
                        <box><size>1.0 1.0 0.01</size></box>
                    </geometry>
                    <material>
                        <ambient>0.8 0 0 1</ambient>
                        <diffuse>0.8 0 0 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Blue ball-drop pipe + its mat, same shapes/height as the red one. -->
        <model name="blue_pipe">
            <static>true</static>
            <pose>3.84 -6.0 0.85 0 0 0</pose>
            <link name="link">
                <visual name="collar">
                    <pose>0 0 0.06 0 0 0</pose>
                    <geometry>
                        <cylinder><radius>0.32</radius><length>0.12</length></cylinder>
                    </geometry>
                    <material>
                        <ambient>0 0 0.8 1</ambient>
                        <diffuse>0 0 0.8 1</diffuse>
                    </material>
                </visual>
                <visual name="body">
                    <pose>0 0 0.62 0 0 0</pose>
                    <geometry>
                        <cylinder><radius>0.25</radius><length>1.0</length></cylinder>
                    </geometry>
                    <material>
                        <ambient>0 0 0.8 1</ambient>
                        <diffuse>0 0 0.8 1</diffuse>
                    </material>
                </visual>
                <collision name="collision">
                    <pose>0 0 0.56 0 0 0</pose>
                    <geometry>
                        <cylinder><radius>0.3</radius><length>1.12</length></cylinder>
                    </geometry>
                </collision>
            </link>
        </model>

        <model name="blue_mat">
            <static>true</static>
            <pose>3.84 -6.0 0.001 0 0 0</pose>
            <link name="link">
                <visual name="visual">
                    <geometry>
                        <box><size>1.0 1.0 0.01</size></box>
                    </geometry>
                    <material>
                        <ambient>0 0 0.8 1</ambient>
                        <diffuse>0 0 0.8 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Delivery mats: start grey/neutral, scattered around the map. One will be
             switched to the ball's color at runtime (not modeled yet) to mark where a
             robot should drop off the ball it picked up from a pipe. -->
        <model name="delivery_mat_1">
            <static>true</static>
            <pose>1.2 -2.5 0.001 0 0 0</pose>
            <link name="link">
                <visual name="visual">
                    <geometry>
                        <box><size>1.0 1.0 0.01</size></box>
                    </geometry>
                    <material>
                        <ambient>0.5 0.5 0.5 1</ambient>
                        <diffuse>0.5 0.5 0.5 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <model name="delivery_mat_2">
            <static>true</static>
            <pose>1.2 -6.0 0.001 0 0 0</pose>
            <link name="link">
                <visual name="visual">
                    <geometry>
                        <box><size>1.0 1.0 0.01</size></box>
                    </geometry>
                    <material>
                        <ambient>0.5 0.5 0.5 1</ambient>
                        <diffuse>0.5 0.5 0.5 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <model name="delivery_mat_3">
            <static>true</static>
            <pose>-3.0 -4.5 0.001 0 0 0</pose>
            <link name="link">
                <visual name="visual">
                    <geometry>
                        <box><size>1.0 1.0 0.01</size></box>
                    </geometry>
                    <material>
                        <ambient>0.5 0.5 0.5 1</ambient>
                        <diffuse>0.5 0.5 0.5 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <model name="delivery_mat_4">
            <static>true</static>
            <pose>1.5 2.0 0.001 0 0 0</pose>
            <link name="link">
                <visual name="visual">
                    <geometry>
                        <box><size>1.0 1.0 0.01</size></box>
                    </geometry>
                    <material>
                        <ambient>0.5 0.5 0.5 1</ambient>
                        <diffuse>0.5 0.5 0.5 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

    </world>
</sdf>