<?xml version="1.0" ?>
<robot name="my_robot">
  <link name="chassis">
    <origin rpy="0 -0 0" xyz="0 0 0.15"/>
    <inertial>
      <origin rpy="0 -0 0" xyz="0.1 0 0"/>
      <mass value="10"/>
      <inertia ixx="0.216667" ixy="0" ixz="0" iyy="0.841667" iyz="0" izz="1.04167"/>
    </inertial>
    <visual>
      <geometry>
        <box size="1 0.5 0.1"/>
      </geometry>
      <material name="Gazebo/Grey"/>
    </visual>
    <enable_wind>0</enable_wind>
    <kinematic>0</kinematic>
  </link>
  <link name="wheel_front_left">
    <origin rpy="-1.5708 -0.087266 0" xyz="0.5 0.298 0.15"/>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.00307917" ixy="0" ixz="0" iyy="0.00307917" iyz="0" izz="0.005625"/>
      <origin rpy="0 -0 0" xyz="0 0 0"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.08" radius="0.2"/>
      </geometry>
      <material name="Gazebo/Black"/>
    </visual>
    <enable_wind>0</enable_wind>
    <kinematic>0</kinematic>
  </link>
  <joint name="wheel_front_left_steer" type="revolute">
    <parent link="chassis"/>
    <child link="wheel_front_left"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1e+16" upper="1e+16"/>
    <origin xyz="0 0 1"/>
  </joint>
  <link name="wheel_front_right">
    <origin rpy="-1.5708 -0.087266 0" xyz="0.5 -0.298 0.15"/>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.00307917" ixy="0" ixz="0" iyy="0.00307917" iyz="0" izz="0.005625"/>
      <origin rpy="0 -0 0" xyz="0 0 0"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.08" radius="0.2"/>
      </geometry>
      <material name="Gazebo/Black"/>
    </visual>
    <enable_wind>0</enable_wind>
    <kinematic>0</kinematic>
  </link>
  <joint name="wheel_front_right_steer" type="revolute">
    <parent link="chassis"/>
    <child link="wheel_front_right"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1e+16" upper="1e+16"/>
    <origin xyz="0 0 1"/>
  </joint>
  <link name="wheel_rear_left">
    <origin rpy="-1.5708 0 0" xyz="-0.5 0.298 0.15"/>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.00307917" ixy="0" ixz="0" iyy="0.00307917" iyz="0" izz="0.005625"/>
      <origin rpy="0 -0 0" xyz="0 0 0"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.08" radius="0.2"/>
      </geometry>
      <material name="Gazebo/Black"/>
    </visual>
    <enable_wind>0</enable_wind>
    <kinematic>0</kinematic>
  </link>
  <joint name="left_wheel_back" type="revolute">
    <parent link="chassis"/>
    <child link="wheel_rear_left"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1e+16" upper="1e+16"/>
    <origin xyz="0 0 1"/>
  </joint>
  <link name="wheel_rear_right">
    <origin rpy="-1.5708 0 0" xyz="-0.5 -0.298 0.15"/>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.00307917" ixy="0" ixz="0" iyy="0.00307917" iyz="0" izz="0.005625"/>
      <origin rpy="0 -0 0" xyz="0 0 0"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder length="0.08" radius="0.2"/>
      </geometry>
      <material name="Gazebo/Black"/>
    </visual>
    <enable_wind>0</enable_wind>
    <kinematic>0</kinematic>
  </link>
  <joint name="right_wheel_back" type="revolute">
    <parent link="chassis"/>
    <child link="wheel_rear_right"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1e+16" upper="1e+16"/>
    <origin xyz="0 0 1"/>
  </joint>
  <material name="Gazebo/Grey">
    <color rgba=".3 .3 .3 1.0"/>
  </material>
  <material name="Gazebo/Black">
    <color rgba="0 0 0 1"/>
  </material>
</robot>
