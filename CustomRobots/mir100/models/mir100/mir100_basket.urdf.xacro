<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <material name="Red">
    <color rgba="1 0 0 1.0"/>
  </material>

  <material name="Blue">
    <color rgba="0 0 1 1.0"/>
  </material>

  <material name="Green">
    <color rgba="0 0.8 0 1.0"/>
  </material>

  <material name="Yellow">
    <color rgba="1 0.9 0 1.0"/>
  </material>

  <material name="Grey">
    <color rgba="0.35 0.35 0.35 1.0"/>
  </material>

  <!-- Optional cargo basket, off by default (see xacro:arg "basket" in mir100.urdf.xacro).
       Mesh derived from OpenRobotics' "Grey tote" (CC0, fuel.gazebosim.org): the original
       has an attached flip-lid (closed by default), so the lid geometry was cut off and an
       interior floor patch added (the source mesh is single-sided/exterior-only, so a floor
       had to be authored separately, see the "grey_tote_open.glb" derivation), real crate
       footprint 0.678 x 0.413 m, walls 0.24 m tall, genuinely open at the top for a ball to
       drop/rest in later. Mounted flush on the chassis top, biased toward the back (the -x
       side, where the back_laser sits) so it fills most of the rear of the robot without
       overhanging it. The mesh's own material is overridden by "color" so two MiR100 units
       can carry differently colored bins (e.g. one per pipe/ball color). -->
  <xacro:macro name="mir100_basket" params="parent color:=Red">
    <joint name="basket_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="basket_link"/>
      <origin xyz="-0.05 0 0.352" rpy="0 0 0"/>
    </joint>

    <link name="basket_link">
      <inertial>
        <mass value="3.5"/>
        <inertia ixx="0.07" ixy="0" ixz="0" iyy="0.14" iyz="0" izz="0.15"/>
      </inertial>

      <visual>
        <geometry>
          <mesh filename="file://$(find custom_robots)/models/mir100/meshes/visual/grey_tote_open.glb"/>
        </geometry>
        <material name="${color}"/>
      </visual>

      <!-- Floor + 4 walls, open at the top, matching the visual mesh's real interior. -->
      <collision>
        <origin xyz="0 0 0.01" rpy="0 0 0"/>
        <geometry>
          <box size="0.584 0.330 0.02"/>
        </geometry>
      </collision>
      <collision>
        <origin xyz="0.29 0 0.13" rpy="0 0 0"/>
        <geometry>
          <box size="0.026 0.330 0.24"/>
        </geometry>
      </collision>
      <collision>
        <origin xyz="-0.29 0 0.13" rpy="0 0 0"/>
        <geometry>
          <box size="0.026 0.330 0.24"/>
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 0.165 0.13" rpy="0 0 0"/>
        <geometry>
          <box size="0.584 0.026 0.24"/>
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 -0.165 0.13" rpy="0 0 0"/>
        <geometry>
          <box size="0.584 0.026 0.24"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>
</robot>
