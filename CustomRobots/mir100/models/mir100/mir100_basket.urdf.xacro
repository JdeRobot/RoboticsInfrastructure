<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <material name="Red">
    <color rgba="1 0 0 1.0"/>
  </material>

  <material name="Blue">
    <color rgba="0 0 1 1.0"/>
  </material>

  <material name="Green">
    <color rgba="0 0.8 0 1.0"/>
  </material>

  <material name="Yellow">
    <color rgba="1 0.9 0 1.0"/>
  </material>

  <material name="IndustrialGrey">
    <color rgba="0.35 0.35 0.35 1.0"/>
  </material>

  <!-- Optional cargo basket, off by default (see xacro:arg "basket" in mir100.urdf.xacro).
       Simple open-top box crate (floor + 4 walls, no lid): plain primitives, so it renders
       correctly from every angle (no mesh backface-culling issues). Footprint 0.584 x 0.330 m,
       walls 0.24 m tall, mounted flush on the chassis top, biased toward the back (the -x
       side, where the back_laser sits) so it fills most of the rear without overhanging it.
       Floor stays industrial grey; walls take "color" so two MiR100 units can carry
       differently colored bins (e.g. one per pipe/ball color). Placeholder look, swap for a
       nicer mesh later. -->
  <xacro:macro name="mir100_basket" params="parent color:=Red">
    <xacro:property name="floor_size_x" value="0.584"/>
    <xacro:property name="floor_size_y" value="0.330"/>
    <xacro:property name="floor_thickness" value="0.02"/>
    <xacro:property name="wall_thickness" value="0.026"/>
    <xacro:property name="wall_height" value="0.24"/>

    <joint name="basket_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="basket_link"/>
      <origin xyz="-0.05 0 0.352" rpy="0 0 0"/>
    </joint>

    <link name="basket_link">
      <inertial>
        <mass value="3.5"/>
        <inertia ixx="0.07" ixy="0" ixz="0" iyy="0.14" iyz="0" izz="0.15"/>
      </inertial>

      <visual>
        <origin xyz="0 0 ${floor_thickness/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${floor_size_x} ${floor_size_y} ${floor_thickness}"/>
        </geometry>
        <material name="IndustrialGrey"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${floor_thickness/2}" rpy="0 0 0"/>
        <geometry>
          <box size="${floor_size_x} ${floor_size_y} ${floor_thickness}"/>
        </geometry>
      </collision>

      <xacro:macro name="basket_wall" params="x y len_x len_y">
        <visual>
          <origin xyz="${x} ${y} ${floor_thickness + wall_height/2}" rpy="0 0 0"/>
          <geometry>
            <box size="${len_x} ${len_y} ${wall_height}"/>
          </geometry>
          <material name="${color}"/>
        </visual>
        <collision>
          <origin xyz="${x} ${y} ${floor_thickness + wall_height/2}" rpy="0 0 0"/>
          <geometry>
            <box size="${len_x} ${len_y} ${wall_height}"/>
          </geometry>
        </collision>
      </xacro:macro>

      <xacro:basket_wall x="${floor_size_x/2 - wall_thickness/2}" y="0"
                          len_x="${wall_thickness}" len_y="${floor_size_y}"/>
      <xacro:basket_wall x="${-floor_size_x/2 + wall_thickness/2}" y="0"
                          len_x="${wall_thickness}" len_y="${floor_size_y}"/>
      <xacro:basket_wall x="0" y="${floor_size_y/2 - wall_thickness/2}"
                          len_x="${floor_size_x}" len_y="${wall_thickness}"/>
      <xacro:basket_wall x="0" y="${-floor_size_y/2 + wall_thickness/2}"
                          len_x="${floor_size_x}" len_y="${wall_thickness}"/>
    </link>
  </xacro:macro>
</robot>
