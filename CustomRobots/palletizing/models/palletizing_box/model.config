<?xml version="1.0"?>
<model>
  <name>Palletizing Box</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>

  <author>
    <name>JdeRobot - RoboticsAcademy</name>
    <email></email>
  </author>

  <description>
    Dynamic ~0.10 m box spawned onto the palletizing conveyor by box_spawner.
    Larger than the pick_place graspable cubes. Spawned instances are named
    box_N so downstream logic (and any belt region checks) can match them.
  </description>
</model>
