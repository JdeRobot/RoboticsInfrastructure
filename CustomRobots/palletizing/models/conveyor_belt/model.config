<?xml version="1.0"?>
<model>
  <name>Conveyor Belt (Palletizing)</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>

  <author>
    <name>JdeRobot - RoboticsAcademy</name>
    <email></email>
  </author>

  <description>
    Moving conveyor belt for the Palletizing exercise. Reuses the pick_place
    conveyor visual mesh; the belt surface is driven by Gazebo Harmonic's native
    TrackController system (gz-sim-track-controller-system). The contact-surface
    velocity is commanded by publishing gz.msgs.Double on
    /model/&lt;name&gt;/link/&lt;link&gt;/track_cmd_vel (bridged from ROS as
    /conveyor/speed). Objects resting on the belt are dragged by friction.
  </description>
</model>
