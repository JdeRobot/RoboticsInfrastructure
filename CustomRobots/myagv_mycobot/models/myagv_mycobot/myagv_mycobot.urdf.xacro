<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="myagv_mycobot">

  <xacro:arg name="namespace" default=""/>
  <xacro:property name="namespace" value="$(arg namespace)"/>

  <xacro:arg name="simulation_controllers" default=""/>
  <xacro:property name="simulation_controllers" value="$(arg simulation_controllers)"/>

  <xacro:include filename="$(find custom_robots)/models/myagv_mycobot/myagv_mycobot_common.urdf.xacro"/>

  <xacro:myagv_mycobot namespace="${namespace}" simulation_controllers="${simulation_controllers}"/>

</robot>
