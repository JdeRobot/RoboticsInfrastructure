<?xml version="1.0" ?>
<sdf version="1.9">

  <model name="box">

    <link name="link">

      <pose>0 0 0 0 0 0</pose>

      <gravity>true</gravity>

      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.0002</ixx>
          <iyy>0.0002</iyy>
          <izz>0.0002</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.05 0.05 0.05</size>
          </box>
        </geometry>

        <surface>

          <contact>
            <ode>
              <kp>100000</kp>
              <kd>10</kd>
            </ode>
          </contact>

          <friction>
            <ode>
              <mu>0.6</mu>
              <mu2>0.6</mu2>
            </ode>
          </friction>

        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.05 0.05 0.05</size>
          </box>
        </geometry>

        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
        </material>
      </visual>

    </link>

  </model>

</sdf>