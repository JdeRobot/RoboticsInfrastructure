<?xml version="1.0" ?>
<sdf version="1.8">

  <model name="conveyor_belt">

    <static>true</static>

    <link name="belt">

      <pose>0 0 0.75 0 0 0</pose>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.6 1.4 0.1</size>
          </box>
        </geometry>

        <material>
          <ambient>0.4 0.4 0.4 1</ambient>
          <diffuse>0.6 0.6 0.6 1</diffuse>
        </material>
      </visual>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.6 1.4 0.1</size>
          </box>
        </geometry>

        <surface>
          <contact>
            <ode>
              <kp>100000</kp>
              <kd>100</kd>
            </ode>
          </contact>

          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

    </link>

    <plugin filename="libconveyor_plugin.so" name="conveyor_surface">
      <velocity>0.3</velocity>
    </plugin>

  </model>

</sdf>