<?xml version="1.0" ?>
<sdf version="1.10">

  <model name="conveyor_belt">

    <static>false</static>

    <link name="belt">

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://conveyor_belt/meshes/conveyor_belt.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>

      <collision name="collision">

        <pose>0 0 0.75 0 0 0</pose>

        <geometry>
          <box>
            <size>0.425 1.2 0.02</size>
          </box>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>

      </collision>

    </link>

    <plugin filename="libconveyor_plugin.so" name="conveyor_plugin">
      <link_name>belt</link_name>
      <velocity>0.2</velocity>
    </plugin>

  </model>

</sdf>