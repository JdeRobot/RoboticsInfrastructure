<sdf version="1.10">
  <model name="conveyor_belt">

    <model name="fixed">
      <static>true</static>

      <link name="visual">
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://conveyor_belt/meshes/conveyor_belt.dae</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <model name="moving">

      <static>false</static>

      <pose>0 0 0.0 0 0 0</pose>

      <link name="belt">

        <inertial>
          <mass>50.0</mass>
          <inertia>
            <ixx>1</ixx>
            <iyy>1</iyy>
            <izz>1</izz>
          </inertia>
        </inertial>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.425 1.2 0.001</size>
            </box>
          </geometry>

          <surface>
            <contact>
              <collide_without_contact>false</collide_without_contact>
            </contact>

            <friction>
              <ode>
                <mu>100.0</mu>
                <mu2>100.0</mu2>
              </ode>

              <torsional>
                <coefficient>1000.0</coefficient>
                <patch_radius>0.1</patch_radius>
              </torsional>

            </friction>

          </surface>
        </collision>

      </link>

    </model>

    <joint name="belt_joint" type="prismatic">
      <parent>fixed::visual</parent>
      <child>moving::belt</child>

      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>0.01</upper>
        </limit>
      </axis>
    </joint>

    <plugin filename="libconveyor_plugin.so" name="conveyor_plugin">
      <joint_name>belt_joint</joint_name>
      <velocity>0.2</velocity>
    </plugin>

  </model>
</sdf>