<sdf version="1.8">
  <model name="conveyor_belt">

    <static>false</static>

    <link name="base">
      <collision name="collision">
        <geometry>
          <box>
            <size>0.6 1.4 0.1</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.6 1.4 0.1</size>
          </box>
        </geometry>
      </visual>
    </link>

    <link name="belt_moving">
      <pose>0 0 0.75 0 0 0</pose>

      <kinematic>true</kinematic>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.5 1.2 0.001</size>
          </box>
        </geometry>

        <surface>
          <contact>
            <ode>
              <kp>100000</kp>
              <kd>100</kd>
            </ode>
          </contact>

          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.5 1.2 0.01</size>
          </box>
        </geometry>
      </visual>

    </link>

    <plugin filename="libconveyor_plugin.so" name="conveyor_plugin">
      <velocity>0.2</velocity>
    </plugin>

  </model>
</sdf>