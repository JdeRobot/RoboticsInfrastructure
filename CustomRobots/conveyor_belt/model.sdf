<?xml version="1.0" ?>
<sdf version="1.9">

  <model name="conveyor_belt">

    <static>true</static>

    <link name="belt">

      <pose>0 0 0.75 0 0 0</pose>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://conveyor_belt/meshes/conveyor_belt.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.6 1.4 0.05</size>
          </box>
        </geometry>

        <surface>
          <contact>
            <ode>
              <kp>1000000</kp>
              <kd>1000</kd>
            </ode>
          </contact>

          <friction>
            <ode>
              <mu>10.0</mu>
              <mu2>10.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

    </link>

    <plugin filename="libconveyor_plugin.so" name="conveyor_system">
      <velocity>0.3</velocity>
      <direction>y</direction>

      <region>
        <min_x>-0.3</min_x>
        <max_x>0.3</max_x>
        <min_y>-0.7</min_y>
        <max_y>0.7</max_y>
        <min_z>0.7</min_z>
        <max_z>1.0</max_z>
      </region>
    </plugin>

  </model>

</sdf>