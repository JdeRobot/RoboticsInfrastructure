<?xml version="1.0" ?>
<sdf version="1.9">

  <model name="conveyor_belt">

    <link name="base">
      <static>true</static>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.6 1.3 0.1</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
        </material>
      </visual>
    </link>

    <link name="belt">

      <pose>0 0 0.8 0 0 0</pose>

      <inertial>
        <mass>10.0</mass>
      </inertial>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.5 1.2 0.02</size>
          </box>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>100</mu>
              <mu2>100</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.5 1.2 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
        </material>
      </visual>

    </link>

    <joint name="belt_joint" type="prismatic">
      <parent>base</parent>
      <child>belt</child>

      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>0.02</upper>
        </limit>
      </axis>
    </joint>

    <plugin filename="libconveyor_plugin.so"
            name="conveyor::ConveyorSystem">

      <velocity>0.2</velocity>
      <debug>true</debug>

    </plugin>

  </model>

</sdf>