<?xml version="1.0" ?>
<sdf version="1.10">

  <model name="conveyor_belt">

    <static>true</static>

    <link name="belt">

      <pose>0 0 0.74 0 0 0</pose>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://conveyor_belt/meshes/conveyor_belt.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.425 1.2 0.02</size>
          </box>
        </geometry>

        <surface>

          <friction>
            <ode>
              <mu>100.0</mu>
              <mu2>100.0</mu2>
            </ode>
          </friction>

          <motion>
            <ode>
              <direction>0 1 0</direction>
              <speed>0.5</speed>
            </ode>
          </motion>

        </surface>
      </collision>

    </link>

  </model>

</sdf>