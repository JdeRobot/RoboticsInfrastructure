<?xml version="1.0" ?>
<sdf version="1.9">

  <model name="conveyor_belt">

    <link name="fixed">

      <inertial>
        <mass>1000</mass>
        <inertia>
          <ixx>1</ixx>
          <iyy>1</iyy>
          <izz>1</izz>
        </inertia>
      </inertial>

      <gravity>false</gravity>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.6 1.3 0.1</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.6 1.3 0.1</size>
          </box>
        </geometry>
      </visual>

    </link>

    <link name="belt">

      <pose>0 0 0.56 0 0 0</pose>

      <inertial>
        <mass>50</mass>
        <inertia>
          <ixx>0.1</ixx>
          <iyy>0.1</iyy>
          <izz>0.1</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.5 1.2 0.00001</size>
          </box>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>100.0</mu>
              <mu2>100.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

    </link>

    <joint name="belt_joint" type="prismatic">
      <parent>fixed</parent>
      <child>belt</child>

      <axis>
        <xyz>0 1 0</xyz>

        <limit>
          <lower>0</lower>
          <upper>0.02</upper>
          <effort>10000</effort>
          <velocity>5</velocity>
        </limit>
      </axis>
    </joint>

    <plugin filename="libconveyor_plugin.so"
            name="conveyor::ConveyorSystem">
      <velocity>0.3</velocity>
      <debug>true</debug>
    </plugin>

  </model>

</sdf>