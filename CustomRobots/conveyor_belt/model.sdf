<?xml version="1.0" ?>
<sdf version="1.9">

  <model name="conveyor_belt">

    <static>true</static>

    <link name="link">

      <pose>0 0 0 0 0 0</pose>

      <visual name="visual">

        <pose>0 0 0 0 0 0</pose>

        <geometry>
          <mesh>
            <uri>meshes/conveyor_belt.dae</uri>
          </mesh>
        </geometry>

      </visual>


      <collision name="collision">

        <pose>0 0 0.71 0 0 0</pose>

        <geometry>
          <box>
            <size>0.50 1.20 0.055</size>
          </box>
        </geometry>


        <surface>

          <contact>
            <ode>
              <kp>100000</kp>
              <kd>10</kd>
              <min_depth>0.001</min_depth>
              <max_vel>1.0</max_vel>
            </ode>
          </contact>


          <friction>
            <ode>

              <!--
                La cinta se mueve en el eje Y local.
              -->

              <fdir1>1 0 0</fdir1>

              <mu>2.0</mu>

              <mu2>0.5</mu2>

            </ode>
          </friction>

        </surface>

      </collision>

    </link>


    <!-- ====================================================== -->
    <!-- TRACK CONTROLLER                                       -->
    <!-- ====================================================== -->

    <plugin
      filename="gz-sim-track-controller-system"
      name="gz::sim::systems::TrackController">

      <link>link</link>

      <min_velocity>-1.0</min_velocity>

      <max_velocity>1.0</max_velocity>

    </plugin>


    <!-- ====================================================== -->
    <!-- NUESTRO PLUGIN                                         -->
    <!-- ====================================================== -->

    <plugin
      filename="libconveyor_plugin.so"
      name="box_mover::BoxMoverPlugin"/>

  </model>

</sdf>