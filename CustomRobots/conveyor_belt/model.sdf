<?xml version="1.0" ?>
<sdf version="1.9">

  <model name="conveyor_belt">

    <static>true</static>

    <link name="base">

      <collision name="collision">
        <geometry>
          <box>
            <size>0.6 1.3 0.1</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.6 1.3 0.1</size>
          </box>
        </geometry>
      </visual>

    </link>

    <link name="belt">

      <pose>0 0 0.8 0 0 0</pose>

      <inertial>
        <mass>10.0</mass>
        <inertia>
          <ixx>0.1</ixx>
          <iyy>0.1</iyy>
          <izz>0.1</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.5 1.2 0.02</size>
          </box>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>100</mu>
              <mu2>100</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.5 1.2 0.02</size>
          </box>
        </geometry>
      </visual>

    </link>

    <joint name="belt_joint" type="prismatic">
      <parent>base</parent>
      <child>belt</child>

      <axis>
        <xyz>0 1 0</xyz>

        <dynamics>
          <damping>1.0</damping>
        </dynamics>

        <limit>
          <lower>0</lower>
          <upper>0.02</upper>
          <effort>1000</effort>
          <velocity>1.0</velocity>
        </limit>
      </axis>
    </joint>

    <plugin filename="libconveyor_plugin.so"
            name="conveyor::ConveyorSystem">
      <velocity>0.2</velocity>
      <debug>true</debug>
    </plugin>

  </model>

</sdf>