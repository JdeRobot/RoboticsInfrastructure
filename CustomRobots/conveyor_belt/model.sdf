<?xml version="1.0" ?>
<sdf version="1.8">

  <model name="conveyor_belt">

    <link name="belt_visual">
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://conveyor_belt/meshes/conveyor_belt.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <link name="belt_surface">
      <pose>0 0 0.75 0 0 0</pose>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.5 1.2 0.02</size>
          </box>
        </geometry>

        <surface>
          <contact>
            <ode>
              <kp>100000</kp>
              <kd>100</kd>
            </ode>
          </contact>

          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>

    <plugin filename="libconveyor_plugin.so" name="conveyor_surface">
      <velocity>0.2</velocity>
    </plugin>

  </model>

</sdf>