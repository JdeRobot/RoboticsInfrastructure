<sdf version="1.10">

  <model name="conveyor_belt">

    <static>false</static>

    <link name="visual_link">
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://conveyor_belt/meshes/conveyor_belt.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <link name="belt">

      <inertial>
        <mass>100</mass>
      </inertial>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.425 1.2 0.02</size>
          </box>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>50.0</mu>
              <mu2>50.0</mu2>
            </ode>
          </friction>
        </surface>

      </collision>

    </link>

    <joint name="visual_joint" type="fixed">
      <parent>belt</parent>
      <child>visual_link</child>
    </joint>

    <plugin filename="libconveyor_plugin.so" name="conveyor_plugin">
      <link_name>belt</link_name>
      <velocity>0.2</velocity>
    </plugin>

  </model>

</sdf>