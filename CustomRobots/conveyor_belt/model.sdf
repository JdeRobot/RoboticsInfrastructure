<?xml version="1.0" ?>
<sdf version="1.9">

  <model name="conveyor_belt">

    <static>true</static>

    <link name="link">

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://conveyor_belt/meshes/conveyor_belt.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <collision name="collision">
        <pose>0 0 0.75 0 0 0</pose>

        <geometry>
          <box>
            <size>0.5 1.2 0.01</size>
          </box>
        </geometry>

        <surface>
          <contact>
            <ode>
              <kp>1000000</kp>
              <kd>1000</kd>
            </ode>
          </contact>

          <friction>
            <ode>
              <mu>100.0</mu>
              <mu2>100.0</mu2>
            </ode>
          </friction>
        </surface>

      </collision>

    </link>

    <plugin filename="libconveyor_plugin.so"
            name="conveyor::ConveyorSystem">

      <velocity>0.3</velocity>
      <direction>y</direction>

      <region>
        <min_x>-0.25</min_x>
        <max_x>0.25</max_x>
        <min_y>-0.6</min_y>
        <max_y>0.6</max_y>
        <min_z>0.7</min_z>
        <max_z>1.0</max_z>
      </region>

    </plugin>

  </model>

</sdf>