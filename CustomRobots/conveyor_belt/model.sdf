<?xml version="1.0" ?>
<sdf version="1.9">

  <model name="conveyor_belt">

    <static>false</static>

    <link name="support">

      <pose>0 0 0.25 0 0 0</pose>

      <inertial>
        <mass>1000</mass>
        <inertia>
          <ixx>1</ixx>
          <iyy>1</iyy>
          <izz>1</izz>
        </inertia>
      </inertial>

      <gravity>false</gravity>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.6 1.3 0.5</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.6 1.3 0.5</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>

    </link>

    <link name="belt">

      <pose>0 0 0.51 0 0 0</pose>

      <inertial>
        <mass>50</mass>
        <inertia>
          <ixx>0.1</ixx>
          <iyy>0.1</iyy>
          <izz>0.1</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.5 1.2 0.01</size>
          </box>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>100.0</mu>
              <mu2>100.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.5 1.2 0.01</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>

    </link>

    <joint name="belt_joint" type="prismatic">

      <parent>support</parent>
      <child>belt</child>

      <axis>
        <xyz>0 1 0</xyz>

        <dynamics>
          <damping>2.0</damping>
        </dynamics>

        <limit>
          <lower>-1</lower>
          <upper>1</upper>
          <effort>10000</effort>
          <velocity>5</velocity>
        </limit>
      </axis>

    </joint>

    <plugin filename="libconveyor_plugin.so"
            name="conveyor::ConveyorSystem">

      <velocity>0.3</velocity>
      <debug>true</debug>

    </plugin>

  </model>

</sdf>