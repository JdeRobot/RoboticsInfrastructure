<?xml version="1.0" ?>
<sdf version="1.8">

  <model name="conveyor_belt">

    <static>false</static>

    <link name="base">
      <collision name="collision">
        <geometry>
          <box>
            <size>0.6 1.4 0.1</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.6 1.4 0.1</size>
          </box>
        </geometry>
      </visual>
    </link>

    <link name="belt">
      <pose>0 0 0.8 0 0 0</pose>

      <inertial>
        <mass>10.0</mass>
        <inertia>
          <ixx>1</ixx>
          <iyy>1</iyy>
          <izz>1</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.5 1.2 0.05</size>
          </box>
        </geometry>

        <surface>
          <contact>
            <ode>
              <kp>1000000</kp>
              <kd>10</kd>
            </ode>
          </contact>

          <friction>
            <ode>
              <mu>50</mu>
              <mu2>50</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.5 1.2 0.05</size>
          </box>
        </geometry>
      </visual>
    </link>

    <joint name="belt_joint" type="prismatic">
      <parent>base</parent>
      <child>belt</child>

      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>1000</upper>
          <effort>1000</effort>
        </limit>
      </axis>
    </joint>

    <plugin filename="libconveyor_plugin.so" name="conveyor_plugin">
      <velocity>0.5</velocity>
    </plugin>

  </model>

</sdf>