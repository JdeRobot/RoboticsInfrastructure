<?xml version="1.0" ?>
<sdf version="1.10">

  <model name="conveyor_belt">

    <model name="fixed">
      <static>true</static>

      <link name="visual">

        <visual name="visual">
          <geometry>
            <mesh>
              <uri>model://conveyor_belt/meshes/conveyor_belt.dae</uri>
            </mesh>
          </geometry>
        </visual>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.5 1.3 0.1</size>
            </box>
          </geometry>
        </collision>

      </link>
    </model>

    <model name="moving">

      <static>false</static>
      <allow_auto_disable>0</allow_auto_disable>

      <pose>0 0 0.74 0 0 0</pose>

      <link name="belt">

        <inertial>
          <mass>50.0</mass>
          <inertia>
            <ixx>1</ixx>
            <iyy>1</iyy>
            <izz>1</izz>
          </inertia>
        </inertial>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.425 1.2 0.01</size>
            </box>
          </geometry>

          <surface>

            <contact>
              <collide_without_contact>false</collide_without_contact>
            </contact>

            <friction>
              <ode>
                <mu>100.0</mu>
                <mu2>100.0</mu2>
              </ode>
            </friction>

          </surface>
        </collision>

      </link>

    </model>

    <joint name="belt_joint" type="prismatic">
      <parent>fixed::visual</parent>
      <child>moving::belt</child>

      <axis>
        <xyz>0 1 0</xyz>

        <limit>
          <lower>0</lower>
          <upper>0.01</upper>
          <effort>1000</effort>
        </limit>

        <dynamics>
          <damping>0.1</damping>
          <friction>0.0</friction>
        </dynamics>

      </axis>
    </joint>

    <!-- PLUGIN -->
    <plugin filename="libconveyor_plugin.so" name="conveyor_plugin">
      <velocity>0.5</velocity>
    </plugin>

  </model>

</sdf>