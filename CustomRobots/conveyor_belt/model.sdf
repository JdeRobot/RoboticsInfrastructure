<?xml version="1.0" ?>
<sdf version="1.9">

  <model name="conveyor_belt">
    <static>true</static>

    <link name="belt">

      <pose>0 0 0.741 0 0 0</pose>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://conveyor_belt/meshes/conveyor_belt.dae</uri>
          </mesh>
        </geometry>
      </visual>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.5 1.5 0.02</size>
          </box>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>100</mu>
              <mu2>100</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

    </link>

    <plugin filename="libconveyor_system.so"
            name="conveyor::ConveyorSystem">

      <velocity>0.4</velocity>
      <direction>y</direction>

      <region>
        <min_x>-0.3</min_x>
        <max_x>0.3</max_x>
        <min_y>-0.7</min_y>
        <max_y>0.7</max_y>
        <min_z>0.6</min_z>
        <max_z>1.0</max_z>
      </region>

    </plugin>

  </model>

</sdf>