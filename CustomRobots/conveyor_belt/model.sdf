<?xml version="1.0" ?>
<sdf version="1.8">

  <model name="conveyor_belt">

    <static>false</static>

    <link name="belt">

      <pose>0 0 0.74 0 0 0</pose>

      <inertial>
        <mass>20.0</mass>
        <inertia>
          <ixx>1</ixx>
          <iyy>1</iyy>
          <izz>1</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.5 1.2 0.08</size>
          </box>
        </geometry>

        <surface>

          <contact>
            <ode>
              <kp>10000000</kp>
              <kd>100</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.003</min_depth>
            </ode>
          </contact>

          <friction>
            <ode>
              <mu>10.0</mu>
              <mu2>10.0</mu2>
            </ode>
          </friction>

          <motion>
            <ode>
              <direction>0 1 0</direction>
              <speed>0.3</speed>
            </ode>
          </motion>

        </surface>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.5 1.2 0.08</size>
          </box>
        </geometry>
      </visual>

    </link>

  </model>

</sdf>