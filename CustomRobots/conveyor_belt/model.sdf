<?xml version="1.0" ?>
<sdf version="1.9">

  <model name="conveyor_belt">

    <static>true</static>

    <link name="support">

      <pose>0 0 0.25 0 0 0</pose>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.6 1.3 0.5</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.6 1.3 0.5</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
        </material>
      </visual>

    </link>

    <link name="visual_mesh">

      <pose>0 0 0.5 0 0 0</pose>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>meshes/conveyor_belt.dae</uri>
          </mesh>
        </geometry>
      </visual>

    </link>

    <link name="belt">

      <pose>0 0 0.55 0 0 0</pose>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.5 1.2 0.01</size>
          </box>
        </geometry>

        <surface>
          <contact>
            <ode>
              <kp>100000</kp>
              <kd>100</kd>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>

          <friction>
            <ode>
              <mu>100.0</mu>
              <mu2>100.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

    </link>

    <joint name="belt_joint" type="prismatic">

      <parent>support</parent>
      <child>belt</child>

      <axis>
        <xyz>0 1 0</xyz>

        <limit>
          <lower>-1</lower>
          <upper>1</upper>
          <effort>10000</effort>
          <velocity>5</velocity>
        </limit>

        <dynamics>
          <damping>2.0</damping>
        </dynamics>

      </axis>

    </joint>

    <plugin filename="libconveyor_plugin.so"
            name="conveyor::ConveyorSystem">

      <velocity>0.3</velocity>
      <debug>true</debug>

    </plugin>

  </model>

</sdf>