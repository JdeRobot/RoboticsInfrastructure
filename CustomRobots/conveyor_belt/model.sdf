<sdf version="1.10">
  <model name="conveyor_belt">

    <!-- BASE VISUAL -->
    <link name="base">
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://conveyor_belt/meshes/conveyor_belt.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <!-- SUPERFICIE MÓVIL -->
    <link name="belt">

      <inertial>
        <mass>100</mass>
      </inertial>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.425 1.2 0.02</size>
          </box>
        </geometry>

        <surface>
          <friction>
            <ode>
              <mu>100.0</mu>
              <mu2>100.0</mu2>
            </ode>
          </friction>
        </surface>

      </collision>

    </link>

    <joint name="belt_joint" type="prismatic">
      <parent>base</parent>
      <child>belt</child>
      <axis>
        <xyz>0 1 0</xyz> <!-- dirección de la cinta -->
        <limit>
          <lower>-1000</lower>
          <upper>1000</upper>
        </limit>
      </axis>
    </joint>

    <!-- PLUGIN -->
    <plugin filename="libconveyor_plugin.so" name="conveyor_plugin">
      <joint_name>belt_joint</joint_name>
      <velocity>0.2</velocity>
    </plugin>

  </model>
</sdf>