<?xml version="1.0" ?>
<sdf version="1.9">

  <model name="sausage">

    <link name="link">

      <pose>0 0 0 0 0 0</pose>

      <gravity>true</gravity>

      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.0002</ixx>
          <iyy>0.0002</iyy>
          <izz>0.0002</izz>
        </inertia>
      </inertial>

      <collision name="collision">

        <geometry>
          <box>
            <size>0.04 0.12 0.04</size>
          </box>
        </geometry>

        <surface>
          <contact>
            <ode>
              <kp>100000</kp>
              <kd>10</kd>
            </ode>
          </contact>

          <friction>
            <ode>
              <mu>0.1</mu>
              <mu2>0.1</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="collision_debug">
        <geometry>
          <box>
            <size>0.12 0.03 0.03</size>
          </box>
        </geometry>

        <material>
          <ambient>1 0 0 0.3</ambient>
          <diffuse>1 0 0 0.3</diffuse>
        </material>
      </visual>

      <visual name="visual">

        <pose>0 0 -0.02 1.57 0 0</pose>

        <geometry>
          <mesh>
            <uri>meshes/sausage.glb</uri>

            <scale>0.01 0.01 0.01</scale>
          </mesh>
        </geometry>

      </visual>

    </link>

  </model>

</sdf>