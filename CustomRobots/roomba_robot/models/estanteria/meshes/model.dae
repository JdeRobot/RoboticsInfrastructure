    <unit name="meter" meter="1"/>
    <up_axis>Z_UP</up_axis>
  </asset>
  <library_effects>
    <effect id="Wood-effect">
      <profile_COMMON>
        <newparam sid="wood_jpg-surface">
          <surface type="2D">
            <init_from>wood_jpg</init_from>
          </surface>
        </newparam>
        <newparam sid="wood_jpg-sampler">
          <sampler2D>
            <source>wood_jpg-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="wood_jpg-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.45</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_images>
    <image id="wood_jpg" name="wood_jpg">
      <init_from>wood.jpg</init_from>
    </image>
  </library_images>
  <library_materials>
    <material id="Wood-material" name="Wood">
      <instance_effect url="#Wood-effect"/>
    </material>
  </library_materials>
