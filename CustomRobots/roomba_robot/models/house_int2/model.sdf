<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="house_int2_harmonic">
    <static>true</static>
    <link name="house_int_link">
      <visual name="walls_visual">
        <geometry>
          <mesh>
            <uri>meshes/model.dae</uri>
            <submesh>
              <name>walls</name>
            </submesh>
          </mesh>
        </geometry>
      </visual>
      <visual name="floor_visual">
        <geometry>
          <mesh>
            <uri>meshes/model.dae</uri>
            <submesh>
              <name>Plane</name>
            </submesh>
          </mesh>
        </geometry>
      </visual>
      <visual name="encimera_visual">
        <geometry>
          <mesh>
            <uri>meshes/model.dae</uri>
            <submesh>
              <name>encimera</name>
            </submesh>
          </mesh>
        </geometry>
      </visual>
      <visual name="barra_visual">
        <geometry>
          <mesh>
            <uri>meshes/model.dae</uri>
            <submesh>
              <name>barra</name>
            </submesh>
          </mesh>
        </geometry>
      </visual>
      <visual name="frigo_visual">
        <geometry>
          <mesh>
            <uri>meshes/model.dae</uri>
            <submesh>
              <name>frigo</name>
            </submesh>
          </mesh>
        </geometry>
      </visual>
      <collision name="house_int2_harmonic_collision">
        <geometry>
          <mesh>
            <uri>meshes/model.dae</uri>
          </mesh>
        </geometry>
        <surface>
          <contact>
            <collide_bitmask>0x01</collide_bitmask>
          </contact>
        </surface>
      </collision>
    </link>
    <include>
        <uri>model://mesa_comedor</uri>
        <pose>-2.1 0 0 0 0 1.57</pose>
        <static>true</static>
    </include>
    <include>
        <uri>model://silla</uri>
        <pose>-2.1 -0.1 0 0 -0 0</pose>
        <static>true</static>
    </include>
  </model>
</sdf>
