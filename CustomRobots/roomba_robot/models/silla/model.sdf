<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="silla">
    <static>true</static>
    <link name="silla_link">
      <visual name="silla_visual">
        <geometry>
          <mesh>
            <uri>meshes/model.dae</uri>
            <submesh>
              <name>silla</name>
            </submesh>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/Grey</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>
      <visual name="pata1_visual">
        <geometry>
          <mesh>
            <uri>meshes/model.dae</uri>
            <submesh>
              <name>pata1</name>
            </submesh>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
          <specular>0.0 0.0 0.0 1.0</specular>
          <pbr>
            <metal>
              <albedo_map>meshes/wood.jpg</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="pata2_visual">
        <geometry>
