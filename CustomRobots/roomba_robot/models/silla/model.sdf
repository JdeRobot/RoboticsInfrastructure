          <pbr>
            <metal>
              <albedo_map>meshes/wood.jpg</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
      <visual name="respaldo_visual">
        <geometry>
          <mesh>
            <uri>meshes/model.dae</uri>
            <submesh>
              <name>respaldo</name>
