                <instance_material symbol="Grey-material" target="#Grey-material"/>
                <instance_material symbol="White-material" target="#White-material"/>
                <instance_material symbol="Pink-material" target="#Pink-material"/>
              </technique_common>
            </bind_material>
          </instance_controller>
        </node>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene>
    <instance_visual_scene url="#Scene"/>
  </scene>
</COLLADA>