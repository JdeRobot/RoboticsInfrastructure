  <library_effects>
    <effect id="Material_004-effect">
      <profile_COMMON>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <color sid="diffuse">0.3743428 0.3743428 0.3743428 1</color>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
    <effect id="Material_003-effect">
      <profile_COMMON>
        <newparam sid="asfalto_jpg-surface">
          <surface type="2D">
            <init_from>asfalto_jpg</init_from>
          </surface>
        </newparam>
        <newparam sid="asfalto_jpg-sampler">
          <sampler2D>
            <source>asfalto_jpg-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="asfalto_jpg-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_images>
