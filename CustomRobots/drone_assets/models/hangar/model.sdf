<?xml version='1.0'?>
<sdf version="1.4">
<model name="hangar">
  <static>true</static>

  <!-- Ground: industrial concrete floor -->
  <link name="hangar">
    <pose>0 0 0 0 0 0</pose>
    <collision name="collision">
      <geometry>
        <plane>
          <size>100 100</size>
        </plane>
      </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <plane>
          <size>100 100</size>
        </plane>
      </geometry>
      <material>
        <ambient>0.6 0.6 0.6 1</ambient>
        <diffuse>0.6 0.6 0.6 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
        <pbr>
          <metal>
            <albedo_map>model://hangar/materials/textures/concrete_floor.jpg</albedo_map>
          </metal>
        </pbr>
      </material>
    </visual>
  </link>

  <!-- Side walls, elongated so the interior is not claustrophobic. No roof: fully open top so the drone camera never sees overhead beams. -->
  <link name="hangar_wall1">
    <pose>6.8 12.25 3 0 0 0</pose>
    <collision name="collision">
      <geometry>
        <box>
          <size>0.1 40 6</size>
        </box>
      </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <box>
          <size>0.1 40 6</size>
        </box>
      </geometry>
      <material>
        <ambient>0.5 0.52 0.55 1</ambient>
        <diffuse>0.55 0.57 0.6 1</diffuse>
        <specular>0.2 0.2 0.2 1</specular>
      </material>
    </visual>
  </link>

  <link name="hangar_wall2">
    <pose>-6.8 12.25 3 0 0 0</pose>
    <collision name="collision">
      <geometry>
        <box>
          <size>0.1 40 6</size>
        </box>
      </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <box>
          <size>0.1 40 6</size>
        </box>
      </geometry>
      <material>
        <ambient>0.5 0.52 0.55 1</ambient>
        <diffuse>0.55 0.57 0.6 1</diffuse>
        <specular>0.2 0.2 0.2 1</specular>
      </material>
    </visual>
  </link>

  <!-- Back wall (closed end, opposite the entrance funnel) -->
  <link name="hangar_wall3">
    <pose>0 32 3 0 0 1.57</pose>
    <collision name="collision">
      <geometry>
        <box>
          <size>0.1 13.5 6</size>
        </box>
      </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <box>
          <size>0.1 13.5 6</size>
        </box>
      </geometry>
      <material>
        <ambient>0.5 0.52 0.55 1</ambient>
        <diffuse>0.55 0.57 0.6 1</diffuse>
        <specular>0.2 0.2 0.2 1</specular>
      </material>
    </visual>
  </link>

  <!-- Entrance funnel (angled chevron walls forming the exit) -->
  <link name="hangar_wall4">
    <pose>4.9 -7.0 3 0 0 1.35</pose>
    <collision name="collision">
      <geometry>
        <box>
          <size>0.1 4 6</size>
        </box>
      </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <box>
          <size>0.1 4 6</size>
        </box>
      </geometry>
      <material>
        <ambient>0.5 0.52 0.55 1</ambient>
        <diffuse>0.55 0.57 0.6 1</diffuse>
        <specular>0.2 0.2 0.2 1</specular>
      </material>
    </visual>
  </link>

  <link name="hangar_wall5">
    <pose>-4.9 -7.0 3 0 0 1.85</pose>
    <collision name="collision">
      <geometry>
        <box>
          <size>0.1 4 6</size>
        </box>
      </geometry>
    </collision>
    <visual name="visual">
      <geometry>
        <box>
          <size>0.1 4 6</size>
        </box>
      </geometry>
      <material>
        <ambient>0.5 0.52 0.55 1</ambient>
        <diffuse>0.55 0.57 0.6 1</diffuse>
        <specular>0.2 0.2 0.2 1</specular>
      </material>
    </visual>
  </link>

</model>
</sdf>
