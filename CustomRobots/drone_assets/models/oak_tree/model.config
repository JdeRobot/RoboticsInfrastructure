<?xml version="1.0"?>
<model>
  <name>oak_tree</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <author>
    <name>Louise Poubel</name>
    <email>louise@osrfoundation.org</email>
  </author>
  <description>
    A deciduous oak tree. Vendored locally from the OpenRobotics Fuel
    model of the same name (no network dependency at runtime), with
    cast_shadows disabled on both submeshes to keep RTF cheap when many
    of these are scattered around a world.
  </description>
</model>
