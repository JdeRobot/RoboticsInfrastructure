<?xml version="1.0"?>

<model>
  <name>Moving Panel</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>

  <description>
    A flat rectangular panel obstacle. Static geometry only - pair it with a
    hangar_obstacles::ObstacleMover plugin (mode=oscillate) on the include to
    make it slide back and forth along any axis.
  </description>
</model>
