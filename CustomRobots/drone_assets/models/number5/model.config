<?xml version="1.0"?>

<model>
  <name>Number5</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <author>
    <name>RoboticsAcademy</name>
    <email></email>
  </author>

  <description>
    A box that displays the number 5. Same mesh and cube-net texture
    layout as number1-4 (materials/textures/number5.png generated by
    detecting each face's rotation in number4.png and re-rendering the
    same net with a "5" glyph), added for position_control which has 5
    elevated beacon markers instead of 4.
  </description>
</model>
