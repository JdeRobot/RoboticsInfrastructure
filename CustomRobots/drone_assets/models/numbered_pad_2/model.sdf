<?xml version='1.0'?>
<sdf version='1.6'>
    <model name='numbered_pad_2'>
        <static>true</static>
        <link name='link'>
            <collision name='collision'>
                <geometry>
                    <plane>
                        <normal>0 0 1</normal>
                        <size>2 2</size>
                    </plane>
                </geometry>
                <surface>
                    <friction>
                      <ode>
                        <mu>0.5</mu>
