<?xml version="1.0"?>

<model>
  <name>Moving Shutter</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>

  <description>
    A wide, short panel spanning most of the corridor width. Static geometry
    only - pair it with a hangar_obstacles::ObstacleMover plugin
    (mode=oscillate, axis=0 0 1) to make it slide up and down, alternating
    which side (floor gap or ceiling gap) is open.
  </description>
</model>
