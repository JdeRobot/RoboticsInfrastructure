<?xml version="1.0"?>

<model>
  <name>Rotating Blades</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>

  <description>
    Two crossed bars forming an X. Static geometry only - pair it with a
    hangar_obstacles::ObstacleMover plugin (mode=rotate) on the include to
    make it spin continuously around any axis.
  </description>
</model>
