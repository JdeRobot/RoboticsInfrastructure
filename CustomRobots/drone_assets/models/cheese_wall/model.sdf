<?xml version="1.0"?>
<sdf version="1.8">
<model name="cheese_wall">
  <!-- Static: this wall never moves, so unlike moving_panel/rotating_blades
       it needs no ObstacleMover plugin and can stay static (collision is
       only a problem for bodies whose pose changes at runtime). 8x4
       grid of 2.00m x 2.25m cells spanning 16m wide x
       9m tall (most of the corridor cross-section, so there's no
       easy side/top bypass) with 3 staggered holes at (col,row) = [(1, 0), (4, 2), (6, 1)].
       Color: green, so this static/navigable-hole obstacle reads as its own
       family, distinct from the red/blue/yellow moving hazards. -->
  <static>true</static>
  <link name="link">

    <collision name="cell_c0_r0"><pose>-7.0000 0 1.1250 0 0 0</pose><geometry><box><size>2.0000 0.3 2.2500</size></box></geometry></collision>
