<?xml version="1.0"?>

<model>
  <name>Cheese Wall</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>

  <description>
    A 10m x 6m static wall built from 12 box segments, leaving 3 staggered
    2m x 2m holes for the drone to fly through. No plugin needed - it never
    moves, unlike the other hangar obstacles.
  </description>
</model>
