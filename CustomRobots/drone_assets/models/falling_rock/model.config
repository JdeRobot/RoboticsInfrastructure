<?xml version="1.0"?>
<model>
  <name>falling_rock</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <author>
    <name>OpenRobotics</name>
    <email></email>
  </author>
  <description>
    Decorative rock. Vendored locally from the OpenRobotics Fuel model
    "Falling Rock 1" (no network dependency at runtime), with
    cast_shadows disabled to keep RTF cheap when several of these are
    scattered around a world. Despite the name it ships with real
    mass/inertia (meant to actually fall in demos) so it must be forced
    static in the world file's include tag when used purely as decoration.
  </description>
</model>
