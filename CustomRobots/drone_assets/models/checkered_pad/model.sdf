<model name="checkered_pad">
  <!-- Finish marker: a 6x6 black/white checkerboard, 0.333m per cell over a
       2x2m pad. One shared collision plane (like logoPadGreen's start
       pad) - the squares are visual-only tiles, no need for per-cell collision. -->
