<?xml version="1.0" ?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find custom_robots)/models/turtlebot3/turtlebot3_gz.urdf.xacro"/>

  <xacro:macro name="turtlebot3" params="namespace">
    <!-- Init colour -->
    <material name="black">
      <color rgba="0.0 0.0 0.0 1.0"/>
    </material>

    <material name="dark">
      <color rgba="0.3 0.3 0.3 1.0"/>
    </material>

    <material name="light_black">
      <color rgba="0.4 0.4 0.4 1.0"/>
    </material>

    <material name="white">
      <color rgba="1.0 1.0 1.0 1.0"/>
    </material>


    <link name="base_footprint"></link>

    <link name="base_link">
      <inertial>
        <mass value="1.373"/>
        <inertia ixx="4.2111447e-02" ixy="0" ixz="0" iyy="4.2111447e-02" iyz="0" izz="7.5254874e-02"/>
      </inertial>
      <collision>
        <origin rpy="0 0 0" xyz="-0.064 0 0.048"/>
        <geometry>
          <box size="0.265 0.265 0.089"/>
        </geometry>
      </collision>
      <visual >
        <origin rpy="0 0 0" xyz="-0.064  0 0"/>
        <geometry>
          <mesh filename="file://$(find custom_robots)/models/turtlebot3/meshes/waffle_base.dae" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="light_black"/>
      </visual>
    </link>

    <link name="wheel_left_link">
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="1.1175580e-05" ixy="0" ixz="0" iyy="1.1175580e-05" iyz="0" izz="2.0712558e-05"/>
      </inertial>
      <collision>
        <geometry>
          <cylinder radius="0.033" length="0.018"/>
        </geometry>
      </collision>
      <visual >
        <geometry>
          <cylinder radius="0.033" length="0.018"/>
        </geometry>
        <material name="black"/>
      </visual>
    </link>

    <link name="wheel_right_link">
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="1.1175580e-05" ixy="0" ixz="0" iyy="1.1175580e-05" iyz="0" izz="2.0712558e-05"/>
      </inertial>
      <collision>
        <geometry>
          <cylinder radius="0.033" length="0.018"/>
        </geometry>
      </collision>
      <visual >
        <geometry>
          <cylinder radius="0.033" length="0.018"/>
        </geometry>
        <material name="black"/>
      </visual>
    </link>

    <link name="camera_base_link"/>

    <joint name="base_to_base_link" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <joint name="camera_joint" type="fixed">
      <parent link="base_link"/>
      <child link="camera_base_link"/>
      <origin xyz="0.064 -0.065 0.094" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>

    <joint name="wheel_left_joint" type="continuous">
      <origin rpy="-1.57 0 0" xyz="0.0 0.144 0.023"/>
      <parent link="base_link"/>
      <child link="wheel_left_link"/>
      <axis xyz="0 0 1"/>
      <limit effort="20" velocity="100"/>
    </joint>

    <joint name="wheel_right_joint" type="continuous">
      <origin rpy="-1.57 0 0" xyz="0.0 -0.144 0.023"/>
      <parent link="base_link"/>
      <child link="wheel_right_link"/>
      <axis xyz="0 0 1"/>
      <limit effort="20" velocity="100"/>
    </joint>

    <!-- Ball joints -->
    <joint name="caster_back_left_joint" type="fixed">
      <parent link="base_link"/>
      <child link="caster_back_left_link"/>
      <origin xyz="-0.177 0.064 -0.004" rpy="-1.57 0 0"/>
    </joint>

    <link name="caster_back_left_link">
      <collision>
        <origin xyz="0 0.001 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.030 0.009 0.020"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" />
        <mass value="0.005" />
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
      </inertial>
    </link>

    <joint name="caster_back_right_joint" type="fixed">
      <parent link="base_link"/>
      <child link="caster_back_right_link"/>
      <origin xyz="-0.177 -0.064 -0.004" rpy="-1.57 0 0"/>
    </joint>

    <link name="caster_back_right_link">
      <collision>
        <origin xyz="0 0.001 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.030 0.009 0.020"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" />
        <mass value="0.005" />
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
      </inertial>
    </link>

    <xacro:imu parent="imu_link" xyz="-0.032 0 0.068" rpy="0 0 0" namespace="${namespace}"/>
    <xacro:laser xyz="-0.064 0 0.121" rpy="0 0 0" name="laser" parent="base_link" namespace="${namespace}"/>
    <xacro:velocity namespace="${namespace}"/>
    <xacro:odom namespace="${namespace}" freq="50"/>
  </xacro:macro>
</robot>
