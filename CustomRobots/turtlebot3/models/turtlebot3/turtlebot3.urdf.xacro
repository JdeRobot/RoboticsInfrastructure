<?xml version="1.0" ?>
<robot name="turtlebot3"
  xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="camera" default="true"/>
  <xacro:arg name="noise_level" default="none"/>
  <xacro:property name="noise_level" value="$(arg noise_level)"/>

  <xacro:if value="${noise_level == 'low'}">
    <xacro:property name="a1" value="0.0005" />
    <xacro:property name="a2" value="0.0005" />
    <xacro:property name="a3" value="0.0002" />
    <xacro:property name="a4" value="0.0002" />
  </xacro:if>

  <xacro:if value="${noise_level == 'med'}">
    <xacro:property name="a1" value="0.002" />
    <xacro:property name="a2" value="0.002" />
    <xacro:property name="a3" value="0.001" />
    <xacro:property name="a4" value="0.001" />
  </xacro:if>

  <xacro:if value="${noise_level == 'high'}">
    <xacro:property name="a1" value="0.005" />
    <xacro:property name="a2" value="0.005" />
    <xacro:property name="a3" value="0.003" />
    <xacro:property name="a4" value="0.003" />
  </xacro:if>

  <xacro:include filename="$(find custom_robots)/models/turtlebot3/turtlebot3_gz.urdf.xacro"/>
  <xacro:include filename="$(find custom_robots)/models/turtlebot3/turtlebot3_common.urdf.xacro"/>

  <xacro:turtlebot3/>

  <xacro:if value="$(arg camera)">
    <xacro:camera xyz="0.069 -0.047 0.107" rpy="0 0 0" name="camera_rgb" parent="camera_link" topic="turtlebot3/camera"/>
    <xacro:depth_camera xyz="0.074 -0.029 0.12" rpy="0 0 0" name="camera_depth" parent="base_link" topic="turtlebot3/camera"/>
  </xacro:if>

  <xacro:unless value="${noise_level == 'none'}">
    <xacro:noise_odom topic="/turtlebot3/odom_noisy" vel_topic="/turtlebot3/cmd_vel" a1="${a1}" a2="${a2}" a3="${a3}" a4="${a4}"/>
  </xacro:unless>
</robot>
