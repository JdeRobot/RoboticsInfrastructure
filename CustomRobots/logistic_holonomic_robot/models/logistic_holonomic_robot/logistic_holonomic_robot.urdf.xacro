<?xml version="1.0" ?>
<robot name="logistic_holonomic_robot"
  xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="namespace" default="logistic_robot"/>
  <xacro:property name="namespace" value="$(arg namespace)"/>

  <xacro:include filename="$(find custom_robots)/models/logistic_holonomic_robot/logistic_holonomic_robot_gz.urdf.xacro"/>
  <xacro:include filename="$(find custom_robots)/models/logistic_holonomic_robot/logistic_holonomic_robot_common.urdf.xacro"/>

  <xacro:logistic_holonomic_robot namespace="${namespace}"/>
</robot>
