<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

 <xacro:macro name="laser" params="xyz rpy name parent namespace">
    <link name="${name}_link">
      <visual>
        <geometry>
          <mesh filename="file://$(find custom_robots)/models/f1/meshes/hokuyo.dae"/>
        </geometry>
      </visual>
    </link>

    <joint name="${name}_to_${parent}" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <gazebo reference="${name}_link">
      <sensor name="laser" type="gpu_lidar">
        <always_on>1</always_on>
        <visualize>1</visualize>
        <update_rate>20</update_rate>
        <topic>/${namespace}/laser/scan</topic>
        <gz_frame_id>laser_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>180</samples>
              <resolution>1</resolution>
              <min_angle>-1.570000</min_angle>
              <max_angle>1.570000</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.080000</min>
            <max>10.000000</max>
            <resolution>0.010000</resolution>
          </range>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="velocity" params="namespace">
    <gazebo>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.576</wheel_separation>
        <wheel_radius>0.1</wheel_radius>
        <topic>/${namespace}/cmd_vel</topic>
      </plugin>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="odom" params="namespace freq">
    <gazebo>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
        <odom_publish_frequency>${freq}</odom_publish_frequency>
        <odom_topic>/${namespace}/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <dimensions>3</dimensions>
      </plugin>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="joints" params="vel_topic topic namespace">
    <gazebo>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>lift_joint</joint_name>
        <topic>/${namespace}/${vel_topic}</topic>
        <initial_position>0.0</initial_position>
        <use_force_commands>true</use_force_commands>
        <p_gain>5.0</p_gain>
        <i_gain>0.0</i_gain>
        <d_gain>0.1</d_gain>
        <cmd_max>20</cmd_max>
        <cmd_min>-20</cmd_min>
      </plugin>

      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>/${namespace}/${topic}</topic>
        <joint_name>lift_joint</joint_name>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
