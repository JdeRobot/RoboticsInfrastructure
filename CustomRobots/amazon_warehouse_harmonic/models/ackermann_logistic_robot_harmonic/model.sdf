<?xml version="1.0"?>
<sdf version="1.6">
  <model name="ackermann_logistic_robot_harmonic">
    <pose>0 0 0.0 0 0 0</pose>

    <link name='base_link' />

    <canonical_link>chassis_link</canonical_link>

    <joint name='chassis_link_joint' type='fixed'>
      <pose>0.0 0.0 0.0 0 0 0</pose>
      <parent>base_link</parent>
      <child>chassis_link</child>
    </joint>
    <link name='chassis_link'>
      <inertial>
        <pose>1e-06 0.07307 0.65096 0 -0 0</pose>
        <mass>1580</mass>
        <inertia>
          <ixx>1997.86</ixx>
          <ixy>-3e-05</ixy>
          <ixz>-1e-06</ixz>
          <iyy>442.769</iyy>
          <iyz>62.5206</iyz>
          <izz>2238.05</izz>
        </inertia>
      </inertial>
      <collision name='chassis_link_fixed_joint_lump__chassis_link_collision'>
        <pose>0 0 0.0 0 -0 0</pose>
        <geometry>
          <mesh>
            <scale>0.5 0.5 0.5</scale>
            <uri>model://ackermann_logistic_robot_harmonic/meshes/chassis.dae</uri>
          </mesh>
        </geometry>
        <surface>
          <contact>
            <ode />
          </contact>
          <friction>
            <ode>
              <mu>0.2</mu>
              <mu2>0.2</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name='chassis_link_fixed_joint_lump__chassis_link_visual'>
        <pose>0 0 0.0 0 -0 0</pose>
        <geometry>
          <mesh>
            <scale>0.5 0.5 0.5</scale>
            <uri>model://ackermann_logistic_robot_harmonic/meshes/chassis.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <!-- <velocity_decay/> -->
      <!--  <gravity>1</gravity> -->
      <!--  <gravity>1</gravity> -->
      <!-- <velocity_decay/> -->
      <self_collide>1</self_collide>
      <!--  <gravity>1</gravity> -->
    </link>

    <joint name='bl_axle' type='revolute'>
      <pose relative_to='chassis_link'>-0.18 -0.244 0.0 0 -0 0</pose>
      <parent>chassis_link</parent>
      <child>bl_1</child>
      <axis>
        <xyz>-1 0 0</xyz>
        <dynamics>
          <friction>12.031606150200002</friction>
        </dynamics>
      </axis>
    </joint>
    <link name='bl_1'>
      <pose relative_to='bl_axle'>0 0 0 0 -0 0</pose>
      <inertial>
        <pose>-0.0 0 -0 0 -0 0</pose>
        <mass>24.5</mass>
        <inertia>
          <ixx>1.84514</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.04961</iyy>
          <iyz>0</iyz>
          <izz>1.04961</izz>
        </inertia>
      </inertial>
      <collision name='bl_1_collision'>
        <pose relative_to='bl_axle'>0 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>.072</radius>
            <length>.06</length>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode />
          </contact>
          <friction>
            <ode>
              <mu>1e+6</mu>
              <mu2>1e+6</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name='bl_1_visual'>
        <pose>0.0 0.0 0.0 0 -0 0</pose>
        <geometry>
          <mesh>
            <scale>0.5 0.5 0.5</scale>
            <uri>model://ackermann_logistic_robot_harmonic/meshes/wheel.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <!--  <gravity>1</gravity> -->
      <!-- <velocity_decay/> -->
      <self_collide>0</self_collide>
    </link>

    <joint name='br_axle' type='revolute'>
      <pose relative_to='chassis_link'>0.18 -0.244 0.0 0 -0 0</pose>
      <parent>chassis_link</parent>
      <child>br_1</child>
      <axis>
        <xyz>-1 0 0</xyz>
        <dynamics>
          <friction>12.031606150200002</friction>
        </dynamics>
      </axis>
    </joint>
    <link name='br_1'>
      <pose relative_to='br_axle'>0 0 0 0 -0 0</pose>
      <inertial>
        <pose>-0.0377 0 -0 0 -0 0</pose>
        <mass>24.5</mass>
        <inertia>
          <ixx>1.84514</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.04961</iyy>
          <iyz>0</iyz>
          <izz>1.04961</izz>
        </inertia>
      </inertial>
      <collision name='br_1_collision'>
        <pose relative_to='br_axle'>0 0 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>.072</radius>
            <length>.06</length>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode />
          </contact>
          <friction>
            <ode>
              <mu>1e+6</mu>
              <mu2>1e+6</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name='br_1_visual'>
        <pose>0.0 0.0 0.0 0 -0 0</pose>
        <geometry>
          <mesh>
            <scale>0.5 0.5 0.5</scale>
            <uri>model://ackermann_logistic_robot_harmonic/meshes/wheel.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <!--  <gravity>1</gravity> -->
      <!-- <velocity_decay/> -->
      <self_collide>0</self_collide>
    </link>

    <joint name='l_steer' type='revolute'>
      <pose relative_to='chassis_link'>-0.236 0.244 0.0 0 -0 0</pose>
      <parent>chassis_link</parent>
      <child>l_steer_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.95</lower>
          <upper>0.95</upper>
          <effort>1e6</effort>
          <velocity>10</velocity>
        </limit>
        <dynamics>
          <friction>18.0474092253</friction>
        </dynamics>
      </axis>
    </joint>
    <link name='l_steer_1'>
      <pose relative_to='l_steer'>0 0 0 0 -0 0</pose>
      <inertial>
        <pose>0.003381 0 0.02162 0 -0 0</pose>
        <mass>1</mass>
        <inertia>
          <ixx>1</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1</iyy>
          <iyz>0</iyz>
          <izz>1</izz>
        </inertia>
      </inertial>
      <!--  <gravity>1</gravity> -->
      <!-- <velocity_decay/> -->
      <self_collide>0</self_collide>
    </link>
    <joint name='fl_axle' type='revolute'>
      <pose relative_to='l_steer_1'>0 0 0 0 -0 0</pose>
      <parent>l_steer_1</parent>
      <child>fl_1</child>
      <axis>
        <xyz>-1 0 0</xyz>
        <dynamics>
          <friction>12.031606150200002</friction>
        </dynamics>
      </axis>
    </joint>
    <link name='fl_1'>
      <pose relative_to='fl_axle'>0 0 0 0 -0 0</pose>
      <inertial>
        <pose>-0.0377 0 -0 0 -0 0</pose>
        <mass>24.5</mass>
        <inertia>
          <ixx>1.84514</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.04961</iyy>
          <iyz>0</iyz>
          <izz>1.04961</izz>
        </inertia>
      </inertial>
      <collision name='fl_1_collision'>
        <pose>0.0 -0.0 0.0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>.072</radius>
            <length>.06</length>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode />
          </contact>
          <friction>
            <ode>
              <mu>1e+6</mu>
              <mu2>1e+6</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name='fl_1_visual'>
        <pose>0.0 -0.0 0.0 0 -0 0</pose>
        <geometry>
          <mesh>
            <scale>0.5 0.5 0.5</scale>
            <uri>model://ackermann_logistic_robot_harmonic/meshes/wheel.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <!--  <gravity>1</gravity> -->
      <!-- <velocity_decay/> -->
      <self_collide>0</self_collide>
    </link>

    <joint name='r_steer' type='revolute'>
      <pose relative_to='chassis_link'>0.236 0.244 0.0 0 -0 0</pose>
      <parent>chassis_link</parent>
      <child>r_steer_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.95</lower>
          <upper>0.95</upper>
          <effort>1e6</effort>
          <velocity>10</velocity>
        </limit>
        <dynamics>
          <damping>0.01</damping>
          <friction>18.0474092253</friction>
        </dynamics>
      </axis>
    </joint>
    <link name='r_steer_1'>
      <pose relative_to='r_steer'>0 0 0 0 -0 0</pose>
      <inertial>
        <pose>0.003381 0 0.02162 0 -0 0</pose>
        <mass>1</mass>
        <inertia>
          <ixx>1</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1</iyy>
          <iyz>0</iyz>
          <izz>1</izz>
        </inertia>
      </inertial>
      <!--  <gravity>1</gravity> -->
      <!-- <velocity_decay/> -->
      <self_collide>0</self_collide>
    </link>
    <joint name='fr_axle' type='revolute'>
      <pose relative_to='r_steer_1'>0 0 0 0 -0 0</pose>
      <parent>r_steer_1</parent>
      <child>fr_1</child>
      <axis>
        <xyz>-1 0 0</xyz>
        <dynamics>
          <friction>12.031606150200002</friction>
        </dynamics>
      </axis>
    </joint>
    <link name='fr_1'>
      <pose relative_to='fr_axle'>0 0 0 0 -0 0</pose>
      <inertial>
        <pose>-0.0377 0 -0 0 -0 0</pose>
        <mass>24.5</mass>
        <inertia>
          <ixx>1.84514</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.04961</iyy>
          <iyz>0</iyz>
          <izz>1.04961</izz>
        </inertia>
      </inertial>
      <collision name='fr_1_collision'>
        <pose>-0.0 -0.0 0.0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>.072</radius>
            <length>.06</length>
          </cylinder>
        </geometry>
        <surface>
          <contact>
            <ode />
          </contact>
          <friction>
            <ode>
              <mu>1e+6</mu>
              <mu2>1e+6</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name='fr_1_visual'>
        <pose>-0.0 -0.0 0.0 0 -0 0</pose>
        <geometry>
          <mesh>
            <scale>0.5 0.5 0.5</scale>
            <uri>model://ackermann_logistic_robot_harmonic/meshes/wheel.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <!--  <gravity>1</gravity> -->
      <!-- <velocity_decay/> -->
      <self_collide>0</self_collide>
    </link>

    <joint name="lift_joint" type="prismatic">
      <parent>base_link</parent>
      <child>lift_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0.0</lower>
          <upper>0.18</upper>
          <effort>20</effort>
          <velocity>0.5</velocity>
        </limit>
        <dynamics>
          <damping>0.1</damping>
          <friction>0</friction>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
      <physics>
          <provide_feedback>1</provide_feedback>
          <ode>
            <implicit_spring_damper>1</implicit_spring_damper>
            <cfm_damping>1</cfm_damping>
            <limit>
              <cfm>0</cfm>
              <erp>0.2</erp>
            </limit>
          </ode>
      </physics>
      <!-- <axis><use_parent_model_frame>true</use_parent_model_frame><xyz>0 0 1</xyz></axis><limit effort="6" lower="0.00" upper="0.100" velocity="50"/> -->
    </joint>
    <link name="lift_link">
      <pose relative_to='chassis_link'>0.0 0.0 0.165 0 -0 0</pose>
      <visual name="lift_visual">
        <geometry>
          <mesh>
            <uri>model://ackermann_logistic_robot_harmonic/meshes/platform.dae</uri>
            <scale>0.5 0.5 0.5</scale>
          </mesh>
      </geometry>
      </visual>
      <inertial>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0.000</ixy>
          <ixz>0.000</ixz>
          <iyy>0.001</iyy>
          <iyz>0.000</iyz>
          <izz>0.001</izz>
        </inertia>
        <mass>0.1</mass>
      </inertial>
      <collision name="lift_collision">
        <geometry>
          <box>
            <size>0.2805 0.2 0.03</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1000000</mu>
              <mu2>100000</mu2>
              <fdir1>0 0 0</fdir1>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <soft_cfm>0</soft_cfm>
              <soft_erp>0.2</soft_erp>
              <kp>1e+5</kp>
              <kd>1</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>

  <plugin filename="gz-sim-ackermann-steering-system"
          name="gz::sim::systems::AckermannSteering">

    <left_joint>bl_axle</left_joint>
    <right_joint>br_axle</right_joint>
    <left_joint>fl_axle</left_joint>
    <right_joint>fr_axle</right_joint>
    <left_steering_joint>l_steer</left_steering_joint>
    <right_steering_joint>r_steer</right_steering_joint>

    <kingpin_width>0.472</kingpin_width>
    <steering_limit>0.95</steering_limit>
    <wheel_base>0.488</wheel_base>
    <wheel_separation>0.072</wheel_separation>
    <wheel_radius>0.072</wheel_radius>

    <topic>/amazon_robot/cmd_vel</topic>

    <odom_topic>/amazon_robot/odom</odom_topic>
    <tf_topic>/amazon_robot/tf</tf_topic>
    <frame_id>odom</frame_id>
    <child_frame_id>chassis_link</child_frame_id>

    <odom_publish_frequency>100</odom_publish_frequency>
  </plugin>

    <plugin
      filename="gz-sim-joint-controller-system"
      name="gz::sim::systems::JointController">
      <joint_name>lift_joint</joint_name>
      <topic>/platform/cmd_vel</topic>
      <initial_position>0.0</initial_position>
      <use_force_commands>true</use_force_commands>
      
      <p_gain>5.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.1</d_gain>
      
      <cmd_max>20</cmd_max>
      <cmd_min>-20</cmd_min>
      
      <disable_braking>0</disable_braking>
    </plugin>

    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>/robot/joint_state</topic>
      <joint_name>lift_joint</joint_name>
    </plugin>
  </model>
</sdf>