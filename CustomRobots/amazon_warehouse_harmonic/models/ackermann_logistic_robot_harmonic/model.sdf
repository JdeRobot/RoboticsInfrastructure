      <self_collide>0</self_collide>
    </link>

    <joint name="lift_joint" type="prismatic">
      <parent>base_link</parent>
      <child>lift_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0.0</lower>
          <upper>0.25</upper>
          <effort>100</effort>
          <velocity>0.5</velocity>
        </limit>
        <dynamics>
          <damping>0.1</damping>
          <friction>0</friction>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
        <use_parent_model_frame>1</use_parent_model_frame>
      </axis>
      <physics>
          <provide_feedback>1</provide_feedback>
          <ode>
            <implicit_spring_damper>1</implicit_spring_damper>
            <cfm_damping>1</cfm_damping>
            <limit>
              <cfm>0</cfm>
              <erp>0.2</erp>
            </limit>
          </ode>
      </physics>
    </joint>

    <link name="lift_link">
      <pose relative_to='chassis_link'>0.0 0.0 0.165 0 0 0</pose>
      <inertial>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0.000</ixy>
          <ixz>0.000</ixz>
          <iyy>0.001</iyy>
          <iyz>0.000</iyz>
          <izz>0.001</izz>
        </inertia>
        <mass>0.1</mass>
      </inertial>
      <visual name="lift_visual">
        <pose>0 0 0 0 0 -1.5707963</pose>
        <geometry>
          <mesh>
            <uri>model://ackermann_logistic_robot_harmonic/meshes/platform.dae</uri>
            <scale>0.5 0.5 0.5</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="lift_collision">
        <pose>0 0 0 0 0 -1.5707963</pose>
        <geometry>
          <box>
            <size>0.2805 0.2 0.03</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1000000</mu>
              <mu2>100000</mu2>
              <fdir1>0 0 0</fdir1>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <soft_cfm>0</soft_cfm>
              <soft_erp>0.2</soft_erp>
              <kp>1e+7</kp>
              <kd>100</kd>
              <max_vel>0.001</max_vel>
              <min_depth>0.005</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>

    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <left_joint>bl_axle</left_joint>
      <right_joint>br_axle</right_joint>
      <left_steering_joint>l_steer</left_steering_joint>
      <right_steering_joint>r_steer</right_steering_joint>
      <kingpin_width>0.472</kingpin_width>
      <steering_limit>0.64</steering_limit>
      <wheel_base>0.488</wheel_base>
      <wheel_separation>0.36</wheel_separation>
      <wheel_radius>0.072</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/model/amazon_robot/odometry_noisy</odom_topic>
      <tf_topic>/model/amazon_robot/tf_noisy</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/model/amazon_robot/odometry</odom_topic>
      <dimensions>3</dimensions>
    </plugin>

    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>lift_joint</joint_name>
      <topic>/platform/cmd_vel</topic>
      <initial_position>0.0</initial_position>
      <use_force_commands>true</use_force_commands>
      <p_gain>5.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.1</d_gain>
      <cmd_max>100</cmd_max>
      <cmd_min>-100</cmd_min>
      <disable_braking>0</disable_braking>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/robot/joint_state</topic>
      <joint_name>lift_joint</joint_name>
    </plugin>
  </model>
</sdf>