<?xml version="1.0" ?>
<robot name="lincoln">
  <link name="base_link"/>
  <joint name="chassis_link_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
    <parent link="base_link"/>
    <child link="chassis_link"/>
  </joint>
  <link name="chassis_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1580"/>
      <inertia ixx="1997.86" ixy="-3e-05" ixz="-1e-06" iyy="442.769" iyz="62.5206" izz="2238.05"/>
    </inertial>
    <visual>
      <origin rpy="0 0 1.57" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://ackermann_cars/models/lincoln/meshes/body.dae" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin rpy="0 0 0" xyz="0 0 1.2"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="lidar_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 1.16"/>
      <inertia ixx="0.001" ixy="0.000" ixz="0.000" iyy="0.001" iyz="0.000" izz="0.001"/>
      <mass value="0.114"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 1.45"/>
      <geometry>
        <cylinder length="0.18" radius="0.0508"/>
      </geometry>
      <material>
        <ambient>0.0 0.0 0.0 1.0</ambient>
        <diffuse>0.0 0.0 0.0 1.0</diffuse>
        <specular>0.0 0.0 0.0 1.0</specular>
        <emissive>0.0 0.0 0.0 1.0</emissive>
      </material>
    </visual>
<visual>
      <origin rpy="0.000000 -0.000000 0.0000000" xyz="0 0 0"/>
      <geometry>
        <sphere radius="0.5"/>
      </geometry>
	    <material name="half_transparent">
                <color rgba="0 0 0 0"/>
            </material>
    </visual>

  </link>
  <joint name="bl_axle" type="revolute">
    <origin rpy="0 -0 0" xyz="-0.775 -1.33364 0.324997"/>
    <parent link="chassis_link"/>
    <child link="bl_1"/>
    <axis xyz="-1 0 0"/>
    <dynamics friction="12.031606150200002"/>
  </joint>
  <link name="bl_1">
    <origin rpy="0 -0 0" xyz="0 0 0"/>
    <inertial>
      <origin rpy="0 -0 0" xyz="-0.0377 0 -0"/>
      <mass value="24.5"/>
      <inertia ixx="1.84514" ixy="0" ixz="0" iyy="1.04961" iyz="0" izz="1.04961"/>
    </inertial>
    <visual>
      <origin rpy="0 -0 0" xyz="0.875 1.0136 0.1444"/>
      <geometry>
        <mesh filename="package://ackermann_cars/models/lincoln/meshes/back_left.dae" scale="0.1 0.1 0.1"/>
      </geometry>
    </visual>
  </link>
  <joint name="br_axle" type="revolute">
    <origin rpy="0 -0 0" xyz="0.775 -1.33364 0.324997"/>
    <parent link="chassis_link"/>
    <child link="br_1"/>
    <axis xyz="-1 0 0"/>
    <dynamics friction="12.031606150200002"/>
  </joint>
  <link name="br_1">
    <origin rpy="0 -0 0" xyz="0 0 0"/>
    <inertial>
      <origin rpy="0 -0 0" xyz="-0.0377 0 -0"/>
      <mass value="24.5"/>
      <inertia ixx="1.84514" ixy="0" ixz="0" iyy="1.04961" iyz="0" izz="1.04961"/>
    </inertial>
    <visual>
      <origin rpy="0 -0 0" xyz="-0.875 1.0136 0.1444"/>
      <geometry>
        <mesh filename="package://ackermann_cars/models/lincoln/meshes/back_right.dae" scale="0.1 0.1 0.1"/>
      </geometry>
    </visual>
  </link>
  <joint name="l_steer" type="revolute">
    <origin rpy="0 -0 0" xyz="-0.825 1.45736 0.324997"/>
    <parent link="chassis_link"/>
    <child link="l_steer_1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.95" upper="0.95"/>
    <dynamics friction="18.0474092253"/>
  </joint>
  <link name="l_steer_1">
    <origin rpy="0 -0 0" xyz="0 0 0"/>
