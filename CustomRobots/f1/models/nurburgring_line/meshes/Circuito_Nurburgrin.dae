  <library_effects>
    <effect id="material-effect">
      <profile_COMMON>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <color sid="diffuse">1 1 1 1</color>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
    <effect id="Asphalt_New-effect">
      <profile_COMMON>
        <newparam sid="Asphalt_New_jpg-surface">
          <surface type="2D">
            <init_from>Asphalt_New_jpg</init_from>
          </surface>
        </newparam>
        <newparam sid="Asphalt_New_jpg-sampler">
          <sampler2D>
            <source>Asphalt_New_jpg-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="Asphalt_New_jpg-sampler" texcoord="ID20"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.5</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
