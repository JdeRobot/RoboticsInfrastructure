<?xml version="1.0"?>
<sdf version="1.7">
  <model name="monaco_racing_lights">
    <static>true</static>
    <link name="lights_link">
      <visual name="racing_lights_frame">
        <geometry>
          <mesh><uri>model://monaco_racing_lights/meshes/racing_lights_frame.obj</uri></mesh>
        </geometry>
        <material>
          <ambient>0.12 0.14 0.18 1</ambient>
          <diffuse>0.16 0.19 0.24 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
      <visual name="racing_light_pods">
        <geometry>
          <mesh><uri>model://monaco_racing_lights/meshes/racing_lights_pods.obj</uri></mesh>
        </geometry>
        <material>
          <ambient>0.95 0.08 0.05 1</ambient>
          <diffuse>0.95 0.08 0.05 1</diffuse>
          <specular>0.35 0.20 0.20 1</specular>
          <emissive>0.95 0.08 0.05 1</emissive>
        </material>
      </visual>
      <visual name="tunnel_light_panels">
        <geometry>
          <mesh><uri>model://monaco_racing_lights/meshes/tunnel_light_panels.obj</uri></mesh>
        </geometry>
        <material>
          <ambient>0.98 0.98 0.92 1</ambient>
          <diffuse>0.98 0.98 0.92 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
          <emissive>0.95 0.95 0.88 1</emissive>
        </material>
      </visual>
    </link>
  </model>
</sdf>
