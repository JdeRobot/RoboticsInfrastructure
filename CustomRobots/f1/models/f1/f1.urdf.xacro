<?xml version="1.0" ?>
<robot name="f1"
  xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find custom_robots)/models/f1/f1_gz.urdf.xacro"/>
  <link name="f1">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <inertial>
      <mass value="10"/>
      <inertia ixx="1" ixy="0.0" ixz="0.0" iyy="1" iyz="0.0" izz="1.0"/>
    </inertial>
    <visual name="car">
      <geometry>
        <mesh filename="package://f1/models/f1/meshes/Car.obj" scale="0.2 0.2 0.2"/>
      </geometry>
    </visual>
  </link>

  <xacro:f1_camera xyzrpy="0.45 0.04 0.1 0 0 0" name="cam_f1_left"/>
  <xacro:f1_velocity topic="/F1ROS/cmd_vel"/>
  <xacro:f1_odom topic="/F1ROS/odom"/>
</robot>
