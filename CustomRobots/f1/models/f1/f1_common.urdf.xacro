<?xml version="1.0"?>
<robot name="f1"
  xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find custom_robots)/models/f1/f1_gz.urdf.xacro" />

  <material name="F1Blue">
    <color rgba="0.1 0.3 0.9 1.0" />
  </material>
  <material name="F1Red">
    <color rgba="0.9 0.1 0.1 1.0" />
  </material>
  <material name="F1Magenta">
    <color rgba="1.0 0.0 1.0 1.0" />
  </material>
  <material name="F1Yellow">
    <color rgba="1.0 0.85 0.0 1.0" />
  </material>
  <material name="F1Green">
    <color rgba="0.0 0.75 0.2 1.0" />
  </material>

  <!-- Colours the car without replacing the mesh materials -->
  <xacro:macro name="f1_color_marker" params="parent color box_size origin_xyz">
    <link name="color_marker">
      <inertial>
        <mass value="0.01" />
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5" />
      </inertial>
      <visual>
        <geometry>
          <box size="${box_size}" />
        </geometry>
        <material name="${color}" />
      </visual>
    </link>

    <joint name="color_marker_joint" type="fixed">
      <origin rpy="0 0 0" xyz="${origin_xyz}" />
      <parent link="${parent}" />
      <child link="color_marker" />
    </joint>
  </xacro:macro>

  <xacro:macro name="holonomic" params="namespace color:=''">

    <link name="base">
      <origin rpy="0 0 0" xyz="0 0 0" />
      <inertial>
        <mass value="10" />
        <inertia ixx="1" ixy="0.0" ixz="0.0" iyy="1" iyz="0.0" izz="1.0" />
      </inertial>

      <collision>
        <geometry>
          <mesh filename="file://$(find custom_robots)/models/f1/meshes/Car.obj" scale="0.2 0.2 0.2" />
        </geometry>
      </collision>
      <visual name="car">
        <geometry>
          <mesh filename="file://$(find custom_robots)/models/f1/meshes/Car.obj" scale="0.2 0.2 0.2" />
        </geometry>
      </visual>
    </link>

    <xacro:if value="${color != ''}">
      <xacro:f1_color_marker parent="base" color="${color}"
        box_size="0.07 0.33 0.025" origin_xyz="-0.44 0 0.228" />
    </xacro:if>

    <xacro:f1_velocity topic="/${namespace}/cmd_vel" />
    <xacro:f1_odom topic="/${namespace}/odom" freq="50" />
  </xacro:macro>

  <xacro:macro name="ackermann" params="namespace color:=''">

    <link name="base" />

    <joint name="chassis_link_joint" type="fixed">
      <origin rpy="0 0 -1.5708" xyz="0.0 0.0 0.0" />
      <parent link="base" />
      <child link="chassis_link" />
    </joint>

    <link name="chassis_link">
      <inertial>
        <origin rpy="0 0 0" xyz="0 0.014614 0.130192" />
        <mass value="1580" />
        <inertia ixx="1997.86" ixy="-3e-05" ixz="-1e-06" iyy="442.769" iyz="62.5206" izz="2238.05" />
      </inertial>
      <collision>
        <origin rpy="1.5708 0 1.5708" xyz="0 0.302 0" />
        <geometry>
          <mesh filename="file://$(find custom_robots)/models/f1/meshes/chasis.obj" scale="1 1 1" />
        </geometry>
      </collision>
      <visual>
        <origin rpy="1.5708 0 1.5708" xyz="0 0.302 0" />
        <geometry>
          <mesh filename="file://$(find custom_robots)/models/f1/meshes/chasis.obj" scale="1 1 1" />
        </geometry>
      </visual>
    </link>

    <joint name="bl_axle" type="continuous">
      <origin rpy="0 0 0" xyz="-0.155 -0.366728 0.0649994" />
      <parent link="chassis_link" />
      <child link="bl_1" />
      <axis xyz="1 0 0" />
      <limit effort="1000" velocity="100" />
      <dynamics friction="12.031606150200002" />
    </joint>

    <link name="bl_1">
      <origin rpy="0 -0 0" xyz="0 0 0" />
      <inertial>
        <origin rpy="0 -0 0" xyz="-0.0377 0 -0" />
        <mass value="24.5" />
        <inertia ixx="1.84514" ixy="0" ixz="0" iyy="1.04961" iyz="0" izz="1.04961" />
      </inertial>
      <collision>
        <origin rpy="0 1.5708 0" xyz="0 0 0" />
        <geometry>
          <cylinder length="0.0685" radius="0.066" />
        </geometry>
      </collision>
      <visual>
        <origin rpy="0 0 0" xyz="0.175 0.028 -0.20252" />
        <geometry>
          <mesh filename="file://$(find custom_robots)/models/f1/meshes/back_left.obj"
            scale="0.02 0.02 0.02" />
        </geometry>
      </visual>
    </link>

    <joint name="br_axle" type="continuous">
      <origin rpy="0 0 0" xyz="0.155 -0.366728 0.0649994" />
      <parent link="chassis_link" />
      <child link="br_1" />
      <axis xyz="-1 0 0" />
      <limit effort="1000" velocity="100" />
      <dynamics friction="12.031606150200002" />
    </joint>

    <link name="br_1">
      <origin rpy="0 0 0" xyz="0 0 0" />
      <inertial>
        <origin rpy="0 -0 0" xyz="-0.0377 0 -0" />
        <mass value="24.5" />
        <inertia ixx="1.84514" ixy="0" ixz="0" iyy="1.04961" iyz="0" izz="1.04961" />
      </inertial>
      <collision>
        <origin rpy="0 1.5708 0" xyz="0 0 0" />
        <geometry>
          <cylinder length="0.0685" radius="0.066" />
        </geometry>
      </collision>
      <visual>
        <origin rpy="0 0 0" xyz="-0.175 0.028 -0.20252" />
        <geometry>
          <mesh filename="file://$(find custom_robots)/models/f1/meshes/back_right.obj"
            scale="0.02 0.02 0.02" />
        </geometry>
      </visual>
    </link>

    <joint name="front_steering" type="revolute">
      <origin rpy="0 0 0" xyz="0 0.303472 0.0649994" />
      <parent link="chassis_link" />
      <child link="front_steering_link" />
      <axis xyz="0 0 1" />
      <limit lower="-5" upper="5" effort="1000" velocity="100" />
      <dynamics friction="0.5" />
    </joint>

    <link name="front_steering_link">
      <origin rpy="0 -0 0" xyz="0 0 0" />
      <inertial>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <mass value="2" />
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
      </inertial>
    </link>

    <joint name="fl_axle" type="continuous">
      <origin rpy="0 -0 0" xyz="-0.165 0 0" />
      <parent link="front_steering_link" />
      <child link="fl_1" />
      <axis xyz="-1 0 0" />
      <limit effort="1000" velocity="100" />
      <dynamics friction="12.031606150200002" />
    </joint>

    <link name="fl_1">
      <origin rpy="0 -0 0" xyz="0 0 0" />
      <inertial>
        <origin rpy="0 -0 0" xyz="-0.0377 0 -0" />
        <mass value="24.5" />
        <inertia ixx="1.84514" ixy="0" ixz="0" iyy="1.04961" iyz="0" izz="1.04961" />
      </inertial>
      <collision>
        <origin rpy="0 1.5708 0" xyz="0 0 0" />
        <geometry>
          <cylinder length="0.0685" radius="0.066" />
        </geometry>
      </collision>
      <visual>
        <origin rpy="0 0 0" xyz="0.175 0.02888 0.30348" />
        <geometry>
          <mesh filename="file://$(find custom_robots)/models/f1/meshes/front_left.obj"
            scale="0.02 0.02 0.02" />
        </geometry>
      </visual>
    </link>


    <joint name="fr_axle" type="continuous">
      <origin rpy="0 -0 0" xyz="0.165 0 0" />
      <parent link="front_steering_link" />
      <child link="fr_1" />
      <axis xyz="-1 0 0" />
      <limit effort="1000" velocity="100" />
      <dynamics friction="12.031606150200002" />
    </joint>

    <link name="fr_1">
      <origin rpy="0 0 0" xyz="0 0 0" />
      <inertial>
        <origin rpy="0 0 0" xyz="-0.0377 0 0" />
        <mass value="24.5" />
        <inertia ixx="1.84514" ixy="0" ixz="0" iyy="1.04961" iyz="0" izz="1.04961" />
      </inertial>
      <collision>
        <origin rpy="0 1.5708 0" xyz="0 0 0" />
        <geometry>
          <cylinder length="0.0685" radius="0.066" />
        </geometry>
      </collision>
      <visual>
        <origin rpy="0 0 0" xyz="-0.175 0.02888 0.30348" />
        <geometry>
          <mesh
            filename="file:///home/ws/install/custom_robots/share/custom_robots/models/f1/meshes/front_right.obj"
            scale="0.02 0.02 0.02" />
        </geometry>
      </visual>
    </link>

    <!-- <joint name="steering_joint" type="revolute">
      <origin rpy="0 0 0" xyz="-0.01 0.6 0.6"/>
      <parent link="chassis_link"/>
      <child link="steering_wheel"/>
      <axis xyz="0.0 -1.0 0.0"/>
      <limit lower="-5" upper="5"/>
      <dynamics damping="10.0"/>
    </joint>

    <link name="steering_wheel">
      <origin rpy="0 0 1.5708" xyz="0 0.87 -0.54"/>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="file://$(find custom_robots)/models/f1/meshes/steering_wheel.dae" scale="4.7 4.7
    4.7"/>
        </geometry>
      </visual>
    </link> -->

    <xacro:if value="${color != ''}">
      <xacro:f1_color_marker parent="chassis_link" color="${color}"
        box_size="0.33 0.07 0.025" origin_xyz="0 -0.45 0.232" />
    </xacro:if>

    <xacro:f1_ackermann_steering topic="/${namespace}/cmd_vel" />
    <xacro:f1_joints />
    <xacro:f1_odom topic="/${namespace}/odom" freq="50" />
    <!-- <xacro:f1_steer_controller topic="/model/f1_renault_ackermann_harmonic/steering_wheel_cmd"
    joint="steering_joint"/> -->
  </xacro:macro>
</robot>