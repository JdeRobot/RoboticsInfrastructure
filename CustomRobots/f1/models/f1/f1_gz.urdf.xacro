<?xml version="1.0"?>
<robot name="f1_gz"
  xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="f1_camera" params="xyz rpy name parent namespace">

    <link name="${name}_link">
      <visual>
        <geometry>
          <sphere radius="0.005"/>
        </geometry>
      </visual>
    </link>

    <joint name="${name}_to_${parent}" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <gazebo reference="${name}_link">
      <sensor name="${name}" type="camera">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>20.000000</update_rate>
        <topic>/${namespace}/${name}/image_raw</topic>
        <camera name="cleft">
          <camera_info_topic>/${namespace}/${name}/camera_info</camera_info_topic>
          <horizontal_fov>1.570000</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.100000</near>
            <far>15.000000</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="f1_laser" params="xyz rpy name parent namespace">
    <link name="${name}_link">
      <visual>
        <geometry>
          <mesh filename="file://$(find custom_robots)/models/f1/meshes/hokuyo.dae"/>
        </geometry>
      </visual>
    </link>

    <joint name="${name}_to_${parent}" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <gazebo reference="${name}_link">
      <sensor name="laser" type="gpu_lidar">
        <always_on>1</always_on>
        <visualize>1</visualize>
        <update_rate>20</update_rate>
        <topic>/${namespace}/laser/scan</topic>
        <gz_frame_id>base_scan</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>180</samples>
              <resolution>1</resolution>
              <min_angle>-1.570000</min_angle>
              <max_angle>1.570000</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.080000</min>
            <max>10.000000</max>
            <resolution>0.010000</resolution>
          </range>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="f1_velocity" params="topic">
    <gazebo>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>${topic}</topic>
      </plugin>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="f1_ackermann_steering" params="topic">
    <gazebo>
      <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
        <left_joint>fl_axle</left_joint>
        <left_joint>bl_axle</left_joint>
        <right_joint>fr_axle</right_joint>
        <right_joint>br_axle</right_joint>
        <left_steering_joint>front_steering</left_steering_joint>
        <right_steering_joint>front_steering</right_steering_joint>
        <kingpin_width>1.65</kingpin_width>
        <steering_limit>0.3</steering_limit>
        <wheel_base>3.351</wheel_base>
        <wheel_separation>1.65</wheel_separation>
        <wheel_radius>0.3425</wheel_radius>
        <!-- <sub_topic>${topic}/steer_angle</sub_topic> -->
        <min_velocity>-50</min_velocity>
        <max_velocity>50</max_velocity>
        <min_acceleration>-50</min_acceleration>
        <max_acceleration>50</max_acceleration>
        <topic>${topic}</topic>
      </plugin>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="f1_odom" params="topic freq">
    <gazebo>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>chassis_link</robot_base_frame>
        <odom_publish_frequency>${freq}</odom_publish_frequency>
        <odom_topic>${topic}</odom_topic>
        <dimensions>3</dimensions>
      </plugin>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="f1_joints">
    <gazebo>
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <joint_name>fl_axle</joint_name>
        <joint_name>fr_axle</joint_name>
        <joint_name>bl_axle</joint_name>
        <joint_name>br_axle</joint_name>
        <joint_name>front_steering</joint_name>
        <!-- <joint_name>steering_joint</joint_name> -->
      </plugin>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="f1_steer_controller" params="topic joint">
    <gazebo>
      <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
        <joint_name>${joint}</joint_name>
        <sub_topic>${topic}</sub_topic>
        <p_gain>10</p_gain>
        <i_gain>0.1</i_gain>
        <d_gain>1</d_gain>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
