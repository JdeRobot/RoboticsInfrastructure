<?xml version="1.0" ?>
<robot name="f1"
  xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find custom_robots)/models/f1/f1_gz.urdf.xacro"/>
  <xacro:include filename="$(find custom_robots)/models/f1/f1.urdf.xacro"/>

  <xacro:holonomic/>
  <xacro:f1_laser xyz="0.5 0 0.072" rpy="0 0 0" name="laser" parent="base"/>
</robot>
