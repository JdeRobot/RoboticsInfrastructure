<?xml version="1.0"?>
<sdf version="1.7">
  <model name="circuito">
    <static>true</static> <!-- Cambia a false si es un objeto dinámico -->
    <link name="link">
      <visual name="grass">
        <geometry>
          <mesh>
            <uri>model://monaco/meshes/monaco.dae</uri>
            <scale>0.2 0.2 0.2</scale>
          </mesh>
        </geometry>
      </visual>

      <visual name="track">
        <geometry>
          <mesh>
            <uri>model://monaco/meshes/monaco_track.dae</uri>
            <scale>0.2 0.2 0.2</scale>
          </mesh>
        </geometry>
      </visual>

      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://monaco/meshes/monaco_track.dae</uri>
            <scale>0.2 0.2 0.2</scale>
          </mesh>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
