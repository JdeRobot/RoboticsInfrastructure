<?xml version='1.0'?>
<sdf version="1.10">
<model name="f1_renault_laser_no_cam_harmonic">
  <pose>0 0 0 0 0 0</pose>
  <static>false</static>
  
    <link name="f1">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>10</mass>
        <inertia>
          <ixx>1</ixx>
          <ixy>0.0</ixy>
          <iyy>1</iyy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
          <izz>1.0</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry>
          <mesh>
            <uri>model://f1_renault_laser_no_cam_harmonic/Renault/Car.obj</uri>
            <scale>0.2 0.2 0.2</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://f1_renault_laser_no_cam_harmonic/Renault/Car.obj</uri>
            <scale>0.2 0.2 0.2</scale>
          </mesh>
        </geometry>
      </visual>
      <self_collide>false</self_collide>
    </link>

    <link name='laser_body'>
      <pose>0.500000 0.000000 0.072000 0.000000 0.000000 0.00000</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0.0</ixy>
          <iyy>0.001</iyy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <visual name="visual_laser">
        <geometry>
          <mesh>
            <uri>model://f1_renault_laser_no_cam_harmonic/meshes/hokuyo.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <sensor name='laser' type='gpu_ray'>
        <pose>0 0 0 0 0 0</pose>
        <ray>
          <scan>
            <horizontal>
              <samples>180</samples>
              <resolution>1.000000</resolution>
              <min_angle>-1.570000</min_angle>
              <max_angle>1.570000</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.080000</min>
            <max>10.000000</max>
            <resolution>0.010000</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <update_rate>20.000000</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <topic>/f1/laser/scan</topic>
      </sensor>
      <self_collide>false</self_collide>
    </link>
    
    <joint type="fixed" name="laser_fix">
      <pose>0 0 0 0 0 0</pose>
      <child>laser_body</child>
      <parent>f1</parent>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <!-- Gazebo Harmonic Plugins -->
    
    <!-- Odometry Publisher -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_topic>/f1/odom</odom_topic>
      <robot_base_frame>f1</robot_base_frame>
      <odom_frame>odom</odom_frame>
      <odom_publish_frequency>20.0</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>

    <!-- Odometry Publisher (removed since DiffDrive handles it) -->
    
    <!-- Pose Publisher -->
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <update_frequency>20</update_frequency>
    </plugin>

    <!-- Joint State Publisher -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>laser_fix</joint_name>
    </plugin>

</model>
</sdf>