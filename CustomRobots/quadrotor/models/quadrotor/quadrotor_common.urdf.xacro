<?xml version="1.0" ?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find custom_robots)/models/quadrotor/quadrotor_gz.urdf.xacro"/>

  <xacro:macro name="quadrotor">
    <gazebo>
      <include merge="true">
        <uri>model://quadrotor_base</uri>
      </include>
    </gazebo>

    <xacro:imu/>
    <xacro:velocity namespace="drone0"/>
    <xacro:tf freq="100"/>
    <xacro:odom topic="/drone0/odom" freq="100"/>
    <xacro:motors namespace="drone0"/>
  </xacro:macro>
</robot>
