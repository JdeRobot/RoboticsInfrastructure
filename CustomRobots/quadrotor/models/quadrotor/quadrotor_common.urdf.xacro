<?xml version="1.0" ?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find custom_robots)/models/quadrotor/quadrotor_gz.urdf.xacro"/>

  <material name="Red">
    <color rgba="1 0 0 1.0"/>
  </material>

  <material name="Blue">
    <color rgba="0 0 1 1.0"/>
  </material>

  <material name="Green">
    <color rgba="0 0.8 0 1.0"/>
  </material>

  <material name="Yellow">
    <color rgba="1 0.9 0 1.0"/>
  </material>

  <material name="Orange">
    <color rgba="1 0.5 0 1.0"/>
  </material>

  <material name="White">
    <color rgba="1 1 1 1.0"/>
  </material>

  <material name="Magenta">
    <color rgba="1 0 1 1.0"/>
  </material>

  <xacro:macro name="rotor" params="rotor parent xyz color scale:='1.0'">
    <link name='rotor_${rotor}'>
      <inertial>
        <mass value="0.005"/>
        <inertia ixx="9.75e-07" ixy="0" ixz="0" iyy="4.17041e-05" iyz="0" izz="4.26041e-05"/>
      </inertial>

      <collision>
        <geometry>
          <cylinder length="${0.005 * scale}" radius="${0.1 * scale}"/>
        </geometry>
      </collision>
      <visual>
        <geometry>
          <mesh filename="$(find as2_gazebo_assets)/models/quadrotor_base/meshes/propeller_ccw.dae" scale="${0.1 * scale} ${0.1 * scale} ${0.1 * scale}"/>
        </geometry>
        <material name="${color}"/>
      </visual>
      <gravity>1</gravity>
      <velocity_decay/>
    </link>

    <joint name='rotor_${rotor}_joint' type="revolute">
      <origin rpy="0 0 0" xyz="${xyz}"/>
      <parent link="${parent}"/>
      <child link="rotor_${rotor}"/>
      <axis xyz="0 0 1" expressed_in="__model__"/>
      <limit lower="-1e+16" upper="1e+16" effort="1000" velocity="100"/>
      <dynamics spring_reference="0" spring_stiffness="0" friction="0" damping="0"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="quadrotor" params="namespace color:='' scale:='1.0'">

    <!-- This is from quadrotor_base from as2 -->
    <link name="base_link">
      <gazebo>
        <enable_wind>true</enable_wind>
      </gazebo>
      <inertial>
        <mass value="1.5"/>
        <inertia ixx="0.025" ixy="0" ixz="0" iyy="0.009" iyz="0" izz="0.033"/>
      </inertial>
      <collision>
        <geometry>
          <box size="${0.47 * scale} ${0.47 * scale} ${0.11 * scale}"/>
        </geometry>
      </collision>
      <visual>
        <geometry>
          <mesh filename="$(find as2_gazebo_assets)/models/quadrotor_base/meshes/quadrotor.dae" scale="${scale} ${scale} ${scale}"/>
        </geometry>
        <xacro:if value="${color != ''}">
          <material name="${color}"/>
        </xacro:if>
      </visual>

      <visual name='marker_visual_1'>
        <origin rpy="0 0 0" xyz="${-0.07*scale} 0 ${0.065*scale}"/>
        <geometry>
          <mesh filename="$(find as2_gazebo_assets)/models/quadrotor_base/meshes/led.dae" scale="${scale} ${scale} ${scale}"/>
        </geometry>
      </visual>

      <visual name='marker_visual_2'>
        <origin rpy="-1.0472 -0 0.2" xyz="${-0.08*scale} ${0.037*scale} ${0.04*scale}"/>
        <geometry>
          <mesh filename="$(find as2_gazebo_assets)/models/quadrotor_base/meshes/led.dae" scale="${scale} ${scale} ${scale}"/>
        </geometry>
      </visual>

      <visual name='marker_visual_3'>
        <origin rpy="1.0472 -0 -0.1" xyz="${-0.08*scale} ${-0.035*scale} ${0.04*scale}"/>
        <geometry>
          <mesh filename="$(find as2_gazebo_assets)/models/quadrotor_base/meshes/led.dae" scale="${scale} ${scale} ${scale}"/>
        </geometry>
      </visual>
    </link>

    <xacro:rotor rotor="0" parent="base_link" xyz="${0.13*scale} ${-0.22*scale} ${0.023*scale}" color="Blue" scale="${scale}"/>
    <xacro:rotor rotor="1" parent="base_link" xyz="${-0.13*scale} ${0.2*scale} ${0.023*scale}" color="Red" scale="${scale}"/>
    <xacro:rotor rotor="2" parent="base_link" xyz="${0.13*scale} ${0.22*scale} ${0.023*scale}" color="Blue" scale="${scale}"/>
    <xacro:rotor rotor="3" parent="base_link" xyz="${-0.13*scale} ${-0.2*scale} ${0.023*scale}" color="Red" scale="${scale}"/>

    <xacro:tf freq="100" namespace="${namespace}"/>
    <xacro:imu mass="0.005" parent="base_link" namespace="${namespace}"/>
    <xacro:odom freq="100" namespace="${namespace}"/>
    <xacro:motors namespace="${namespace}"/>
    <xacro:velocity namespace="${namespace}"/>
  </xacro:macro>
</robot>
