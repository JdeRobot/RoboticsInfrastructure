<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

  <!-- The wheels are passive rollers and VelocityControl moves the chassis directly -->
  <xacro:macro name="wheel_slip" params="wheel_link fdir1">
    <gazebo>
      <plugin filename="libgz-sim-wheel-slip-system.so" name="gz::sim::systems::WheelSlip">
        <wheel link_name="${wheel_link}">
          <slip_compliance_lateral>1.0</slip_compliance_lateral>
          <slip_compliance_longitudinal>1.0</slip_compliance_longitudinal>
          <wheel_normal_force>20</wheel_normal_force>
          <wheel_radius>0.05</wheel_radius>
        </wheel>
      </plugin>
    </gazebo>

    <gazebo reference="${wheel_link}">
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.0</mu2>
              <fdir1 gz:expressed_in="base_footprint">${fdir1}</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </gazebo>
  </xacro:macro>

  <!-- Limits the ODE correction impulse when the chassis bumps into something -->
  <gazebo reference="chassis">
    <collision>
      <surface>
        <contact>
          <ode>
            <max_vel>0.2</max_vel>
            <min_depth>0.001</min_depth>
          </ode>
        </contact>
      </surface>
    </collision>
  </gazebo>

  <!-- Collide non adjacent links of the model, so arms cannot cross the tray or each other -->
  <gazebo>
    <self_collide>true</self_collide>
  </gazebo>

  <xacro:macro name="velocity" params="namespace">
    <gazebo>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/${namespace}/cmd_vel</topic>
      </plugin>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="odom" params="namespace">
    <gazebo>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
        <odom_publish_frequency>50</odom_publish_frequency>
        <odom_topic>/${namespace}/odom</odom_topic>
        <dimensions>3</dimensions>
      </plugin>
    </gazebo>
  </xacro:macro>

  <!-- Head RGBD camera -->
  <xacro:macro name="rgbd_camera" params="link name namespace">
    <gazebo reference="${link}">
      <sensor name="${name}" type="rgbd_camera">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>15</update_rate>
        <topic>/${namespace}/${name}</topic>
        <camera name="${name}">
          <camera_info_topic>/${namespace}/${name}/camera_info</camera_info_topic>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>8.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- Joint interfaces of one arm, called once per suffix -->
  <xacro:macro name="arm_joint_interfaces" params="suffix">
    <joint name="Rotation_${suffix}">
      <command_interface name="position"><param name="min">-2.16</param><param name="max">2.16</param></command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="Pitch_${suffix}">
      <command_interface name="position"><param name="min">-0.22</param><param name="max">3.37</param></command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="Elbow_${suffix}">
      <command_interface name="position"><param name="min">-0.22</param><param name="max">3.14</param></command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="Wrist_Pitch_${suffix}">
      <command_interface name="position"><param name="min">-1.6580628</param><param name="max">1.6580627</param></command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="Wrist_Roll_${suffix}">
      <command_interface name="position"><param name="min">-2.7438473</param><param name="max">2.8412063</param></command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="Jaw_${suffix}">
      <command_interface name="position"><param name="min">-0.374533</param><param name="max">1.7453292</param></command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <!-- Single ros2_control block for both arms, both grippers and the head -->
  <xacro:macro name="arm_ros2_control" params="simulation_controllers namespace">
    <ros2_control name="xlerobot_arms" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>

      <xacro:arm_joint_interfaces suffix="L"/>
      <xacro:arm_joint_interfaces suffix="R"/>

      <joint name="head_pan_joint">
        <command_interface name="position"><param name="min">-3.2</param><param name="max">3.2</param></command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="head_tilt_joint">
        <command_interface name="position"><param name="min">-0.76</param><param name="max">1.45</param></command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- Wheels are state only because MoveIt waits for every joint of the URDF -->
      <joint name="wheel_1_joint">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="wheel_2_joint">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="wheel_3_joint">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <!-- Same namespace as robot_state_publisher -->
        <ros>
          <namespace>${namespace}</namespace>
        </ros>
        <parameters>${simulation_controllers}</parameters>
      </plugin>
    </gazebo>
  </xacro:macro>

  <!-- Contact sensor on a gripper jaw for gz_link_attacher -->
  <xacro:macro name="suction_contact" params="link">
    <gazebo reference="${link}">
      <sensor name="suction_contact" type="contact">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <contact>
          <collision>${link}_collision</collision>
          <collision>${link}_collision_1</collision>
          <collision>${link}_collision_2</collision>
        </contact>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- RGB wrist camera -->
  <xacro:macro name="wrist_camera" params="link name namespace">
    <gazebo reference="${link}">
      <sensor name="${name}" type="camera">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>15</update_rate>
        <topic>/${namespace}/${name}/image_raw</topic>
        <camera name="${name}">
          <camera_info_topic>/${namespace}/${name}/camera_info</camera_info_topic>
          <horizontal_fov>1.5</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>5.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>
