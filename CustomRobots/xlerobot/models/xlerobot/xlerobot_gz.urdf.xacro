<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

  <!-- The 3 wheels are passive rollers, real locomotion authority comes from
       VelocityControl moving the chassis directly, same approach as dingo -->
  <xacro:macro name="wheel_slip" params="wheel_link fdir1">
    <gazebo>
      <plugin filename="libgz-sim-wheel-slip-system.so" name="gz::sim::systems::WheelSlip">
        <wheel link_name="${wheel_link}">
          <slip_compliance_lateral>1.0</slip_compliance_lateral>
          <slip_compliance_longitudinal>1.0</slip_compliance_longitudinal>
          <wheel_normal_force>20</wheel_normal_force>
          <wheel_radius>0.05</wheel_radius>
        </wheel>
      </plugin>
    </gazebo>

    <gazebo reference="${wheel_link}">
      <collision>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>0.0</mu2>
              <fdir1 gz:expressed_in="base_footprint">${fdir1}</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </gazebo>
  </xacro:macro>

  <!-- Safety net, not a substitute for not colliding: caps how hard ODE is
       allowed to shove interpenetrating bodies apart in a single step. A
       real bump against the table (chassis is the only link here with
       collision geometry near the tray, top_base_link/the basket mesh has
       none) otherwise resolves as a single large correction impulse that
       shows up as the whole kinematic chain (arms included) jumping/
       jittering, since they all ride on the chassis. max_vel/min_depth are
       the standard ODE knobs for this, does not change normal driving. -->
  <gazebo reference="chassis">
    <collision>
      <surface>
        <contact>
          <ode>
            <max_vel>0.2</max_vel>
            <min_depth>0.001</min_depth>
          </ode>
        </contact>
      </surface>
    </collision>
  </gazebo>

  <!-- Gazebo does not collide the links of one model with each other unless
       asked, so the arms passed straight through the tray, the mast and each
       other wherever MoveIt was not planning the move (readyPose, the tray
       poses). With this on, non adjacent links collide, the same pairs MoveIt
       already checks. Fixed joints get lumped into their parent when the
       URDF is converted, so the chassis, tray, mast and both arm mounts are
       one body and never collide among themselves, and jointed neighbours
       (shoulder/chassis, upper arm/forearm, ...) are skipped by the engine.
       Checked offline against the collision geometry in the zero, ready,
       grasp, pre-approach and tray poses: no non adjacent pair overlaps.
       To turn it off again, remove this block. -->
  <gazebo>
    <self_collide>true</self_collide>
  </gazebo>

  <xacro:macro name="velocity" params="namespace">
    <gazebo>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/${namespace}/cmd_vel</topic>
      </plugin>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="odom" params="namespace">
    <gazebo>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
        <odom_publish_frequency>50</odom_publish_frequency>
        <odom_topic>/${namespace}/odom</odom_topic>
        <dimensions>3</dimensions>
      </plugin>
    </gazebo>
  </xacro:macro>

  <!-- head RGBD camera, one sensor gives color image, depth image and a point cloud together -->
  <xacro:macro name="rgbd_camera" params="link name namespace">
    <gazebo reference="${link}">
      <sensor name="${name}" type="rgbd_camera">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>15</update_rate>
        <topic>/${namespace}/${name}</topic>
        <camera name="${name}">
          <camera_info_topic>/${namespace}/${name}/camera_info</camera_info_topic>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>8.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- One arm side worth of ros2_control joint interfaces, called once per suffix (L/R) -->
  <xacro:macro name="arm_joint_interfaces" params="suffix">
    <joint name="Rotation_${suffix}">
      <command_interface name="position"><param name="min">-2.16</param><param name="max">2.16</param></command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="Pitch_${suffix}">
      <command_interface name="position"><param name="min">-0.22</param><param name="max">3.37</param></command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="Elbow_${suffix}">
      <command_interface name="position"><param name="min">-0.22</param><param name="max">3.14</param></command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="Wrist_Pitch_${suffix}">
      <command_interface name="position"><param name="min">-1.6580628</param><param name="max">1.6580627</param></command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="Wrist_Roll_${suffix}">
      <command_interface name="position"><param name="min">-2.7438473</param><param name="max">2.8412063</param></command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="Jaw_${suffix}">
      <command_interface name="position"><param name="min">-0.374533</param><param name="max">1.7453292</param></command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <!-- Single ros2_control block for both arms, both grippers and the head, on purpose.
       Splitting this into several separate ros2_control tags made gz_ros2_control crash
       while loading the second one when the same thing was tried on the Dobot arm, so
       every actuated joint that is not a wheel lives in this one block -->
  <xacro:macro name="arm_ros2_control" params="simulation_controllers namespace">
    <ros2_control name="xlerobot_arms" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>

      <xacro:arm_joint_interfaces suffix="L"/>
      <xacro:arm_joint_interfaces suffix="R"/>

      <joint name="head_pan_joint">
        <command_interface name="position"><param name="min">-3.2</param><param name="max">3.2</param></command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="head_tilt_joint">
        <command_interface name="position"><param name="min">-0.76</param><param name="max">1.45</param></command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- state only, on purpose, the wheels stay driven kinematically by
           VelocityControl not by ros2_control, but MoveGroupInterface (used
           by robmove/robpose/move_group) waits for a JointState covering
           every joint in the URDF before it considers the robot state
           "complete", wheels included, even though no SRDF group ever plans
           for them. Without this it hangs forever repeating "The complete
           state of the robot is not yet known, missing wheel_1_joint...".
           Folding them into the same joint_state_broadcaster that already
           covers the arms is what actually gets them onto
           /<namespace>/joint_states, the one topic MoveIt listens to -->
      <joint name="wheel_1_joint">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="wheel_2_joint">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="wheel_3_joint">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <!-- robot_state_publisher runs under this same namespace, without this the
             plugin looks for a bare, unnamespaced robot_state_publisher node and just
             hangs forever waiting for a service that is never going to answer -->
        <ros>
          <namespace>${namespace}</namespace>
        </ros>
        <parameters>${simulation_controllers}</parameters>
      </plugin>
    </gazebo>
  </xacro:macro>

  <!-- Contact sensor on a gripper jaw, feeds gz_link_attacher's "suction mode"
       code path. gz_link_attacher only knows Robotiq's 2-finger link names by
       default, this repurposes its generic gripper_link_name option (it was
       already there for real suction grippers) so a plain parallel jaw like
       ours gets the same auto-attach behaviour without touching that C++ -->
  <xacro:macro name="suction_contact" params="link">
    <gazebo reference="${link}">
      <sensor name="suction_contact" type="contact">
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <contact>
          <collision>${link}_collision</collision>
          <collision>${link}_collision_1</collision>
          <collision>${link}_collision_2</collision>
        </contact>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!-- plain RGB wrist camera -->
  <xacro:macro name="wrist_camera" params="link name namespace">
    <gazebo reference="${link}">
      <sensor name="${name}" type="camera">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>15</update_rate>
        <topic>/${namespace}/${name}/image_raw</topic>
        <camera name="${name}">
          <camera_info_topic>/${namespace}/${name}/camera_info</camera_info_topic>
          <horizontal_fov>1.5</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.02</near>
            <far>5.0</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

</robot>
