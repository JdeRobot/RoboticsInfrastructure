<?xml version="1.0" ?>
<robot name="autonomous_car"
  xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:include filename="$(find custom_robots)/models/autonomous_car/autonomous_car_gz.urdf.xacro"/>

  <xacro:macro name="autonomous_car" params="steering namespace">

    <link name="base_link"/>

    <joint name="chassis_link_joint" type="fixed">
      <origin rpy="0 0 -1.5708" xyz="0.0 0.0 0.0"/>
      <parent link="base_link"/>
      <child link="chassis_link"/>
    </joint>

    <link name="chassis_link">
      <inertial>
        <origin rpy="0 0 0" xyz="0 0.07307 0.65096"/>
        <mass value="1580"/>
        <inertia ixx="1997.86" ixy="-3e-05" ixz="-1e-06" iyy="442.769" iyz="62.5206" izz="2238.05"/>
      </inertial>
      <collision>
        <origin rpy="0 0 -3.1416" xyz="0 -0.08 0 "/>
        <geometry>
          <mesh filename="$(find custom_robots)/models/autonomous_car/meshes/hybrid_body.obj" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
      <visual>
        <origin rpy="0 0 -3.1416" xyz="0 -0.08 0 "/>
        <geometry>
          <mesh filename="$(find custom_robots)/models/autonomous_car/meshes/hybrid_body.obj" scale="0.01 0.01 0.01"/>
        </geometry>
      </visual>
    </link>

    <joint name="bl_axle" type="continuous">
      <origin rpy="0 0 0" xyz="-0.775 -1.52 0.324997"/>
      <parent link="chassis_link"/>
      <child link="bl_1"/>
      <axis xyz="1 0 0"/>
      <limit effort="1000" velocity="100"/>
      <dynamics friction="12.031606150200002"/>
    </joint>

    <link name="bl_1">
      <origin rpy="0 -0 0" xyz="0 0 0"/>
      <inertial>
        <origin rpy="0 -0 0" xyz="-0.0377 0 -0"/>
        <mass value="24.5"/>
        <inertia ixx="1.84514" ixy="0" ixz="0" iyy="1.04961" iyz="0" izz="1.04961"/>
      </inertial>
      <collision>
        <origin rpy="0 1.5708 0" xyz="0 0 0"/>
        <geometry>
          <cylinder length="0.3425" radius="0.22"/>
        </geometry>
      </collision>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="$(find custom_robots)/models/autonomous_car/meshes/wheel.obj" scale="0.01 0.01 0.01"/>
        </geometry>
      </visual>
    </link>

    <joint name="br_axle" type="continuous">
      <origin rpy="0 0 0" xyz="0.775 -1.52 0.324997"/>
      <parent link="chassis_link"/>
      <child link="br_1"/>
      <axis xyz="-1 0 0"/>
      <limit effort="1000" velocity="100"/>
      <dynamics friction="12.031606150200002"/>
    </joint>

    <link name="br_1">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertial>
        <origin rpy="0 -0 0" xyz="-0.0377 0 -0"/>
        <mass value="24.5"/>
        <inertia ixx="1.84514" ixy="0" ixz="0" iyy="1.04961" iyz="0" izz="1.04961"/>
      </inertial>
      <collision>
        <origin rpy="0 1.5708 0" xyz="0 0 0"/>
        <geometry>
          <cylinder length="0.3425" radius="0.22"/>
        </geometry>
      </collision>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="$(find custom_robots)/models/autonomous_car/meshes/wheel.obj" scale="0.01 0.01 0.01"/>
        </geometry>
      </visual>
    </link>

    <joint name="l_steer" type="revolute">
      <origin rpy="0 0 0" xyz="-0.825 1.32 0.324997"/>
      <parent link="chassis_link"/>
      <child link="l_steer_1"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.95" upper="0.95" effort="1e6" velocity="1e6"/>
      <dynamics friction="18.0474092253" damping="0.01"/>
    </joint>

    <link name="l_steer_1">
      <origin rpy="0 -0 0" xyz="0 0 0"/>
      <inertial>
        <origin rpy="0 0 0" xyz="0.003381 0 0.02162"/>
        <mass value="1"/>
        <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
      </inertial>
    </link>

    <joint name="r_steer" type="revolute">
      <origin rpy="0 0 0" xyz="0.825 1.32 0.324997"/>
      <parent link="chassis_link"/>
      <child link="r_steer_1"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.95" upper="0.95" effort="1e6" velocity="1e6"/>
      <dynamics friction="18.0474092253" damping="0.01"/>
    </joint>

    <link name="r_steer_1">
      <origin rpy="0 -0 0" xyz="0 0 0"/>
      <inertial>
        <origin rpy="0 0 0" xyz="0.003381 0 0.02162"/>
        <mass value="1"/>
        <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
      </inertial>
    </link>

    <joint name="fl_axle" type="continuous">
      <origin rpy="0 -0 0" xyz="-0.05 0 0"/>
      <parent link="l_steer_1"/>
      <child link="fl_1"/>
      <axis xyz="-1 0 0"/>
      <limit effort="1000" velocity="100"/>
      <dynamics friction="12.031606150200002"/>
    </joint>

    <link name="fl_1">
      <origin rpy="0 -0 0" xyz="0 0 0"/>
      <inertial>
        <origin rpy="0 -0 0" xyz="-0.0377 0 -0"/>
        <mass value="24.5"/>
        <inertia ixx="1.84514" ixy="0" ixz="0" iyy="1.04961" iyz="0" izz="1.04961"/>
      </inertial>
      <collision>
        <origin rpy="0 1.5708 0" xyz="0.13 0 0"/>
        <geometry>
          <cylinder length="0.3425" radius="0.22"/>
        </geometry>
      </collision>
      <visual>
        <origin rpy="0 0 0" xyz="0.13 0 0"/>
        <geometry>
          <mesh filename="$(find custom_robots)/models/autonomous_car/meshes/wheel.obj" scale="0.01 0.01 0.01"/>
        </geometry>
      </visual>
    </link>

    <joint name="fr_axle" type="continuous">
      <origin rpy="0 -0 0" xyz="0.05 0 0"/>
      <parent link="r_steer_1"/>
      <child link="fr_1"/>
      <axis xyz="-1 0 0"/>
      <limit effort="1000" velocity="100"/>
      <dynamics friction="12.031606150200002"/>
    </joint>

    <link name="fr_1">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertial>
        <origin rpy="0 0 0" xyz="-0.0377 0 0"/>
        <mass value="24.5"/>
        <inertia ixx="1.84514" ixy="0" ixz="0" iyy="1.04961" iyz="0" izz="1.04961"/>
      </inertial>
      <collision>
        <origin rpy="0 1.5708 0" xyz="-0.13 0 0"/>
        <geometry>
          <cylinder length="0.3425" radius="0.22"/>
        </geometry>
      </collision>
      <visual>
        <origin rpy="0 0 0" xyz="-0.13 0 0"/>
        <geometry>
          <mesh filename="$(find custom_robots)/models/autonomous_car/meshes/wheel.obj" scale="0.01 0.01 0.01"/>
        </geometry>
      </visual>
    </link>

    <!-- <joint name="steering_joint" type="revolute">
      <pose relative_to='chassis_link'>-0.01 0.6 0.6 0 0 0</pose>
      <parent>chassis_link</parent>
      <child>steering_wheel</child>
      <axis>
        <xyz>0.0 -1.0 0.0</xyz>
        <limit>
          <lower>-100</lower>
          <upper>100</upper>
        </limit>
        <dynamics>
          <damping>10.0</damping>
        </dynamics>
      </axis>
    </joint>
    <link name='steering_wheel'>
      <pose relative_to='steering_joint'>0 0.87 -0.54 0 0 1.5708</pose>
    </link> -->

    <xacro:if value="${steering == 'holonomic'}">
      <xacro:velocity namespace="${namespace}"/>
    </xacro:if>

    <xacro:if value="${steering == 'ackermann'}">
      <xacro:ackermann_steering namespace="${namespace}"/>
    </xacro:if>

    <xacro:joints/>
    <xacro:odom namespace="${namespace}" freq="50"/>
    <!-- <xacro:f1_steer_controller topic="/model/prius_autoparking/steering_wheel_cmd" joint="steering_joint"/> -->
  </xacro:macro>
</robot>
