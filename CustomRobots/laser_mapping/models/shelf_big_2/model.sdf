<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.7">
  <model name="shelf_big">
    <pose>0 0 0 0 0 0</pose>
    <self_collide>true</self_collide>
    
    <link name="shelf_base">
      <pose>-0.5 0 0 0 0 0</pose>
      
      <!-- Colisión escalada 3× -->
      <collision name="shelf_chassi_collision">
        <pose>0 0 0.9 0 0 0</pose>
        <geometry>
          <box>
            <!-- 3.6×3 = 10.8 ; 0.6×3 = 1.8 ; 1.8×3 = 5.4 -->
            <!--<size>10.8 1.8 5.4</size>-->
            <size>18 3 9</size>
          </box>
        </geometry>
      </collision>

      <!-- Visual escalado 3× -->
      <visual name="shelf_chassi_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <!-- 0.2×3 = 0.6 ; 0.3×3 = 0.9 -->
            <!-- <scale>0.6 0.9 0.9</scale>-->
            <scale>1 1.5 1.5</scale>
            <uri>meshes/shelf_big_movai.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>

    <static>1</static>
  </model>
</sdf>
