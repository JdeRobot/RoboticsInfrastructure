<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="dobot_magician_ros2_control" params="
    name
    prefix:=''
    sim_gz:=false
    use_fake_hardware:=false">

    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${sim_gz}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <xacro:if value="${use_fake_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="fake_sensor_commands">false</param>
          <param name="state_following_offset">0.0</param>
        </xacro:if>
      </hardware>

      <joint name="${prefix}joint_1">
        <command_interface name="position">
          <param name="min">${-125.0/180.0*pi}</param>
          <param name="max">${125.0/180.0*pi}</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="${prefix}joint_2">
        <command_interface name="position">
          <param name="min">${-5.0/180.0*pi}</param>
          <param name="max">${90.0/180.0*pi}</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.3</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="${prefix}joint_3">
        <command_interface name="position">
          <param name="min">${-15.0/180.0*pi}</param>
          <param name="max">${70.0/180.0*pi}</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.3</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="${prefix}joint_4">
        <command_interface name="position">
          <param name="min">${-150.0/180.0*pi}</param>
          <param name="max">${150.0/180.0*pi}</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <!-- Mimic joints only get a state_interface, gz_ros2_control expects that,
           a command_interface here crashed it (worse for the prismatic one). -->
      <joint name="${prefix}joint_mimic_1">
        <param name="mimic">${prefix}joint_2</param>
        <param name="multiplier">-1.0</param>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${prefix}joint_mimic_2">
        <param name="mimic">${prefix}joint_3</param>
        <param name="multiplier">-1.0</param>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

    </ros2_control>

    <!-- Gripper in its own hardware component. Mixing joint_prismatic_l with
         the arm's revolute joints in one component crashed gz_ros2_control
         right after the last joint every time, splitting it off is the same
         pattern UR3/Robotiq already use in this repo. -->
    <ros2_control name="${name}_gripper" type="system">
      <hardware>
        <xacro:if value="${sim_gz}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <xacro:if value="${use_fake_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="fake_sensor_commands">false</param>
          <param name="state_following_offset">0.0</param>
        </xacro:if>
      </hardware>

      <joint name="${prefix}joint_prismatic_l">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">0.0135</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <!-- joint_prismatic_r stays out of ros2_control entirely, still tracks
           joint_prismatic_l physically through the URDF-level mimic tag,
           gz-sim enforces that on its own. -->

    </ros2_control>

  </xacro:macro>

</robot>
