<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="dobot_magician_ros2_control" params="
    name
    prefix:=''
    sim_gz:=false
    use_fake_hardware:=false">

    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${sim_gz}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <xacro:if value="${use_fake_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
          <param name="fake_sensor_commands">false</param>
          <param name="state_following_offset">0.0</param>
        </xacro:if>
      </hardware>

      <joint name="${prefix}joint_1">
        <command_interface name="position">
          <param name="min">${-125.0/180.0*pi}</param>
          <param name="max">${125.0/180.0*pi}</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="${prefix}joint_2">
        <command_interface name="position">
          <param name="min">${-5.0/180.0*pi}</param>
          <param name="max">${90.0/180.0*pi}</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.3</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="${prefix}joint_3">
        <command_interface name="position">
          <param name="min">${-15.0/180.0*pi}</param>
          <param name="max">${70.0/180.0*pi}</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.3</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="${prefix}joint_4">
        <command_interface name="position">
          <param name="min">${-150.0/180.0*pi}</param>
          <param name="max">${150.0/180.0*pi}</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <!-- Mimic joints only get a state_interface. The mimic relationship
           itself is declared once, on the joint in the URDF above, gz_ros2_control's
           own gripper_mimic_joint_example does not repeat "mimic"/"multiplier"
           params here, only bare state_interfaces. -->
      <joint name="${prefix}joint_mimic_1">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <joint name="${prefix}joint_mimic_2">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- Gripper, same hardware component as the arm. The official gz_ros2_control
           gripper_mimic_joint_example keeps its driving + mimic joint in one
           ros2_control block too, splitting arm/gripper into two separate
           hardware components crashed transitioning from the first to the
           second every time, even with the mimic params already fixed. -->
      <joint name="${prefix}joint_prismatic_l">
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">0.0135</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <joint name="${prefix}joint_prismatic_r">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

    </ros2_control>

  </xacro:macro>

</robot>
