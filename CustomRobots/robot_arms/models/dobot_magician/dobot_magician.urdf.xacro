<?xml version="1.0"?>
<robot name="$(arg name)" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="name" default="dobot_magician"/>
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="use_fake_hardware" default="false"/>
  <xacro:arg name="sim_gazebo" default="false"/>
  <xacro:arg name="sim_gz" default="true"/>
  <xacro:arg name="simulation_controllers" default=""/>

  <xacro:include filename="$(find custom_robots)/models/dobot_magician/dobot_magician_macro.xacro"/>
  <xacro:include filename="$(find custom_robots)/models/dobot_magician/dobot_magician.ros2_control.xacro"/>

  <!-- fixed base, anchor it to the world so it doesn't fall under gravity -->
  <link name="world"/>

  <xacro:dobot_magician parent="world" prefix="$(arg prefix)"/>

  <xacro:dobot_magician_ros2_control
    name="$(arg name)"
    prefix="$(arg prefix)"
    sim_gz="$(arg sim_gz)"
    use_fake_hardware="$(arg use_fake_hardware)"/>

  <xacro:if value="$(arg sim_gz)">
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg simulation_controllers)</parameters>
      </plugin>
    </gazebo>
  </xacro:if>

</robot>
