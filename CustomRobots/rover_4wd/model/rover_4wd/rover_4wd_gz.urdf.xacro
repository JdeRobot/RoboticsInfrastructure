<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="lidar" params="xyz rpy name parent namespace">

    <link name="${name}_link">
      <visual>
        <origin xyz="0 0 0" rpy="-1.57 0 3.1415"/>
        <geometry>
          <mesh filename="file://$(find custom_robots)/model/rover_4wd/meshes/rplidar_s2.dae"/>
        </geometry>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="-1.57 0 3.1415"/>
        <geometry>
          <mesh filename="file://$(find custom_robots)/model/rover_4wd/meshes/rplidar_s2.dae"/>
        </geometry>
      </collision>

    </link>

    <joint name="${name}_to_${parent}" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <gazebo reference="${name}_link">
      <sensor name="gpu_lidar" type="gpu_lidar">
        <always_on>1</always_on>
        <visualize>1</visualize>
        <update_rate>10</update_rate>
        <topic>/${namespace}/laser/scan</topic>
        <gz_frame_id>base_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.1459</min_angle>
              <max_angle>3.1459</max_angle>
            </horizontal>
            <vertical>
              <samples>12</samples>
              <resolution>1</resolution>
              <min_angle>-0.261799</min_angle>
              <max_angle>0.261799</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.3</min>
            <max>50</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="imu" params="xyz rpy parent namespace">
    <link name="imu_link"/>

    <joint name="imu_to_payload" type="fixed">
      <parent link="${parent}"/>
      <child link="imu_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <gazebo reference="imu_link">
      <sensor name="imu" type="imu">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <visualize>true</visualize>
        <topic>/${namespace}/imu</topic>
        <enable_metrics>true</enable_metrics>
        <frame_id>imu_link</frame_id>
      </sensor>
    </gazebo>

    <gazebo>
      <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    </gazebo>
  </xacro:macro>


  <xacro:macro name="velocity" params="namespace">
    <gazebo>
      <plugin name="gz::sim::systems::DiffDrive" filename="gz-sim-diff-drive-system">
        <num_wheel_pairs>2</num_wheel_pairs>
        <!-- Wheel Information -->
        <left_joint>rl_wheel_to_chassis</left_joint>
        <left_joint>fl_wheel_to_chassis</left_joint>
        <right_joint>rr_wheel_to_chassis</right_joint>
        <right_joint>fr_wheel_to_chassis</right_joint>
        <wheel_separation>0.24</wheel_separation>
        <wheel_radius>0.122</wheel_radius>

        <!-- Limits -->
        <max_linear_acceleration>0.5</max_linear_acceleration>
        <min_linear_acceleration>-0.5</min_linear_acceleration>
        <max_angular_acceleration>0.8</max_angular_acceleration>
        <min_angular_acceleration>-0.8</min_angular_acceleration>

        <!-- Output -->
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>

        <!-- Topics -->
        <topic>/${namespace}/cmd_vel</topic>
        <odom_topic>/${namespace}/odometry/wheels</odom_topic>
        <tf_topic>/${namespace}/tf</tf_topic>
      </plugin>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="joints" params="namespace">
    <gazebo>
      <plugin name="gz::sim::systems::JointStatePublisher" filename="gz-sim-joint-state-publisher-system">
        <topic>/${namespace}/joint_states</topic>
      </plugin>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="pose" params="namespace">
    <gazebo>
      <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
        <publish_model_pose>true</publish_model_pose>
        <publish_nested_model>true</publish_nested_model>
        <publish_nested_model_pose>true</publish_nested_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <topic>/model/${namespace}/pose</topic>
      </plugin>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="odom" params="namespace">
    <gazebo>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <odom_topic>/${namespace}/odom</odom_topic>
        <dimensions>3</dimensions>
      </plugin>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="noise_odom" params="namespace a1 a2 a3 a4">
    <gazebo>
      <plugin filename="libNoisyOdometryPlugin.so" name="custom_plugins::NoisyOdometryPlugin">
        <ros_topic>/${namespace}/odom_noisy</ros_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>

        <!-- must match the DiffDrive plugin values above — one joint per side -->
        <left_joint>fl_wheel_to_chassis</left_joint>
        <right_joint>fr_wheel_to_chassis</right_joint>
        <wheel_separation>0.24</wheel_separation>
        <wheel_radius>0.122</wheel_radius>

        <alpha1>${a1}</alpha1>
        <alpha2>${a2}</alpha2>
        <alpha3>${a3}</alpha3>
        <alpha4>${a4}</alpha4>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
