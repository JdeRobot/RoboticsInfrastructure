#!/bin/bash
source /opt/ros/humble/setup.bash
source /home/drones_ws/install/setup.bash
source /home/ws/install/setup.bash
source /workspace/worlds/install/setup.bash &>/dev/null

export ROBOTICS_ACADEMY_BASE=/RoboticsAcademy
export PYTHONPATH=$PYTHONPATH:$ROBOTICS_ACADEMY_BASE
export EXERCISES_STATIC_FILES=$ROBOTICS_ACADEMY_BASE/exercises/static/exercises

# GAZEBO
export GAZEBO_RESOURCE_PATH=$GAZEBO_RESOURCE_PATH:/usr/share/gz

export GAZEBO_MODEL_PATH=$GAZEBO_MODEL_PATH:/home/ws/install/custom_robots/share/models
export GZ_SIM_RESOURCE_PATH=$GZ_SIM_RESOURCE_PATH:/home/ws/install/custom_robots/share/models
export GZ_SIM_SYSTEM_PLUGIN_PATH=$GZ_SIM_SYSTEM_PLUGIN_PATH:/home/ws/install/custom_robots/share/scripts

export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/workspace/code/libs

# Default rendering display
export DISPLAY=:0
