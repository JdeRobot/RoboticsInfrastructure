<?xml version="1.0" ?>
<robot name="3d_reconstruction">

<link name="base_link"/>

<joint name="base_to_base_footprint" type="fixed">
  <parent link="base_link"/>
  <child link="base_footprint"/>
  <origin xyz="0 0 0" rpy="0 0 0"/>
</joint>

  <!-- ================= BASE ================= -->
  <link name="base_footprint">
