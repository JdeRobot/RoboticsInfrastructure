      </geometry>
    </visual>
    <visual>
      <origin xyz="-0.1024 0.098 0.2374" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://3d_reconstruction/models/turtlebotROS/meshes/sensors/sensor_pole.dae"/>
      </geometry>
