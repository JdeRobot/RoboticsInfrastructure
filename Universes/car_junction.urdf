      <geometry>
        <mesh filename="package://car_junction/models/waymo_light/meshes/steering_wheel.obj"
              scale="0.01 0.01 0.01"/>
      </geometry>
    </visual>
  </link>

  <joint name="chassis_fixed" type="fixed">
    <parent link="World"/>
    <child link="chassis"/>
    <origin xyz="-10 -2 0.25" rpy="0 0 1.57"/>
  </joint>

  <joint name="front_left_wheel_fixed" type="fixed">
    <parent link="chassis"/>
    <child link="front_left_wheel"/>
    <origin xyz="0.767 -1.41 0.25" rpy="0 0 0"/>
  </joint>

  <joint name="front_right_wheel_fixed" type="fixed">
    <parent link="chassis"/>
    <child link="front_right_wheel"/>
    <origin xyz="-0.767 -1.41 0.25" rpy="0 0 0"/>
  </joint>

  <joint name="rear_left_wheel_fixed" type="fixed">
    <parent link="chassis"/>
    <child link="rear_left_wheel"/>
    <origin xyz="0.793 1.45 0.25" rpy="0 0 0"/>
  </joint>

  <joint name="rear_right_wheel_fixed" type="fixed">
    <parent link="chassis"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.793 1.45 0.25" rpy="0 0 0"/>
  </joint>

  <joint name="steering_wheel_fixed" type="fixed">
    <parent link="chassis"/>
    <child link="steering_wheel"/>
    <origin xyz="0.357734 -0.627868 0.988243" rpy="1.3021 0 0"/>
  </joint>



