<link name="World"/>

<link name="stop_pole">
  <visual>
  <origin rpy="0 0 0" xyz="0 0 2.5"/>
    <geometry>
      <cylinder radius="0.1" length="5"/>
    </geometry>
    <material name="sign_post">
      <color rgba="0.3 0.3 0.3 1"/>
    </material>
  </visual>
</link>

<link name="stop_sign">
  <visual>
    <geometry>
      <cylinder radius="0.5" length="0.1"/>
    </geometry>
    <material name="stop_sign">
      <color rgba="1 0 0 1"/>
    </material>
  </visual>
</link>

<joint name="stop_pole_joint" type="fixed">
  <parent link="World"/>
  <child link="stop_pole"/>
  <origin rpy="0 0 0" xyz="6 -6 0"/>
</joint>

<joint name="stop_sign_joint" type="fixed">
  <parent link="stop_pole"/>
  <child link="stop_sign"/>
  <origin rpy="1.57 0 1.57" xyz="0 0 5"/>
</joint>



<link name="tree_1">
