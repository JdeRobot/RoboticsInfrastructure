  <link name="chassis">
    <visual name="chassis_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://car_junction/models/waymo_light/meshes/hybrid_body.obj"
              scale="0.01 0.01 0.01"/>
      </geometry>
    </visual>

    <visual name="lidar_mount_box">
      <origin xyz="0 0.5 1.6" rpy="0 0 0"/>
      <geometry>
        <box size="0.4 0.4 0.1"/>
      </geometry>
    </visual>

    <visual name="front_camera_mount">
      <origin xyz="0 -1.7 0.9" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
    </visual>
  </link>

  <link name="front_left_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://car_junction/models/waymo_light/meshes/wheel.obj"
              scale="0.01 0.01 0.01"/>
      </geometry>
    </visual>
  </link>

  <link name="front_right_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://car_junction/models/waymo_light/meshes/wheel.obj"
              scale="0.01 0.01 0.01"/>
      </geometry>
    </visual>
  </link>

  <link name="rear_left_wheel">
