<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="default">
    <!-- Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="libgz_link_attacher.so" name="gz_link_attacher::LinkAttacher"/>

    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact">
    </plugin>

    <!-- Scene -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <visualize>false</visualize>
    </light>

    <!-- Ground Plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Conveyor -->
    <model name="conveyor">
      <static>true</static>
      <pose>0.6 0 0 0 0 1.57</pose>
      <link name="link">
        <visual name="visual">
          <pose>0 0 0.95 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>0.45 0.35 0.5</scale>
              <uri>model://conveyor/meshes/conveyor.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name="collision_0">
          <pose>0 0 0.95 0 0 0</pose>
          <geometry>
            <box>
              <size>2.4 0.8 0.1</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Ground Logo Big -->
    <model name="ground_logo_big">
      <static>true</static>
      <pose>-0.5 0 0 0 0 1.57</pose>
      <link name="link">
        <visual name="visual">
          <pose>0 0 0.001 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://ground_logo_big/meshes/ground_logo.dae</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Pallet Table (target platform for stacking) -->
    <model name="target_table">
      <static>true</static>
      <pose>-0.6 0 0 0 0 1.57</pose>
      <link name="link">
        <visual name="visual">
          <pose>0 0 0.73 0 0 1.57</pose>
          <geometry>
            <mesh>
              <scale>1 1 1</scale>
              <uri>model://target_table/meshes/target_table.dae</uri>
            </mesh>
          </geometry>
        </visual>
        <collision name="collision_0">
          <pose>0 0 0.73 0 0 0</pose>
          <geometry>
            <box>
              <size>0.8 1.6 0.06</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Robot Base (Placeholder) -->
    <model name="robotbase">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <pose>0 0 0.45 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.09</radius>
              <length>0.9</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.01 0.01 0.01 1</specular>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.09</radius>
              <length>0.9</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Palletizing source: 6 identical brown boxes on the conveyor -->
    <!-- 2 rows along x (0.55 / 0.65), 3 columns along y (-0.2 / 0.0 / 0.2) -->
    <!-- z = 1.04 sits the boxes just above the conveyor surface (which tops out near 1.00) -->

    <model name="brown_box_1">
      <pose>0.55 -0.20 1.04 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>0.00000417</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00000417</iyy><iyz>0</iyz>
            <izz>0.00000417</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material>
            <ambient>0.55 0.35 0.15 1</ambient>
            <diffuse>0.55 0.35 0.15 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="brown_box_2">
      <pose>0.55 0.00 1.04 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>0.00000417</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00000417</iyy><iyz>0</iyz>
            <izz>0.00000417</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material>
            <ambient>0.55 0.35 0.15 1</ambient>
            <diffuse>0.55 0.35 0.15 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="brown_box_3">
      <pose>0.55 0.20 1.04 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>0.00000417</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00000417</iyy><iyz>0</iyz>
            <izz>0.00000417</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material>
            <ambient>0.55 0.35 0.15 1</ambient>
            <diffuse>0.55 0.35 0.15 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="brown_box_4">
      <pose>0.65 -0.20 1.04 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>0.00000417</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00000417</iyy><iyz>0</iyz>
            <izz>0.00000417</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material>
            <ambient>0.55 0.35 0.15 1</ambient>
            <diffuse>0.55 0.35 0.15 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="brown_box_5">
      <pose>0.65 0.00 1.04 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>0.00000417</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00000417</iyy><iyz>0</iyz>
            <izz>0.00000417</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material>
            <ambient>0.55 0.35 0.15 1</ambient>
            <diffuse>0.55 0.35 0.15 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="brown_box_6">
      <pose>0.65 0.20 1.04 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>0.00000417</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00000417</iyy><iyz>0</iyz>
            <izz>0.00000417</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
          <material>
            <ambient>0.55 0.35 0.15 1</ambient>
            <diffuse>0.55 0.35 0.15 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
