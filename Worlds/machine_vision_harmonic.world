<sdf version='1.7'>
  <world name='default'>

    <!-- LUZ -->
    <light name='sun' type='directional'>
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- SUELO -->
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- CINTA (ROBOT BASE) -->
    <model name='conveyor'>
      <static>true</static>
      <pose>0.335211 0.377742 0 0 0 0</pose>

      <link name='link'>
        <pose>0 0 0 0 0 0</pose>

        <visual name='visual'>
          <pose>0 0 0.95 0 0 0</pose>
          <geometry>
            <mesh>
              <scale>0.45 0.35 0.5</scale>
              <uri>model://conveyor/meshes/conveyor.dae</uri>
            </mesh>
          </geometry>
        </visual>

        <collision name='collision'>
          <pose>0 0 0.95 0 0 0</pose>
          <geometry>
            <box>
              <size>2.4 0.8 0.1</size>
            </box>
          </geometry>
        </collision>

      </link>
    </model>

    <!-- MESA -->
    <model name='target_table'>
      <static>true</static>
      <pose>-0.877342 -1.1194 0 0 0 0</pose>

      <link name='link'>
        <visual name='visual'>
          <pose>0 0 0.73 0 0 1.57</pose>
          <geometry>
            <mesh>
              <uri>model://target_table/meshes/target_table.dae</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- OBJETOS (IGUALES QUE CLASSIC) -->
    <model name='blue_sphere'>
      <pose>0.45 0.25 1.01 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <sphere><radius>0.03</radius></sphere>
          </geometry>
        </visual>
      </link>
    </model>

    <model name='red_sphere'>
      <pose>0.45 -0.25 1.01 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <sphere><radius>0.03</radius></sphere>
          </geometry>
        </visual>
      </link>
    </model>

    <model name='green_sphere'>
      <pose>0.45 0.09 1.01 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <sphere><radius>0.03</radius></sphere>
          </geometry>
        </visual>
      </link>
    </model>

    <model name='purple_sphere'>
      <pose>0.45 -0.09 1.01 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <sphere><radius>0.03</radius></sphere>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- CILINDROS -->
    <model name='blue_cylinder'>
      <pose>0.65 -0.25 1.01 0 0 0</pose>
      <link name='link'>
        <visual name='visual'>
          <geometry>
            <cylinder>
              <radius>0.03</radius>
              <length>0.07</length>
            </cylinder>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- PLUGIN LINK ATTACHER (CORRECTO PARA HARMONIC) -->
    <plugin filename="libgz-sim-link-attacher-system.so"
            name="gz::sim::systems::LinkAttacher"/>

  </world>
</sdf>