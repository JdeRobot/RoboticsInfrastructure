<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="autopark">
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    
    <gravity>0 0 -9.8</gravity>
    <atmosphere type="adiabatic"/>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Carretera -->
    <include>
      <uri>model://autopark_sideways</uri>
      <pose> 0 0 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://prius_autoparking_3laser_harmonic</uri>
      <pose>10 -5 0.1 0 -0.1 1.55</pose>
    </include>

    <include>
      <uri>model://opel</uri>
      <name>opel_1</name>
      <pose>1 0.8 0 1.55 0 0.35</pose>
      <static>false</static>
    </include>

    <include>
      <uri>model://opel</uri>
      <name>opel_2</name>
      <pose>-3 0.8 0 1.55 0 0.35</pose>
      <static>false</static>
    </include>

    <include>
      <uri>model://opel</uri>
      <name>opel_3</name>
      <pose>-11.2 0.8 0 1.55 0 0.35</pose>
      <static>false</static>
    </include>

    <include>
      <uri>model://opel</uri>
      <name>opel_4</name>
      <pose>9.3 0.8 0 1.55 0 0.35</pose>
      <static>false</static>
    </include>

    <include>
      <uri>model://opel</uri>
      <name>opel_5</name>
      <pose>13.5 0.8 0 1.55 0 0.35</pose>
      <static>false</static>
    </include>

    <include>
      <uri>model://lamp_post</uri>
      <name>farola_0</name>
      <pose>20 4.2 0 0 0 0</pose>
      <static>false</static>
    </include>

    <include>
      <uri>model://lamp_post</uri>
      <name>farola_1</name>
      <pose>15 4.2 0 0 0 0</pose>
      <static>false</static>
    </include>

    <include>
      <uri>model://lamp_post</uri>
      <name>farola_2</name>
      <pose>10 4.2 0 0 0 0</pose>
      <static>false</static>
    </include>

    <include>
      <uri>model://lamp_post</uri>
      <name>farola_3</name>
      <pose>5 4.2 0 0 0 0</pose>
      <static>false</static>
    </include>

    <include>
      <uri>model://lamp_post</uri>
      <name>farola_4</name>
      <pose>0 4.2 0 0 0 0</pose>
      <static>false</static>
    </include>

    <include>
      <uri>model://lamp_post</uri>
      <name>farola_5</name>
      <pose>-5 4.2 0 0 0 0</pose>
      <static>false</static>
    </include>

    <include>
      <uri>model://lamp_post</uri>
      <name>farola_6</name>
      <pose>-10 4.2 0 0 0 0</pose>
      <static>false</static>
    </include>

    <!-- Luz -->
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <cast_shadows>true</cast_shadows>
    </light>
  </world>
</sdf>