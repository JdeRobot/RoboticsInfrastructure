<?xml version="1.0" ?>

<sdf version="1.8">
  <world name="default">
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <visualize>false</visualize>
    </light>

    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane
      </uri>
    </include>

    <include>
      <name>house_int2_harmonic</name>
      <uri>model://house_int2_harmonic</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <include>
      <name>roombaROS_harmonic</name>
      <uri>model://roombaROS_harmonic</uri>
      <pose>-1 1.5 0 0 -0 0</pose>
    </include>

    <include>
      <name>mesa_comedor</name>
      <uri>model://mesa_comedor</uri>
      <pose>-2.4 0.3 0 0 0 1.57</pose>
    </include>

    <include>
      <name>silla_1</name>
      <uri>model://silla</uri>
      <pose>-2.1 -0.1 0 0 0 0</pose>
    </include>

    <include>
      <name>silla_2</name>
      <uri>model://silla</uri>
      <pose>-2.1 0.7 0 0 0 0</pose>
    </include>

    <include>
      <name>silla_3</name>
      <uri>model://silla</uri>
      <pose>-2.7 -0.1 0 0 0 3.14</pose>
    </include>

    <include>
      <name>silla_4</name>
      <uri>model://silla</uri>
      <pose>-2.7 0.7 0 0 0 3.14</pose>
    </include>

    <include>
      <name>mesa_salon</name>
      <uri>model://mesa_salon</uri>
      <pose>-0.8 4.4 0 0 0 0</pose>
    </include>

    <include>
      <name>sofa_largo</name>
      <uri>model://sofa_largo</uri>
      <pose>-0.8 3.4 0 0 0 3.14</pose>
    </include>

    <include>
      <name>sofa_1</name>
      <uri>model://sofa</uri>
      <pose>0.5 4.4 0 0 0 -1.57</pose>
    </include>

    <include>
      <name>sofa_2</name>
      <uri>model://sofa</uri>
      <pose>-2.1 4.4 0 0 0 1.57</pose>
    </include>

    <include>
      <name>estanteria_1</name>
      <uri>model://estanteria</uri>
      <pose>4.7 4.48 0 0 0 0</pose>
    </include>

    <include>
      <name>estanteria_2</name>
      <uri>model://estanteria</uri>
      <pose>4.7 0.5 0 0 0 0</pose>
    </include>

    <include>
      <name>mesita_1</name>
      <uri>model://mesita</uri>
      <pose>2.4 -3.28 0 0 0 0</pose>
    </include>

    <include>
      <name>mesita_2</name>
      <uri>model://mesita</uri>
      <pose>4.4 -3.28 0 0 0 0</pose>
    </include>

    <include>
      <name>cama</name>
      <uri>model://cama</uri>
      <pose>3.4 -2.41 0 0 0 -1.57</pose>
    </include>

  </world>
</sdf>