      <name>lp_4</name>
      <pose>-5 -50 0.5 0 0 1.57</pose>
    </include>

    <include>
      <uri>model://waymo_light</uri>
      <pose>2.5 -30 0 0 0 1.57</pose>
    </include>

    <!-- Roads -->
    <include>
      <uri>model://stopW</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <plugin filename="gz-sim-python-system-loader-system" name="gz::sim::systems::PythonSystemLoader">
      <module_name>TrafficSystem</module_name>
      <world_name>road_junction</world_name>
      <sdf_path>model://hatchback/model.sdf</sdf_path>
    </plugin>

  </world>
</sdf>