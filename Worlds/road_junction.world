    <model name="grid_junction">
      <static>true</static>
      <link name="grid-d1">
        <visual name="d1">
          <geometry>
            <box>
              <size>0.1 14.1 0.01</size>
            </box>
          </geometry>
          <material>
            <diffuse>1 1 0 1</diffuse>
            <specular>0.1 0.1 0 1</specular>
          </material>
          <pose>0 0 0.02 0 0 0.78</pose>
        </visual>
      </link>
      <link name="grid-d2">
        <visual name="d2">
          <geometry>
            <box>
              <size>0.1 14.1 0.01</size>
            </box>
          </geometry>
          <material>
            <diffuse>1 1 0 1</diffuse>
            <specular>0.1 0.1 0 1</specular>
          </material>
          <pose>0 0 0.02 0 0 -0.78</pose>
        </visual>
      </link>
      <link name="grid-d3">
        <visual name="d3">
          <geometry>
            <box>
              <size>0.1 7 0.01</size>
            </box>
          </geometry>
          <material>
            <diffuse>1 1 0 1</diffuse>
            <specular>0.1 0.1 0 1</specular>
          </material>
          <pose>2.5 2.5 0.02 0 0 0.78</pose>
        </visual>
      </link>
      <link name="grid-d4">
        <visual name="d4">
          <geometry>
            <box>
              <size>0.1 7 0.01</size>
            </box>
          </geometry>
          <material>
            <diffuse>1 1 0 1</diffuse>
            <specular>0.1 0.1 0 1</specular>
          </material>
          <pose>-2.5 -2.5 0.02 0 0 0.78</pose>
        </visual>
      </link>
      <link name="grid-d5">
        <visual name="d5">
          <geometry>
            <box>
              <size>0.1 7 0.01</size>
            </box>
          </geometry>
          <material>
            <diffuse>1 1 0 1</diffuse>
            <specular>0.1 0.1 0 1</specular>
          </material>
          <pose>-2.5 2.5 0.02 0 0 -0.78</pose>
        </visual>
      </link>
      <link name="grid-d6">
        <visual name="d6">
          <geometry>
            <box>
              <size>0.1 7 0.01</size>
            </box>
          </geometry>
          <material>
            <diffuse>1 1 0 1</diffuse>
            <specular>0.1 0.1 0 1</specular>
          </material>
          <pose>2.5 -2.5 0.02 0 0 -0.78</pose>
        </visual>
      </link>
    </model>

    <include>
      <static>true</static>
      <uri>model://stop_sign</uri>
      <pose>6 -6 0 0 0 0</pose>
      <name>stop_1</name>
    </include>

    <!-- Houses -->
    <include>
      <uri>model://house_1</uri>
      <pose>-15 14 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://house_2</uri>
      <pose>-32 12 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://house_3</uri>
      <pose>-9 -11 0 0 0 1.55</pose>
    </include>
    <!-- A gas station -->
    <include>
      <uri>model://gas_station</uri>
      <pose>14 18 0 0 0 1.55</pose>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
      <name>tree_1</name>
      <pose>25 5 0.5 0 0 0</pose>
    </include>


    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
      <name>tree_2</name>
      <pose>45 5 0.5 0 0 0</pose>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
      <name>tree_3</name>
      <pose>65 5 0.5 0 0 0</pose>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
      <name>tree_4</name>
      <pose>85 5 0.5 0 0 0</pose>
    </include>


    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Lamp Post</uri>
      <name>lp_1</name>
      <pose>-5 30 0.5 0 0 1.57</pose>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Lamp Post</uri>
      <name>lp_2</name>
      <pose>-5 50 0.5 0 0 1.57</pose>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Lamp Post</uri>
      <name>lp_3</name>
      <pose>-5 -30 0.5 0 0 1.57</pose>
    </include>

    <include>
